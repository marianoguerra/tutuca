// TodoList's implementation (todo_list.tcd has the rest): adding, moving and
// dropping items, and what it reads of them through the TodoItem interface.

// An item's id, read through its vtable; fallback when it has none.
fn todo_list_item_id(item: &value, fallback: i32) -> i32 {
    let id = value_member(item, gs_id);
    if id.kind != value_kind_int {
        return fallback;
    }
    (id as &value_int).value;
}

fn todo_list_item_done(item: &value) -> i32 {
    value_truthy(value_member(item, gs_done));
}

// The items without the one at skip (-1 for none) and, if drop_done, without
// the done ones.
fn todo_list_keep(items: &value, skip: i32, drop_done: i32) -> &value {
    let out = list_empty();
    let i = 0;
    while i <s list_count(items) {
        let item = list_get(items, i)!;
        if i != skip {
            if !(drop_done & todo_list_item_done(item)) {
                out = list_push(out, item);
            }
        }
        i += 1;
    }
    out;
}

// The list with the item at from taken out and put in at to.
fn todo_list_move(items: &value, from: i32, to: i32) -> &value {
    let moved = list_get(items, from)!;
    let out = list_empty();
    let i = 0;
    while i <s list_count(items) {
        if i == to {
            if to <s from {
                out = list_push(out, moved);
            }
        }
        if i != from {
            out = list_push(out, list_get(items, i)!);
        }
        if i == to {
            if to >s from {
                out = list_push(out, moved);
            }
        }
        i += 1;
    }
    out;
}

fn todo_list_get_remaining(state: &todo_list_state) -> i32 {
    let n = 0;
    let i = 0;
    while i <s list_count(state.items) {
        if !todo_list_item_done(list_get(state.items, i)!) {
            n += 1;
        }
        i += 1;
    }
    n;
}

fn todo_list_get_count(state: &todo_list_state) -> i32 {
    list_count(state.items);
}

fn todo_list_on_set_draft(
    state: &todo_list_state,
    ctx: &context,
    text: &extern,
) -> &todo_list_state {
    todo_list_with_draft(state, text);
}

// An empty draft adds nothing.
fn todo_list_on_add_todo(state: &todo_list_state, ctx: &context) -> &todo_list_state {
    if js_string_length(state.draft) == 0 {
        return state;
    }
    let item = todo_list_make_todo_item(ctx, state.next_id, state.draft, 0);
    let items = list_push(state.items, value_component(item));
    {todo_list_state| items, draft: gs_empty, next_id: state.next_id + 1 };
}

// Each item changes itself: the list only addresses them.
fn todo_list_on_complete_all(state: &todo_list_state, ctx: &context) -> &todo_list_state {
    let i = 0;
    while i <s list_count(state.items) {
        todo_item_send_set_done(ctx, selector_item(gs_items, path_key_index(i)), 1);
        i += 1;
    }
    state;
}

fn todo_list_on_clear_done(state: &todo_list_state, ctx: &context) -> &todo_list_state {
    let items = todo_list_keep(state.items, -1, 1);
    if list_count(items) == list_count(state.items) {
        return state;
    }
    todo_list_with_items(state, items);
}

fn todo_list_on_move_item(
    state: &todo_list_state,
    ctx: &context,
    from: &value,
    to: &value,
) -> &todo_list_state {
    if (from.kind != value_kind_int) | (to.kind != value_kind_int) {
        return state;
    }
    let f = (from as &value_int).value;
    let t = (to as &value_int).value;
    if f == t {
        return state;
    }
    todo_list_with_items(state, todo_list_move(state.items, f, t));
}

fn todo_list_on_remove_me(state: &todo_list_state, ctx: &context) -> &todo_list_state {
    let key = ctx.source_key;
    if !key {
        return state;
    }
    todo_list_with_items(state, todo_list_keep(state.items, (key! as &path_key_index).index, 0));
}

fn todo_list_loop_items_key(state: &todo_list_state, key: &value, item: &value) -> i32 {
    todo_list_item_id(item, (key as &value_int).value);
}
