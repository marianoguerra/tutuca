// The counter module's implementation (counter.tcd has the rest): what each
// message does to the state, and the loadCount answer.

import "'" {
    #[import = "was "]
    const s_was: &extern;
}

// ---- Counter -----------------------------------------------------------------------

fn counter_on_inc(state: &counter_state, ctx: &context) -> &counter_state {
    counter_notify_changed(ctx, state.count + 1);
    counter_with_count(state, state.count + 1);
}

fn counter_on_add(state: &counter_state, ctx: &context, n: i32) -> &counter_state {
    counter_with_count(state, state.count + n);
}

// Not a number yet: keep the count.
fn counter_on_set(state: &counter_state, ctx: &context, text: &extern) -> &counter_state {
    let (ok, n) = parse_int(text);
    if !ok {
        return state;
    }
    counter_with_count(state, n);
}

fn counter_on_reset(state: &counter_state, ctx: &context) -> &counter_state {
    counter_with_count(state, 0);
}

fn counter_on_remove(state: &counter_state, ctx: &context) -> &counter_state {
    counter_notify_remove_me(ctx);
    state;
}

fn counter_on_load(state: &counter_state, ctx: &context) -> &counter_state {
    counter_ask_load_count(ctx);
    state;
}

fn counter_on_fetch(state: &counter_state, ctx: &context) -> &counter_state {
    counter_ask_fetch_count(ctx);
    state;
}

fn counter_on_to_label(state: &counter_state, ctx: &context) -> &component {
    counter_make_label(ctx, js_string_concat(s_was, int_text(state.count)));
}

fn counter_reply_load_count_ok(state: &counter_state, ctx: &context, reply: i32) -> &counter_state {
    counter_with_count(state, reply);
}

// The error, logged.
fn counter_reply_load_count_err(
    state: &counter_state,
    ctx: &context,
    error: &value,
) -> &counter_state {
    ctx_log(ctx, error);
    state;
}

fn counter_reply_fetch_count_ok(
    state: &counter_state,
    ctx: &context,
    reply: i32,
) -> &counter_state {
    counter_with_count(state, reply);
}

// ---- Board -------------------------------------------------------------------------

fn board_on_add_counter(state: &board_state, ctx: &context) -> &board_state {
    let c = board_make_counter(ctx, list_count(state.counters));
    board_with_counters(state, list_push(state.counters, value_component(c)));
}

fn board_on_reset_all(state: &board_state, ctx: &context) -> &board_state {
    let i = 0;
    while i <s list_count(state.counters) {
        counter_send_reset(ctx, selector_item(gs_counters, path_key_index(i)));
        i += 1;
    }
    state;
}

fn board_on_changed(state: &board_state, ctx: &context, count: i32) -> &board_state {
    board_with_total(state, state.total + 1);
}

// The counter the source key names goes.
fn board_on_remove_me(state: &board_state, ctx: &context) -> &board_state {
    let key = ctx.source_key;
    if !key {
        return state;
    }
    let at = (key! as &path_key_index).index;
    let counters = list_empty();
    let i = 0;
    while i <s list_count(state.counters) {
        if i != at {
            counters = list_push(counters, list_get(state.counters, i)!);
        }
        i += 1;
    }
    board_with_counters(state, counters);
}

// ---- The package -----------------------------------------------------------------------

fn counter_answer_load_count(ctx: &context) -> &value {
    value_ok(value_int(42));
}
