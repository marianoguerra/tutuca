// The module's interface (README.md has the convention): its ABI version,
// and registering its component types in a scope, with their asks:
// loadCount answers now, with 42; fetchCount is the host's, answered later.

import "'" {
    #[import = "Label"]
    const s_label_name: &extern;
}

fn load_count_ask: ask_fn (name: &extern, args: &value_array, ctx: &context) -> &ask_result {
    ask_result_reply(value_ok(value_int(42)));
}

#[export = "tutuca_abi_version"]
fn tutuca_abi_version() -> i32 {
    tutuca_abi_version_current;
}

#[export = "tutuca_register"]
fn tutuca_register(s: &scope) {
    scope_register(s, s_counter, counter_spec(), counter_vtable());
    scope_register(s, s_label_name, label_spec(), label_vtable());
    scope_register(s, s_board_type, board_spec(), board_vtable());
    scope_register_ask(s, s_load_count, load_count_ask);
    scope_register_host_ask(s, s_fetch_count);
}
