// A component module for the test runner's tests (js/pbt.js): what it should
// find, on purpose. Not for the demos.
package tutuca:pbt@0.1.0;

/// A tally, with a bug seeded in its implementation: add(4) once the count is
/// past 8 adds 5, so its ensures doesn't hold.
component tally {
    field count: s32 where 0 <= count <= 20;
    field marks: list<s32> where len(marks) <= 6;

    message inc() when count < 20 changes count ensures next.count == count + 1;
    message add(n: s32 where 1 <= n <= 5) when count <= 15 changes count ensures next.count == count + n;
    message mark() when len(marks) < 6 changes marks ensures len(next.marks) == len(marks) + 1;
    message unmark(at: index<marks>) changes marks ensures len(next.marks) == len(marks) - 1;
    message reset() changes count, marks ensures next.count == 0 and len(next.marks) == 0;

    view main = p(field(count));
}

/// A lamp that breaks and can't be repaired: repair needs parts no message
/// adds, and once broken nothing else is enabled.
component lamp {
    field mode: enum { off, on, broken };
    field parts: list<s32>;

    message toggle() when mode != "broken" changes mode;
    message break_it() when mode == "on" changes mode ensures next.mode == "broken";
    message repair() when mode == "broken" and len(parts) > 3 changes mode ensures next.mode == "off";

    view main = p(field(mode));
}

example adds for tally {
    start { count: 1 }
    send add(2);
    expect count == 3;
    send inc();
    expect count == 4 and len(marks) == 0;
}

example wrong_on_purpose for tally {
    start { count: 2 }
    send inc();
    expect count == 4;
}
