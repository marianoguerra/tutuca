// TodoCard's implementation (todo_card.tcd has the rest).

import "'" {
    #[import = " chars · #"]
    const s_chars_label: &extern;
    #[import = " char · #"]
    const s_char_label: &extern;
}

fn todo_card_get_meta(state: &todo_card_state) -> &extern {
    let n = js_string_length(state.text);
    let unit = n == 1?s_char_label:s_chars_label;
    js_string_concat(js_string_concat(int_text(n), unit), int_text(state.id));
}

fn todo_card_on_toggle(state: &todo_card_state, ctx: &context) -> &todo_card_state {
    todo_card_with_done(state, !state.done);
}

fn todo_card_on_star(state: &todo_card_state, ctx: &context) -> &todo_card_state {
    todo_card_with_starred(state, !state.starred);
}

fn todo_card_on_set_done(state: &todo_card_state, ctx: &context, done: i32) -> &todo_card_state {
    todo_card_with_done(state, done);
}

fn todo_card_on_remove(state: &todo_card_state, ctx: &context) -> &todo_card_state {
    todo_card_notify_remove_me(ctx);
    state;
}
