// TodoItem again, as a card: another component module registering a
// component type under the same name as components/todo_item, with the same
// interface and a different implementation. TodoList (components/todo_list)
// works with either, since all it relies on is the interface:
//
// - init takes id (int), text (string) and done (bool);
// - id and done are readable properties;
// - setDone(bool) sets done;
// - wanting to be removed is a removeMe notify to the parent.
//
// Everything else is the card's own: its layout, buttons instead of a
// checkbox, the text's length, and a star the list knows nothing about.
// Loaded into a scope where TodoItem is registered already, it takes the
// name over: items made from then on are cards, the ones made before keep
// their own implementation, and the list holds both.

import "'" {
    #[import = "TodoItem"]
    const s_todo_item_type: &extern;
    #[import = "id"]
    const s_id: &extern;
    #[import = "text"]
    const s_text: &extern;
    #[import = "done"]
    const s_done: &extern;
    #[import = "starred"]
    const s_starred: &extern;
    #[import = "li"]
    const s_li: &extern;
    #[import = "div"]
    const s_div: &extern;
    #[import = "span"]
    const s_span: &extern;
    #[import = "button"]
    const s_button: &extern;
    #[import = "class"]
    const s_class: &extern;
    #[import = "title"]
    const s_title: &extern;
    #[import = "click"]
    const s_click: &extern;
    #[import =
        "todo-card card card-border bg-base-100 flex-row items-center justify-between gap-3 p-3"]
    const s_card_class: &extern;
    #[import =
        "todo-card done card card-border bg-base-200 flex-row items-center justify-between gap-3 p-3 opacity-70"]
    const s_card_done_class: &extern;
    #[import = "todo-card-main flex flex-col min-w-0"]
    const s_main_class: &extern;
    #[import = "todo-card-text font-semibold break-words"]
    const s_text_class: &extern;
    #[import = "todo-card-meta text-xs opacity-60 tabular-nums"]
    const s_meta_class: &extern;
    #[import = "todo-card-actions flex gap-1 shrink-0"]
    const s_actions_class: &extern;
    #[import = "done-toggle btn btn-xs btn-outline rounded-full"]
    const s_toggle_class: &extern;
    #[import = "done-toggle on btn btn-xs btn-success rounded-full"]
    const s_toggle_on_class: &extern;
    #[import = "star btn btn-xs btn-ghost opacity-50"]
    const s_star_class: &extern;
    #[import = "star on btn btn-xs btn-ghost text-warning"]
    const s_star_on_class: &extern;
    #[import = "remove btn btn-xs btn-ghost text-error"]
    const s_remove_class: &extern;
    #[import = "toggle"]
    const s_toggle: &extern;
    #[import = "star"]
    const s_star: &extern;
    #[import = "setDone"]
    const s_set_done: &extern;
    #[import = "remove"]
    const s_remove: &extern;
    #[import = "removeMe"]
    const s_remove_me: &extern;
    #[import = "✓ done"]
    const s_done_label: &extern;
    #[import = "○ to do"]
    const s_todo_label: &extern;
    #[import = "mark as to do"]
    const s_undo_hint: &extern;
    #[import = "mark as done"]
    const s_do_hint: &extern;
    #[import = "★"]
    const s_star_on_label: &extern;
    #[import = "☆"]
    const s_star_off_label: &extern;
    #[import = "unstar"]
    const s_unstar_hint: &extern;
    #[import = "star"]
    const s_star_hint: &extern;
    #[import = "remove"]
    const s_remove_label: &extern;
    #[import = " chars · #"]
    const s_chars_label: &extern;
    #[import = " char · #"]
    const s_char_label: &extern;
    #[import = "meta"]
    const s_meta: &extern;
    #[import = ""]
    const s_empty: &extern;
}

// ---- TodoItem, the card ----------------------------------------------------------
//
// <li class={done ? "todo-card done card ..." : "todo-card card ..."}>
//   <div class="todo-card-main ...">
//     <span class="todo-card-text ...">{text}</span>
//     <span class="todo-card-meta ...">{meta}</span>
//   </div>
//   <div class="todo-card-actions ...">
//     <button class={done ? "done-toggle on btn ..." : "done-toggle btn ..."} title={...} on:click="toggle">
//       {done ? "✓ done" : "○ to do"}
//     </button>
//     <button class={starred ? "star on btn ..." : "star btn ..."} title={...} on:click="star">
//       {starred ? "★" : "☆"}
//     </button>
//     <button class="remove btn ..." on:click="remove">remove</button>
//   </div>
// </li>
//
// meta is a computed property: "{n} chars · #{id}", or "1 char · #{id}".

type todo_card_state = { id: i32, text: &extern, done: i32, starred: i32 };

let todo_card_spec_made: &?component_spec = null;

fn todo_card_spec() -> &component_spec {
    if !!todo_card_spec_made {
        return todo_card_spec_made!;
    }
    let done = view_field(s_done);
    let starred = view_field(s_starred);
    let main =
        el_attrs(
            s_li,
            strs1(s_class),
            views1(view_if(done, text(s_card_done_class), text(s_card_class))),
            views2(
                el_attrs(
                    s_div,
                    strs1(s_class),
                    views1(text(s_main_class)),
                    views2(
                        el_attrs(
                            s_span,
                            strs1(s_class),
                            views1(text(s_text_class)),
                            views1(view_field(s_text)),
                        ),
                        el_attrs(
                            s_span,
                            strs1(s_class),
                            views1(text(s_meta_class)),
                            views1(view_field(s_meta)),
                        ),
                    ),
                ),
                el_attrs(
                    s_div,
                    strs1(s_class),
                    views1(text(s_actions_class)),
                    views3(
                        el_on(
                            s_button,
                            strs2(s_class, s_title),
                            views2(
                                view_if(done, text(s_toggle_on_class), text(s_toggle_class)),
                                view_if(done, text(s_undo_hint), text(s_do_hint)),
                            ),
                            views1(view_if(done, text(s_done_label), text(s_todo_label))),
                            view_ons1(s_click, s_toggle, views0()),
                        ),
                        el_on(
                            s_button,
                            strs2(s_class, s_title),
                            views2(
                                view_if(starred, text(s_star_on_class), text(s_star_class)),
                                view_if(starred, text(s_unstar_hint), text(s_star_hint)),
                            ),
                            views1(view_if(
                                        starred,
                                        text(s_star_on_label),
                                        text(s_star_off_label),
                                    )),
                            view_ons1(s_click, s_star, views0()),
                        ),
                        el_on(
                            s_button,
                            strs1(s_class),
                            views1(text(s_remove_class)),
                            views1(text(s_remove_label)),
                            view_ons1(s_click, s_remove, views0()),
                        ),
                    ),
                ),
            ),
        );
    let spec = spec_main(s_todo_item_type, main, no_loops());
    todo_card_spec_made = spec;
    spec;
}

fn todo_card_vtable() -> &vtable {
    {vtable|
        init: todo_card_init,
        handle: todo_card_handle,
        get: todo_card_get,
        set: todo_card_set,
    };
}

fn todo_card_init: init_fn (fields: &value) -> &init_result {
    let (id, issues) = init_int(fields, s_id, 0, list_empty());
    let (text, more) = init_string(fields, s_text, s_empty, issues);
    let (done, all) = init_bool(fields, s_done, 0, more);
    // Not part of the interface, so the list never passes it: missing is
    // the usual case, not an issue.
    let starred = 0;
    let found = fields.kind == value_kind_map?map_get(fields, s_starred):null;
    if !!found {
        if (found!).kind == value_kind_bool {
            starred = (found! as &value_bool).value;
        }
    }
    init_ok({todo_card_state| id, text, done, starred }, all);
}

fn todo_card_with(state: &todo_card_state, done: i32, starred: i32) -> &message_result {
    if (done == state.done) & (starred == state.starred) {
        return message_result_unchanged();
    }
    message_result_updated({todo_card_state| id: state.id, text: state.text, done, starred });
}

fn todo_card_handle: handle_fn (instance: &eq, m: &message, ctx: &context) -> &message_result {
    let state = instance as &todo_card_state;
    let name = m.name;
    if str_eq(name, s_toggle) {
        return todo_card_with(state, !state.done, state.starred);
    }
    if str_eq(name, s_star) {
        return todo_card_with(state, state.done, !state.starred);
    }
    // The interface: the list sends setDone(true) to every item for all done.
    if str_eq(name, s_set_done) {
        let (ok, done) = arg_bool(m.args, 0);
        if !ok {
            return message_result_rejected(message_error_wrong_arg_type(0));
        }
        return todo_card_with(state, done, state.starred);
    }
    // The interface: removing is the list's to do, so ask it.
    if str_eq(name, s_remove) {
        ctx_notify(ctx, s_remove_me, values0());
        return message_result_unchanged();
    }
    message_result_rejected(message_error_unknown_message());
}

fn todo_card_get: get_fn (instance: &eq, name: &extern) -> (i32, &?value) {
    let state = instance as &todo_card_state;
    if str_eq(name, s_id) {
        return (property_ok, value_int(state.id));
    }
    if str_eq(name, s_text) {
        return (property_ok, value_string(state.text));
    }
    if str_eq(name, s_done) {
        return (property_ok, value_bool(state.done));
    }
    if str_eq(name, s_starred) {
        return (property_ok, value_bool(state.starred));
    }
    if str_eq(name, s_meta) {
        return (property_ok, value_string(todo_card_meta(state)));
    }
    (property_no_such_property, null);
}

fn todo_card_set: set_fn (instance: &eq, name: &extern, v: &value) -> (i32, &?eq) {
    let state = instance as &todo_card_state;
    if str_eq(name, s_id) {
        return (property_not_writable, null);
    }
    if str_eq(name, s_text) {
        let text = value_string_of(v);
        if !text {
            return (property_wrong_type, null);
        }
        return
            (property_ok,
             {todo_card_state|
                 id: state.id,
                 text: text!,
                 done: state.done,
                 starred: state.starred,
             });
    }
    if str_eq(name, s_done) | str_eq(name, s_starred) {
        if v.kind != value_kind_bool {
            return (property_wrong_type, null);
        }
        let b = (v as &value_bool).value;
        if str_eq(name, s_done) {
            return
                (property_ok,
                 {todo_card_state|
                     id: state.id,
                     text: state.text,
                     done: b,
                     starred: state.starred,
                 });
        }
        return
            (property_ok,
             {todo_card_state| id: state.id, text: state.text, done: state.done, starred: b });
    }
    if str_eq(name, s_meta) {
        return (property_not_writable, null);
    }
    (property_no_such_property, null);
}

// "{n} chars · #{id}", or "1 char · #{id}".
fn todo_card_meta(state: &todo_card_state) -> &extern {
    let n = js_string_length(state.text);
    let unit = n == 1?s_char_label:s_chars_label;
    js_string_concat(js_string_concat(int_text(n), unit), int_text(state.id));
}

// ---- The module's interface (README.md has the convention) -------------------

#[export = "tutuca_abi_version"]
fn tutuca_abi_version() -> i32 {
    tutuca_abi_version_current;
}

#[export = "tutuca_register"]
fn tutuca_register(s: &scope) {
    scope_register(s, s_todo_item_type, todo_card_spec(), todo_card_vtable());
}
