// The instance of a type without state (JsonNull, JsonSelector).
type json_unit = { };

const JSON_UNIT: &json_unit = {json_unit| };

fn json_strs4(a: &extern, b: &extern, c: &extern, d: &extern) -> &str_array {
    let out = [str_array|null; 4];
    out[0] = a;
    out[1] = b;
    out[2] = c;
    out[3] = d;
    out;
}

// A <span> whose only attr is a constant class, with one constant text.
fn json_span_text(class: &extern, s: &extern) -> &view {
    el_class(s_span, class, views1(text(s)));
}

// A <button type="button"> with a class, a title (none when null), a text
// and one click handler.
fn json_button(
    class: &view,
    title: &?extern,
    label: &extern,
    message: &extern,
    args: &view_array,
) -> &view {
    let ons = view_ons1(s_click, message, args);
    if !title {
        return
            el_on(
                s_button,
                strs2(s_type, s_class),
                views2(text(s_button), class),
                views1(text(label)),
                ons,
            );
    }
    el_on(
        s_button,
        strs3(s_type, s_class, s_title),
        views3(text(s_button), class, text(title!)),
        views1(text(label)),
        ons,
    );
}

// What a type with these views is: no scopes, no provides.
fn json_spec(
    name: &extern,
    view_names: &str_array,
    views: &view_array,
    loops: &loop_def_array,
) -> &component_spec {
    spec_new(name, view_names, views, loops, no_scopes(), strs0(), no_provides());
}

// A component value's property, or null when it has none.
fn json_prop(v: &value, name: &extern) -> &?value {
    let c = value_as_component(v);
    if !c {
        return null;
    }
    let (code, got) = (c!).vtable.get((c!).instance, name);
    if code != property_ok {
        return null;
    }
    got;
}

// A value component's JSON text, through its json property; null when it
// isn't one.
fn json_of(v: &value) -> &extern {
    let got = json_prop(v, s_json);
    if !got {
        return s_null;
    }
    let text = value_string_of(got!);
    if !text {
        return s_null;
    }
    text!;
}

// The field name of init's fields when it's a component; else the error init
// fails with, since a component has no default.
fn json_init_component(fields: &value, name: &extern) -> &?value {
    let found = fields.kind == value_kind_map?map_get(fields, name):null;
    if !found {
        return null;
    }
    if (found!).kind != value_kind_component {
        return null;
    }
    found;
}

fn json_init_fail(field: &extern) -> &init_result {
    {init_result| instance: null, issues: list_empty(), error: value_string(field) };
}

// A string argument, or null.
fn json_arg_string(args: &value_array) -> &?extern {
    if args.length() != 1 {
        return null;
    }
    value_string_of(args[0]!);
}
