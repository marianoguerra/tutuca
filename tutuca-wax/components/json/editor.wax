// ---- JsonEditor ------------------------------------------------------------------
//
// A JSON document, shown read only or edited in place, with its JSON text.
//
// <div class="flex flex-col gap-3">
//   <div class="flex flex-wrap items-center gap-2">
//     <div class="join" role="group" aria-label="Mode">
//       <button class={isEdit ? "btn ..." : "btn ... btn-primary ..."} on:click="setMode('view')">View</button>
//       <button class={isEdit ? "btn ... btn-primary ..." : "btn ..."} on:click="setMode('edit')">Edit</button>
//     </div>
//     <label class="flex ..."><input type="checkbox" class="checkbox checkbox-xs"
//       checked={showText} on:change="setShowText(targetValue)"> JSON text</label>
//   </div>
//   <div class="overflow-auto">@pushView mode: render value</div>
//   {showText ? <pre class="rounded ...">{text}</pre> : ""}
// </div>

type json_editor_state = { value: &value, mode: &extern, show_text: i32 };

let json_editor_spec_made: &?component_spec = null;

fn json_mode_button(
    mode: &extern,
    label: &extern,
    edit_class: &extern,
    view_class: &extern,
) -> &view {
    json_button(
        view_if(view_field(s_is_edit), text(edit_class), text(view_class)),
        null,
        label,
        s_set_mode,
        views1(text(mode)),
    );
}

fn json_editor_spec() -> &component_spec {
    if !!json_editor_spec_made {
        return json_editor_spec_made!;
    }
    let modes =
        el_attrs(
            s_div,
            strs3(s_class, s_role, s_aria_label),
            views3(text(s_c_join), text(s_group), text(s_mode_label)),
            views2(
                json_mode_button(s_view, s_view_label, s_c_mode, s_c_mode_on),
                json_mode_button(s_edit, s_edit_label, s_c_mode_on, s_c_mode),
            ),
        );
    let show_text =
        el_class(
            s_label,
            s_c_label,
            views2(
                el_on(
                    s_input,
                    strs3(s_type, s_class, s_checked),
                    views3(text(s_checkbox), text(s_c_checkbox), view_field(s_show_text)),
                    views0(),
                    view_ons1(s_change, s_set_show_text, views1(view_target_value())),
                ),
                text(s_json_text_label),
            ),
        );
    let tree =
        el_class(
            s_div,
            s_c_scroll,
            views1(view_push_view(view_field(s_mode), view_render(view_field(s_value), null))),
        );
    let json_text =
        view_if(
            view_field(s_show_text),
            el_class(s_pre, s_c_pre, views1(view_field(s_text))),
            text(s_empty),
        );
    let main =
        el_class(
            s_div,
            s_c_editor,
            views3(el_class(s_div, s_c_bar, views2(modes, show_text)), tree, json_text),
        );
    let spec = json_spec(s_json_editor_type, strs1(s_main), views1(main), no_loops());
    json_editor_spec_made = spec;
    spec;
}

fn json_editor_vtable() -> &vtable {
    {vtable|
        init: json_editor_init,
        handle: json_editor_handle,
        get: json_editor_get,
        set: json_editor_set,
    };
}

fn json_is_mode(mode: &extern) -> i32 {
    str_eq(mode, s_view) | str_eq(mode, s_edit);
}

fn json_editor_init: init_fn (fields: &value) -> &init_result {
    let value = json_init_component(fields, s_value);
    if !value {
        return json_init_fail(s_value);
    }
    let (mode, issues) = init_string(fields, s_mode, s_view, list_empty());
    if !json_is_mode(mode) {
        mode = s_view;
    }
    let (show_text, more) = init_bool(fields, s_show_text, 0, issues);
    init_ok({json_editor_state| value: value!, mode, show_text }, more);
}

fn json_editor_handle: handle_fn (instance: &eq, m: &message, ctx: &context) -> &message_result {
    let s = instance as &json_editor_state;
    if str_eq(m.name, s_set_mode) {
        let mode = json_arg_string(m.args);
        if !mode {
            return message_result_rejected(message_error_wrong_arg_type(0));
        }
        if !json_is_mode(mode!) {
            return message_result_rejected(message_error_wrong_arg_type(0));
        }
        return
            message_result_updated(
                {json_editor_state| value: s.value, mode: mode!, show_text: s.show_text },
            );
    }
    if str_eq(m.name, s_set_show_text) {
        let (ok, show_text) = arg_bool(m.args, 0);
        if !ok {
            return message_result_rejected(message_error_wrong_arg_type(0));
        }
        return
            message_result_updated({json_editor_state| value: s.value, mode: s.mode, show_text });
    }
    message_result_rejected(message_error_unknown_message());
}

fn json_editor_get: get_fn (instance: &eq, name: &extern) -> (i32, &?value) {
    let s = instance as &json_editor_state;
    if str_eq(name, s_value) {
        return (property_ok, s.value);
    }
    if str_eq(name, s_mode) {
        return (property_ok, value_string(s.mode));
    }
    if str_eq(name, s_show_text) {
        return (property_ok, value_bool(s.show_text));
    }
    if str_eq(name, s_is_edit) {
        return (property_ok, value_bool(str_eq(s.mode, s_edit)));
    }
    if str_eq(name, s_json) {
        return (property_ok, value_string(json_of(s.value)));
    }
    // JSON.stringify(value, null, 2).
    if str_eq(name, s_text) {
        return (property_ok, value_string(json_indent(json_of(s.value))));
    }
    (property_no_such_property, null);
}

fn json_editor_set: set_fn (instance: &eq, name: &extern, v: &value) -> (i32, &?eq) {
    let s = instance as &json_editor_state;
    if str_eq(name, s_value) {
        if v.kind != value_kind_component {
            return (property_wrong_type, null);
        }
        return (property_ok, {json_editor_state| value: v, mode: s.mode, show_text: s.show_text });
    }
    (property_not_writable, null);
}
