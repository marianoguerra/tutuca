// The layout component module: boxes, tabs and a grid that hold components,
// the Hole a slot starts as, and the Screen a layout is shown in. Each has a
// main view, the layout as it's used, and a layout_edit view with what edits
// it: the +s that add a slot, remove, the tabs' names, the grid's rows and columns, and the
// holes' +. A Screen pushes layout_edit above its content while editing, so
// every component below it that has that view shows it (a component of any
// module can, by declaring a layout_edit view) and the rest keep main.
//
// A hole's + asks what it could become: the names of the types visible from
// the scope the hole was made in, which the package's ask_handler reads
// through the asker's context. Picking one swaps the hole for a component of
// that type, made in the hole's scope, or keeps the hole saying why when that
// type can't be made.
//
// A Screen made with studio set (the studio's, which writes components)
// provides it to what's below: the hole's list then offers a new component,
// and each slot a ✎ that edits the component in it, both asks the host
// answers (create_component, edit_component). Other hosts leave it unset and
// show neither.
package tutuca:layout@0.1.0;

/// What a layout is shown in: its content, and a toggle between using it
/// (main) and editing it (layout_edit, pushed above the content).
component Screen {
    field content: component = make(Vbox);
    /// Whether the layout is being edited: a mode, not part of the layout.
    field editing: bool @sync(none);
    /// Whether the host makes and edits components (the studio): set when
    /// it makes the screen, never kept.
    field studio: bool @sync(none);
    /// The view pushed above the content: layout_edit while editing.
    get pushed: string;

    message toggle_editing() changes editing ensures next.editing == not editing;

    provide studio = field(studio);

    // The toggle is the host's in the studio (its bar has it); others show
    // this one.
    view main = div(class: "screen relative flex flex-col",
        if(field(studio) != true, button(type: "button",
            class: "screen-toggle btn btn-ghost btn-xs btn-square absolute right-0 top-0 z-10 opacity-30 hover:opacity-100 focus:opacity-100",
            title: if(field(editing), "Use the layout", "Edit the layout"),
            "aria-label": if(field(editing), "Use the layout", "Edit the layout"),
            "aria-pressed": if(field(editing), "true", "false"),
            on_click: send(toggle_editing),
            if(field(editing),
                svg("viewBox": "0 0 24 24", class: "size-4", fill: "none", stroke: "currentColor", "stroke-width": "2", "stroke-linecap": "round", "stroke-linejoin": "round",
                    path(d: "M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"),
                    circle(cx: "12", cy: "12", r: "3")),
                svg("viewBox": "0 0 24 24", class: "size-4", fill: "none", stroke: "currentColor", "stroke-width": "2", "stroke-linecap": "round", "stroke-linejoin": "round",
                    path(d: "M12 20h9"),
                    path(d: "M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"))))),
        push_view(field(pushed), render(field(content))));
}

/// An empty slot: nothing while the layout is used; while it's edited, +
/// lists the types it could become, and picking one swaps it for a component
/// of that type, made with no fields. A type that can't be made that way
/// keeps the hole, with why in error.
component Hole {
    /// The types listed while + is open; like listing and error, an open
    /// menu, not part of a layout that's kept (sync none).
    field choices: list<record { name: string }> @sync(none);
    field listing: bool @sync(none);
    /// Why the last pick couldn't be made; empty when it could.
    field error: string @sync(none);

    /// The type names visible from here; with walk, the parent scopes' too.
    ask component_names(walk: bool) -> list<string>;
    /// A new component, written in the host and registered where the hole
    /// can make it: its name, or "" when it wasn't.
    ask create_component() -> string;

    message show_choices() changes error emits ask component_names;
    message create() changes error emits ask create_component;
    message hide_choices() changes choices, listing, error ensures not next.listing;
    message pick(at: index<choices>) -> swap changes error;

    view main = div(class: "hole-empty min-h-4 flex-1");
    view layout_edit = div(class: "hole flex min-h-16 min-w-24 flex-1 items-center justify-center outline-1 outline-dashed -outline-offset-1 outline-primary/70 p-2",
        if(field(listing),
            div(class: "flex flex-col items-center gap-1",
                ul(class: "choices menu menu-sm bg-base-100 rounded-box border border-base-300",
                    each(field(choices),
                        li(button(on_click: send(pick, source_key()), field(name)))),
                    if(provided(studio),
                        li(button(class: "hole-new text-primary", on_click: send(create), "+ new component")))),
                if(field(error), p(class: "error max-w-64 text-center text-xs text-error", field(error))),
                button(class: "btn btn-xs btn-ghost", on_click: send(hide_choices), "cancel")),
            button(class: "btn btn-sm btn-circle btn-ghost", title: "Put a component here", on_click: send(show_choices), "+")));
}

/// Components side by side, starting with a hole; edited, each can be
/// removed and the + to their right adds a hole after them. A slot's ✎ and
/// × show while it's hovered and no slot inside it is, so a nested slot's
/// don't cover its parent's.
component Hbox {
    field items: list<component>;

    /// With no items, a hole: a box put in a layout has a slot to fill.
    init;

    /// The component in a slot, edited in the host.
    ask edit_component(item: component) -> bool;

    message add() changes items ensures len(next.items) == len(items) + 1 emits make Hole;
    message remove_at(at: index<items>) changes items ensures len(next.items) == len(items) - 1;
    message edit_at(at: index<items>) changes nothing emits ask edit_component;

    // Each slot a grid in both views: what's in it fills it, as wide as the
    // others and as tall as the tallest; one that sets its own width or
    // height (w-fit, h-fit) keeps it, centered (the full width and height
    // have no specificity, so a component's own classes win).
    view main = div(class: "hbox flex flex-row items-stretch gap-2",
        each(field(items), div(class: "slot grid min-w-0 flex-1 place-items-center [:where(&)>*]:w-full [:where(&)>*]:h-full", render_it())));
    view layout_edit = div(class: "hbox flex flex-row items-stretch gap-2 outline-1 outline-dashed -outline-offset-1 outline-base-content/50 p-2",
        each(field(items),
            div(class: "slot relative grid min-w-0 flex-1 place-items-center [:where(&)>*]:w-full [:where(&)>*]:h-full",
                render_it(),
                if(provided(studio), button(class: "slot-edit btn btn-xs btn-circle btn-ghost absolute -left-1 -top-1 z-10 opacity-0 pointer-events-none focus-visible:opacity-100 [.slot:hover:not(:has(.slot:hover))>&]:opacity-100 [.slot:hover:not(:has(.slot:hover))>&]:pointer-events-auto", title: "Edit this component", on_click: send(edit_at, source_key()), "✎")),
                button(class: "slot-remove btn btn-xs btn-circle btn-ghost absolute -right-1 -top-1 text-error opacity-0 pointer-events-none focus-visible:opacity-100 [.slot:hover:not(:has(.slot:hover))>&]:opacity-100 [.slot:hover:not(:has(.slot:hover))>&]:pointer-events-auto", title: "Remove this slot", on_click: send(remove_at, source_key()), "×"))),
        button(class: "slot-add btn btn-xs btn-circle btn-ghost self-center", title: "Add a slot to the right", on_click: send(add), "+"));
}

/// Components one under the other, starting with a hole; edited, each can
/// be removed and the + below them adds a hole there.
component Vbox {
    field items: list<component>;

    /// With no items, a hole.
    init;

    /// The component in a slot, edited in the host.
    ask edit_component(item: component) -> bool;

    message add() changes items ensures len(next.items) == len(items) + 1 emits make Hole;
    message remove_at(at: index<items>) changes items ensures len(next.items) == len(items) - 1;
    message edit_at(at: index<items>) changes nothing emits ask edit_component;

    // Each slot a grid in both views: what's in it fills its width, or is
    // centered when it sets its own (as in Hbox).
    view main = div(class: "vbox flex flex-col items-stretch gap-2",
        each(field(items), div(class: "slot grid place-items-center [:where(&)>*]:w-full [:where(&)>*]:h-full", render_it())));
    view layout_edit = div(class: "vbox flex flex-col items-stretch gap-2 outline-1 outline-dashed -outline-offset-1 outline-base-content/50 p-2",
        each(field(items),
            div(class: "slot relative grid place-items-center [:where(&)>*]:w-full [:where(&)>*]:h-full",
                render_it(),
                if(provided(studio), button(class: "slot-edit btn btn-xs btn-circle btn-ghost absolute -left-1 -top-1 z-10 opacity-0 pointer-events-none focus-visible:opacity-100 [.slot:hover:not(:has(.slot:hover))>&]:opacity-100 [.slot:hover:not(:has(.slot:hover))>&]:pointer-events-auto", title: "Edit this component", on_click: send(edit_at, source_key()), "✎")),
                button(class: "slot-remove btn btn-xs btn-circle btn-ghost absolute -right-1 -top-1 text-error opacity-0 pointer-events-none focus-visible:opacity-100 [.slot:hover:not(:has(.slot:hover))>&]:opacity-100 [.slot:hover:not(:has(.slot:hover))>&]:pointer-events-auto", title: "Remove this slot", on_click: send(remove_at, source_key()), "×"))),
        button(class: "slot-add btn btn-xs btn-circle btn-ghost self-center", title: "Add a slot below", on_click: send(add), "+"));
}

/// Components as tabs, one shown at a time, each with a name ("Tab n" until
/// it's given one), starting with one holding a hole; edited, tabs are
/// renamed and removed, and the + after the last adds one holding a hole.
component Tabs {
    field panels: list<component>;
    /// The tabs' names, by panel; a missing or empty one shows as "Tab n".
    field labels: list<string>;
    field active: s32 where active >= 0;

    /// With no panels, one holding a hole.
    init;

    /// The component in a tab, edited in the host.
    ask edit_component(item: component) -> bool;

    invariant active_in_range: len(panels) == 0 or active < len(panels);

    message add() changes panels, labels, active ensures len(next.panels) == len(panels) + 1 emits make Hole;
    message select(at: index<panels>) changes active ensures next.active == at;
    message edit_at(at: index<panels>) changes nothing emits ask edit_component;
    message rename(at: index<panels>, label: string) changes labels;
    message remove_at(at: index<panels>) changes panels, labels, active ensures len(next.panels) == len(panels) - 1;

    /// The tab headers: each one's name, the active one marked.
    loop headers { enrich { label: string, is_active: bool } }
    /// The panels: only the active one.
    loop shown { filter }

    view main = div(class: "tabs-box flex flex-col gap-2",
        div(role: "tablist", class: "tabs tabs-border",
            each(loop: headers, field(panels),
                button(role: "tab", class: if(bind(is_active), "tab tab-active", "tab"), on_click: send(select, source_key()), bind(label)))),
        each(loop: shown, field(panels), div(class: "tab-panel grid place-items-center [:where(&)>*]:w-full [:where(&)>*]:h-full", render_it())));
    view layout_edit = div(class: "tabs-box flex flex-col gap-2 outline-1 outline-dashed -outline-offset-1 outline-base-content/50 p-2",
        div(role: "tablist", class: "tabs tabs-border",
            each(loop: headers, field(panels),
                div(role: "tab", class: if(bind(is_active), "tab tab-active gap-1", "tab gap-1"), on_click: send(select, source_key()),
                    input(class: "tab-name input input-ghost input-xs w-24", "aria-label": "Tab name", value: bind(label),
                        on_input: send(rename, source_key(), target_value())),
                    if(provided(studio),
                        button(class: "tab-edit btn btn-xs btn-circle btn-ghost", title: "Edit this component", on_click: send(edit_at, source_key()), "✎")),
                    button(class: "tab-remove btn btn-xs btn-circle btn-ghost text-error", title: "Remove this tab", on_click: send(remove_at, source_key()), "×"))),
            button(class: "tab-add tab", title: "Add a tab", on_click: send(add), "+")),
        each(loop: shown, field(panels), div(class: "tab-panel grid place-items-center [:where(&)>*]:w-full [:where(&)>*]:h-full", render_it())));
}

/// Components in a grid, starting with a hole; edited, cells are removed,
/// the + after the last adds one, and the columns and rows grow and shrink
/// with - and +.
component Grid {
    field cells: list<component>;
    field columns: s32 = 2 where 1 <= columns <= 6;

    /// With no cells, a hole.
    init;
    get grid_style: string;
    /// Rows, the last one maybe not full.
    get rows: s32;

    /// The component in a cell, edited in the host.
    ask edit_component(item: component) -> bool;

    message add() changes cells ensures len(next.cells) == len(cells) + 1 emits make Hole;
    message remove_at(at: index<cells>) changes cells ensures len(next.cells) == len(cells) - 1;
    message edit_at(at: index<cells>) changes nothing emits ask edit_component;
    message more_columns() when columns < 6 changes columns ensures next.columns == columns + 1;
    message fewer_columns() when columns > 1 changes columns ensures next.columns == columns - 1;
    /// A row of holes below the others.
    message add_row() changes cells ensures len(next.cells) == len(cells) + columns emits make Hole;
    /// The last row's cells, removed.
    message remove_row() when len(cells) > 0 changes cells ensures len(next.cells) < len(cells);

    view main = div(class: "grid-box grid gap-2", style: field(grid_style), 
        each(field(cells), div(class: "slot grid min-w-0 place-items-center [:where(&)>*]:w-full [:where(&)>*]:h-full", render_it())));
    view layout_edit = div(class: "grid-box flex flex-col gap-2 outline-1 outline-dashed -outline-offset-1 outline-base-content/50 p-2",
        div(class: "flex flex-wrap items-center gap-1 text-xs",
            button(class: "btn btn-xs", title: "Fewer columns", on_click: send(fewer_columns), "-"),
            span(class: "tabular-nums", field(columns), " columns"),
            button(class: "btn btn-xs", title: "More columns", on_click: send(more_columns), "+"),
            button(class: "btn btn-xs", title: "Remove the last row", on_click: send(remove_row), "-"),
            span(class: "tabular-nums", field(rows), " rows"),
            button(class: "btn btn-xs", title: "Add a row", on_click: send(add_row), "+")),
        div(class: "grid gap-2", style: field(grid_style),
            each(field(cells),
                div(class: "slot relative grid place-items-center [:where(&)>*]:w-full [:where(&)>*]:h-full",
                    render_it(),
                    if(provided(studio), button(class: "slot-edit btn btn-xs btn-circle btn-ghost absolute -left-1 -top-1 z-10 opacity-0 pointer-events-none focus-visible:opacity-100 [.slot:hover:not(:has(.slot:hover))>&]:opacity-100 [.slot:hover:not(:has(.slot:hover))>&]:pointer-events-auto", title: "Edit this component", on_click: send(edit_at, source_key()), "✎")),
                    button(class: "slot-remove btn btn-xs btn-circle btn-ghost absolute -right-1 -top-1 text-error opacity-0 pointer-events-none focus-visible:opacity-100 [.slot:hover:not(:has(.slot:hover))>&]:opacity-100 [.slot:hover:not(:has(.slot:hover))>&]:pointer-events-auto", title: "Remove this cell", on_click: send(remove_at, source_key()), "×"))),
            button(class: "slot-add btn btn-xs btn-circle btn-ghost self-center justify-self-start", title: "Add a cell", on_click: send(add), "+")));
}

register Screen, Hole, Hbox, Vbox, Tabs, Grid;

/// component_names: the type names the asker's scope can make.
ask_handler component_names(walk: bool) -> list<string>;
/// create_component and edit_component: answered by the studio, later.
host_ask create_component;
host_ask edit_component;

example add_then_select for Tabs {
    start { }
    send add();
    expect len(panels) == 2;
    send select(1);
    expect active == 1;
}

example remove_keeps_a_tab_shown for Tabs {
    start { }
    send add();
    send remove_at(1);
    expect len(panels) == 1 and active == 0;
}

example rows_follow_the_columns for Grid {
    start { columns: 3 }
    send add_row();
    expect len(cells) == 4;
    send remove_row();
    expect len(cells) == 3;
}

example columns_stay_in_range for Grid {
    start { columns: 6 }
    send fewer_columns();
    expect columns == 5;
}
