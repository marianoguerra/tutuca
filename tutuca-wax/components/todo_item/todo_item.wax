// TodoItem's implementation (todo_item.tcd has the rest).

fn todo_item_on_toggle(state: &todo_item_state, ctx: &context) -> &todo_item_state {
    todo_item_with_done(state, !state.done);
}

fn todo_item_on_set_done(state: &todo_item_state, ctx: &context, done: i32) -> &todo_item_state {
    todo_item_with_done(state, done);
}

fn todo_item_on_remove(state: &todo_item_state, ctx: &context) -> &todo_item_state {
    todo_item_notify_remove_me(ctx);
    state;
}
