// The showcase module's implementation (showcase.tcd has the rest).

import "'" {
    #[import = " books"]
    const s_books_label: &extern;
    #[import = " ("]
    const s_open_paren: &extern;
    #[import = ")"]
    const s_close_paren: &extern;
}

// ---- Shelf --------------------------------------------------------------------------

fn shelf_book_year(books: &value, i: i32) -> i32 {
    (value_member(list_get(books, i)!, gs_year) as &value_int).value;
}

fn shelf_get_share(state: &shelf_state) -> f64 {
    let n = list_count(state.books);
    if n == 0 {
        return 0.0;
    }
    let read = 0;
    let i = 0;
    while i <s n {
        if value_truthy(value_member(list_get(state.books, i)!, gs_read)) {
            read += 1;
        }
        i += 1;
    }
    read as f64_s / n as f64_s;
}

fn shelf_on_toggle_unread(state: &shelf_state, ctx: &context) -> &shelf_state {
    shelf_with_only_unread(state, !state.only_unread);
}

// The list with the item at from taken out and put in at to.
fn shelf_move(items: &value, from: i32, to: i32) -> &value {
    let moved = list_get(items, from)!;
    let rest = list_empty();
    let i = 0;
    while i <s list_count(items) {
        if i != from {
            rest = list_push(rest, list_get(items, i)!);
        }
        i += 1;
    }
    let out = list_empty();
    i = 0;
    while i <s list_count(rest) {
        if i == to {
            out = list_push(out, moved);
        }
        out = list_push(out, list_get(rest, i)!);
        i += 1;
    }
    if to >=s list_count(rest) {
        out = list_push(out, moved);
    }
    out;
}

fn shelf_on_move_book(
    state: &shelf_state,
    ctx: &context,
    from: &value,
    to: &value,
) -> &shelf_state {
    ctx_log(ctx, ctx.drag);
    if (from.kind != value_kind_int) | (to.kind != value_kind_int) {
        return state;
    }
    let f = (from as &value_int).value;
    let t = (to as &value_int).value;
    if f == t {
        return state;
    }
    shelf_with_books(state, shelf_move(state.books, f, t));
}

fn shelf_on_note_book(
    state: &shelf_state,
    ctx: &context,
    book: &value,
    note: &value,
) -> &shelf_state {
    if (book.kind != value_kind_int) | (note.kind != value_kind_int) {
        return state;
    }
    let title = value_member(list_get(state.books, (book as &value_int).value)!, gs_title);
    let at = selector_item(gs_notes, path_key_index((note as &value_int).value));
    note_send_set_text(ctx, at, value_string_of(title)!);
    state;
}

fn shelf_scope_header(state: &shelf_state) -> &shelf_scope_header_binds {
    let n = list_count(state.books);
    {shelf_scope_header_binds| heading: js_string_concat(int_text(n), s_books_label) };
}

fn shelf_loop_books_key(state: &shelf_state, key: &value, item: &value) -> &extern {
    value_string_of(value_member(item, gs_title))!;
}

fn shelf_loop_books_filter(state: &shelf_state, key: &value, item: &value) -> i32 {
    if !state.only_unread {
        return 1;
    }
    !value_truthy(value_member(item, gs_read));
}

fn shelf_loop_books_enrich(
    state: &shelf_state,
    key: &value,
    item: &value,
) -> &shelf_loop_books_binds {
    let title = value_string_of(value_member(item, gs_title))!;
    let year = int_text((value_member(item, gs_year) as &value_int).value);
    let label =
        js_string_concat(
            js_string_concat(js_string_concat(title, s_open_paren), year),
            s_close_paren,
        );
    {shelf_loop_books_binds| label };
}

// The books' indexes, by year: an insertion sort, stable.
fn shelf_loop_by_year_prepare(state: &shelf_state, books: &value) -> &value {
    let order = list_empty();
    let i = 0;
    while i <s list_count(books) {
        let year = shelf_book_year(books, i);
        let sorted = list_empty();
        let placed = 0;
        let j = 0;
        while j <s list_count(order) {
            let at = list_get(order, j)!;
            if !placed & (year <s shelf_book_year(books, (at as &value_int).value)) {
                sorted = list_push(sorted, value_int(i));
                placed = 1;
            }
            sorted = list_push(sorted, at);
            j += 1;
        }
        if !placed {
            sorted = list_push(sorted, value_int(i));
        }
        order = sorted;
        i += 1;
    }
    order;
}

// [index, book] in the order prepare sorted.
fn shelf_loop_by_year_iter(state: &shelf_state, books: &value, order: &value) -> &value {
    let out = list_empty();
    let i = 0;
    while i <s list_count(order) {
        let at = list_get(order, i)!;
        out =
            list_push(
                out,
                list_push(list_push(list_empty(), at), list_get(books, (at as &value_int).value)!),
            );
        i += 1;
    }
    out;
}

// ---- Note ---------------------------------------------------------------------------

fn note_on_set_text(state: &note_state, ctx: &context, text: &extern) -> &note_state {
    note_with_text(state, text);
}
