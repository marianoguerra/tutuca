// The showcase component module: Shelf and Note, using what the other
// examples' views don't: a scope's binds, a loop with filter, enrich and key
// hooks, seq items, a float, a provided value, pushView, and renderIt.

import "'" {
    #[import = "Shelf"]
    const s_shelf_type: &extern;
    #[import = "Note"]
    const s_note_type: &extern;
    #[import = "books"]
    const s_books: &extern;
    #[import = "onlyUnread"]
    const s_only_unread: &extern;
    #[import = "tags"]
    const s_tags: &extern;
    #[import = "current"]
    const s_current: &extern;
    #[import = "theme"]
    const s_theme: &extern;
    #[import = "note"]
    const s_note: &extern;
    #[import = "notes"]
    const s_notes: &extern;
    #[import = "share"]
    const s_share: &extern;
    #[import = "header"]
    const s_header: &extern;
    #[import = "heading"]
    const s_heading: &extern;
    #[import = "label"]
    const s_label: &extern;
    #[import = "title"]
    const s_title: &extern;
    #[import = "year"]
    const s_year: &extern;
    #[import = "read"]
    const s_read: &extern;
    #[import = "text"]
    const s_text: &extern;
    #[import = "compact"]
    const s_compact: &extern;
    #[import = "toggleUnread"]
    const s_toggle_unread: &extern;
    #[import = "section"]
    const s_section: &extern;
    #[import = "h2"]
    const s_h2: &extern;
    #[import = "button"]
    const s_button: &extern;
    #[import = "ul"]
    const s_ul: &extern;
    #[import = "li"]
    const s_li: &extern;
    #[import = "p"]
    const s_p: &extern;
    #[import = "div"]
    const s_div: &extern;
    #[import = "small"]
    const s_small: &extern;
    #[import = "class"]
    const s_class: &extern;
    #[import = "click"]
    const s_click: &extern;
    #[import = "shelf card card-border bg-base-100 gap-2 p-4"]
    const s_shelf_class: &extern;
    #[import = "card-title"]
    const s_title_class: &extern;
    #[import = "btn btn-sm btn-outline w-fit"]
    const s_toggle_class: &extern;
    #[import = "flex flex-wrap gap-1"]
    const s_books_class: &extern;
    #[import = "read badge badge-success"]
    const s_read_class: &extern;
    #[import = "unread badge badge-outline"]
    const s_unread_class: &extern;
    #[import = "text-sm opacity-70 tabular-nums"]
    const s_share_class: &extern;
    #[import = "tag badge badge-primary"]
    const s_tag_class: &extern;
    #[import = "notes flex flex-col gap-1"]
    const s_notes_class: &extern;
    #[import = "note text-sm"]
    const s_note_class: &extern;
    #[import = "show all"]
    const s_show_all: &extern;
    #[import = "only unread"]
    const s_only_unread_label: &extern;
    #[import = " books"]
    const s_books_label: &extern;
    #[import = " ("]
    const s_open_paren: &extern;
    #[import = ")"]
    const s_close_paren: &extern;
    #[import = "main"]
    const s_main_view: &extern;
    #[import = "value"]
    const s_value_bind: &extern;
    #[import = ""]
    const s_empty: &extern;
}

// ---- Shelf -----------------------------------------------------------------------
//
// <section class="shelf card ...">
//   @scope header: <h2 class="card-title">{heading}</h2>
//   <button class="btn ..." on:click="toggleUnread">{onlyUnread ? "show all" : "only unread"}</button>
//   <ul class="flex ...">
//     @each books (loop books): <li class={read ? "read badge ..." : "unread badge ..."}>{label}</li>
//   </ul>
//   <p class="tag badge ...">{tags[current]}</p>
//   <p class="text-sm ...">{share}</p>
//   @pushView compact: render note
//   <div class="notes flex ...">@each notes: renderIt</div>
// </section>
//
// The books loop keeps only the unread ones when onlyUnread, keys them by
// title, and binds label as "title (year)". Shelf provides its theme.

type shelf_state = {
    books: &value,
    only_unread: i32,
    tags: &value,
    current: i32,
    theme: &extern,
    note: &value,
    notes: &value
};

let shelf_spec_made: &?component_spec = null;

fn shelf_spec() -> &component_spec {
    if !!shelf_spec_made {
        return shelf_spec_made!;
    }
    let book =
        el_attrs(
            s_li,
            strs1(s_class),
            views1(view_if(view_field(s_read), text(s_read_class), text(s_unread_class))),
            views1(view_lookup_bind(s_label)),
        );
    let toggle =
        el_class_on(
            s_button,
            s_toggle_class,
            views1(view_if(
                        view_field(s_only_unread),
                        text(s_show_all),
                        text(s_only_unread_label),
                    )),
            view_ons1(s_click, s_toggle_unread, views0()),
        );
    let childs = [view_array|null; 7];
    childs[0] =
        view_scope(s_header, el_class(s_h2, s_title_class, views1(view_lookup_bind(s_heading))));
    childs[1] = toggle;
    childs[2] =
        el_class(s_ul, s_books_class, views1(view_each(view_field(s_books), book, s_books)));
    childs[3] =
        el_attrs(
            s_p,
            strs1(s_class),
            views1(text(s_tag_class)),
            views1(view_seq_item(s_tags, s_current)),
        );
    childs[4] = el_class(s_p, s_share_class, views1(view_field(s_share)));
    childs[5] = view_push_view(text(s_compact), view_render(view_field(s_note), null));
    childs[6] =
        el_attrs(
            s_div,
            strs1(s_class),
            views1(text(s_notes_class)),
            views1(view_each(view_field(s_notes), view_render_it(null), null)),
        );
    let main = el_attrs(s_section, strs1(s_class), views1(text(s_shelf_class)), childs);
    let books =
        {loop_def|
            name: s_books,
            key: shelf_book_key,
            filter: shelf_book_filter,
            enrich: shelf_book_enrich,
            view: null,
        };
    let scopes = [scope_def_array|null; 1];
    scopes[0] = {scope_def| name: s_header, bind: shelf_header };
    let provides = [selector_array|null; 1];
    provides[0] = selector_field(s_theme);
    let spec =
        spec_new(
            s_shelf_type,
            strs1(s_main_view),
            views1(main),
            loops1(books),
            scopes,
            strs1(s_theme),
            provides,
        );
    shelf_spec_made = spec;
    spec;
}

fn shelf_book_key: loop_key_fn (instance: &eq, key: &value, item: &value) -> &value {
    map_get(item, s_title)!;
}

fn shelf_book_filter: loop_filter_fn (instance: &eq, key: &value, item: &value) -> i32 {
    if !(instance as &shelf_state).only_unread {
        return 1;
    }
    !value_truthy(map_get(item, s_read)!);
}

fn shelf_book_enrich: loop_enrich_fn (instance: &eq, binds: &value) -> &value {
    let book = map_get(binds, s_value_bind)!;
    let title = value_string_of(map_get(book, s_title)!)!;
    let year = int_text((map_get(book, s_year)! as &value_int).value);
    let label =
        js_string_concat(
            js_string_concat(js_string_concat(title, s_open_paren), year),
            s_close_paren,
        );
    map_assoc(map_empty(), s_label, value_string(label));
}

fn shelf_header: scope_bind_fn (instance: &eq) -> &value {
    let n = list_count((instance as &shelf_state).books);
    map_assoc(map_empty(), s_heading, value_string(js_string_concat(int_text(n), s_books_label)));
}

fn shelf_vtable() -> &vtable {
    {vtable| init: shelf_init, handle: shelf_handle, get: shelf_get, set: shelf_set };
}

fn shelf_init: init_fn (fields: &value) -> &init_result {
    let (books, i1) = init_list(fields, s_books, list_empty());
    let (only_unread, i2) = init_bool(fields, s_only_unread, 0, i1);
    let (tags, i3) = init_list(fields, s_tags, i2);
    let (current, i4) = init_int(fields, s_current, 0, i3);
    let (theme, i5) = init_string(fields, s_theme, s_empty, i4);
    let note = value_null();
    let found = map_get(fields, s_note);
    if !!found {
        note = found!;
    }
    let (notes, i6) = init_list(fields, s_notes, i5);
    let state = {shelf_state| books, only_unread, tags, current, theme, note, notes };
    init_ok(state, i6);
}

fn shelf_with(s: &shelf_state, only_unread: i32, note: &value, notes: &value) -> &shelf_state {
    {shelf_state|
        books: s.books,
        only_unread,
        tags: s.tags,
        current: s.current,
        theme: s.theme,
        note,
        notes,
    };
}

fn shelf_handle: handle_fn (instance: &eq, m: &message, ctx: &context) -> &message_result {
    let s = instance as &shelf_state;
    if str_eq(m.name, s_toggle_unread) {
        return message_result_updated(shelf_with(s, !s.only_unread, s.note, s.notes));
    }
    message_result_rejected(message_error_unknown_message());
}

// The share of the books read, a float: what a view renders as JS's String(n).
fn shelf_share(s: &shelf_state) -> f64 {
    let n = list_count(s.books);
    if n == 0 {
        return 0.0;
    }
    let read = 0;
    let i = 0;
    while i <s n {
        if value_truthy(map_get(list_get(s.books, i)!, s_read)!) {
            read += 1;
        }
        i += 1;
    }
    read as f64_s / n as f64_s;
}

fn shelf_get: get_fn (instance: &eq, name: &extern) -> (i32, &?value) {
    let s = instance as &shelf_state;
    if str_eq(name, s_books) {
        return (property_ok, s.books);
    }
    if str_eq(name, s_only_unread) {
        return (property_ok, value_bool(s.only_unread));
    }
    if str_eq(name, s_tags) {
        return (property_ok, s.tags);
    }
    if str_eq(name, s_current) {
        return (property_ok, value_int(s.current));
    }
    if str_eq(name, s_theme) {
        return (property_ok, value_string(s.theme));
    }
    if str_eq(name, s_note) {
        return (property_ok, s.note);
    }
    if str_eq(name, s_notes) {
        return (property_ok, s.notes);
    }
    if str_eq(name, s_share) {
        return (property_ok, value_float(shelf_share(s)));
    }
    (property_no_such_property, null);
}

// Only the children change, through their paths; the rest is read-only here.
fn shelf_set: set_fn (instance: &eq, name: &extern, v: &value) -> (i32, &?eq) {
    let s = instance as &shelf_state;
    if str_eq(name, s_note) {
        return (property_ok, shelf_with(s, s.only_unread, v, s.notes));
    }
    if str_eq(name, s_notes) {
        if v.kind != value_kind_list {
            return (property_wrong_type, null);
        }
        return (property_ok, shelf_with(s, s.only_unread, s.note, v));
    }
    (property_not_writable, null);
}

// ---- Note ------------------------------------------------------------------------
//
// main:    <p class="note text-sm">{text}</p>
// compact: <small class={provided theme}>{text}</small>

type note_state = { text: &extern };

let note_spec_made: &?component_spec = null;

fn note_spec() -> &component_spec {
    if !!note_spec_made {
        return note_spec_made!;
    }
    let main =
        el_attrs(s_p, strs1(s_class), views1(text(s_note_class)), views1(view_field(s_text)));
    let compact =
        el_attrs(
            s_small,
            strs1(s_class),
            views1(view_provided(s_theme)),
            views1(view_field(s_text)),
        );
    let spec =
        spec_new(
            s_note_type,
            strs2(s_main_view, s_compact),
            views2(main, compact),
            no_loops(),
            no_scopes(),
            strs0(),
            no_provides(),
        );
    note_spec_made = spec;
    spec;
}

fn note_vtable() -> &vtable {
    {vtable| init: note_init, handle: note_handle, get: note_get, set: note_set };
}

fn note_init: init_fn (fields: &value) -> &init_result {
    let (text, issues) = init_string(fields, s_text, s_empty, list_empty());
    init_ok({note_state| text }, issues);
}

fn note_handle: handle_fn (instance: &eq, m: &message, ctx: &context) -> &message_result {
    message_result_rejected(message_error_unknown_message());
}

fn note_get: get_fn (instance: &eq, name: &extern) -> (i32, &?value) {
    if str_eq(name, s_text) {
        return (property_ok, value_string((instance as &note_state).text));
    }
    (property_no_such_property, null);
}

fn note_set: set_fn (instance: &eq, name: &extern, v: &value) -> (i32, &?eq) {
    (property_not_writable, null);
}

// ---- The module's interface (README.md has the convention) -------------------

#[export = "tutuca_abi_version"]
fn tutuca_abi_version() -> i32 {
    tutuca_abi_version_current;
}

#[export = "tutuca_register"]
fn tutuca_register(s: &scope) {
    scope_register(s, s_shelf_type, shelf_spec(), shelf_vtable());
    scope_register(s, s_note_type, note_spec(), note_vtable());
}
