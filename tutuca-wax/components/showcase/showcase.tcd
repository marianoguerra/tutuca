// The showcase component module: Shelf and Note, using what the other
// examples' views don't: a scope's binds, a loop with filter, enrich and key
// hooks, a loop with prepare and iter hooks, seq items, a float, a provided
// value, push_view, render_it, and drag and drop.
package tutuca:showcase@0.1.0;

/// A shelf of books. The books loop keeps only the unread ones when
/// only_unread, keys them by title, and binds label as "title (year)"; the
/// by_year loop's prepare sorts their indexes by year, and its iter gives the
/// books in that order. A book dropped on another moves there; dropped on a
/// note, which handles no drop, it reaches the notes' on_drop, which sends
/// that note the book's title.
component Shelf {
    field books: list<record { title: string, year: s32, read: bool }>;
    field only_unread: bool;
    field tags: list<string>;
    field current: s32;
    field theme: string;
    field note: option<Note>;
    field notes: list<Note>;
    /// The share of the books read.
    get share: f64 where 0 <= share <= 1;
    /// "1 of 3 read".
    get read_text: string;

    provide theme = field(theme);

    message toggle_unread() changes only_unread ensures next.only_unread == not only_unread;
    /// The book dragged from from, dropped on the one at to; a drag from
    /// elsewhere has no key, and nothing moves.
    message move_book(from: option<index<books>>, to: option<index<books>>) changes books
        ensures len(next.books) == len(books);
    /// A book dropped on a note writes its title there.
    message note_book(book: option<index<books>>, note: option<index<notes>>) changes nothing
        emits send Note.set_text;

    scope header { heading: string }
    loop books { key: string; filter; enrich { label: string } }
    loop by_year { prepare: list<s32>; iter }

    // Each row of the list says what it shows.
    view main = section(class: "shelf card card-border bg-base-100 gap-3 p-4",
        scope(header, h2(class: "card-title", bind(heading))),
        dl(class: "grid grid-cols-[8rem_1fr] gap-x-3 gap-y-3 items-center text-sm",
            dt(class: "opacity-60", "Books"),
            dd(class: "flex flex-col gap-1",
                button(class: "btn btn-xs btn-outline w-fit", on_click: send(toggle_unread),
                    if(field(only_unread), "show all", "only unread")),
                ul(class: "flex flex-wrap gap-1",
                    each(loop: books, field(books),
                        li(class: if(field(read), "read badge badge-success cursor-grab", "unread badge badge-outline cursor-grab"),
                            title: "drag onto another book to move it there, or onto a note",
                            draggable: "true",
                            "data-dragtype": "book",
                            on_drop: send(move_book, drag_key(), source_key()),
                            bind(label)))),
                span(class: "text-xs opacity-60", "green: read. Drag a book onto another to reorder.")),
            dt(class: "opacity-60", "Oldest first"),
            dd(class: "by-year flex flex-wrap gap-1",
                each(loop: by_year, field(books), span(class: "badge badge-ghost", field(title)))),
            dt(class: "opacity-60", "Current tag"),
            dd(p(class: "tag badge badge-primary", seq_item(tags, current))),
            dt(class: "opacity-60", "Read"),
            dd(class: "flex items-center gap-2",
                progress(class: "progress progress-success w-32", max: "1", value: field(share)),
                span(class: "tabular-nums", field(read_text))),
            dt(class: "opacity-60", "Pinned note"),
            dd(push_view("compact", render(field(note)))),
            dt(class: "opacity-60", "Notes"),
            dd(class: "notes flex flex-col gap-1", on_drop: send(note_book, drag_key(), source_key()),
                each(field(notes), render_it()),
                span(class: "text-xs opacity-60", "Drop a book on a note to write its title there."))));
}

/// A note: its text, in a paragraph, or small in the provided theme.
component Note {
    field text: string;

    message set_text(text: string) changes text ensures next.text == text;

    view main = p(class: "note text-sm rounded-box border border-dashed border-base-300 px-2 py-1", field(text));
    view compact = small(class: provided(theme), field(text));
}
