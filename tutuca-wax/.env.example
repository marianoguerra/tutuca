# API keys for the studio's assistant: copy this file to .env and set the ones
# you have. `just studio-server` reads it (scripts/studio-server.mjs) and
# offers the models of every provider with a key. Any provider pi-ai knows
# works; its README lists every variable (node_modules/@earendil-works/pi-ai).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
