///|
/// The model of a pure-tutuca module, built and validated, with what was
/// found wrong.
fn pkg_of(src : String) -> (@check.Package, Array[@diag.Diagnostic]) {
  let checked = match @pure.check_source("t.tutuca.ts", src) {
    Ok(c) => c
    Err(ds) => abort(ds.map(d => d.message).join("; "))
  }
  let (pkg, diags) = @pure.build("t.tutuca.ts", src, checked)
  diags.append(@check.validate(pkg))
  (pkg, diags)
}

///|
/// The generated files of a small component, as golden files: a change to
/// them is a change to what every component's boilerplate is.
test "generated contract and glue of a small component" {
  let (pkg, diags) = pkg_of(
    (
      #|import { button, field, send } from "tutuca/view";
      #|export interface TallyNotifies { changed(count: number): void; }
      #|export type Tally = { count: number; mode: "up" | "down" };
      #|export const Tally = {
      #|  defaults: { count: 0, mode: "up" },
      #|  constraints: { count: { int: true, min: 0, max: 9 } },
      #|  on: {
      #|    bump: {
      #|      changes: ["count"],
      #|      constraints: { n: { int: true, min: 1 } },
      #|      pre(prev, [n]: [number]) { return prev.count < 9; },
      #|      post(prev, next, [n]: [number]) { return next.count === prev.count + n; },
      #|      run(next, [n]: [number], ctx) {
      #|        next.count += n;
      #|        ctx.notify("changed", [next.count]);
      #|      },
      #|    },
      #|  },
      #|  view: button({ class: "btn", "on:click": send("bump", 1) }, field("count")),
      #|};
    ),
  )
  debug_inspect(diags.length(), content="0")
  let out = @gen.generate(pkg, "t.tutuca.ts")
  inspect(
    out.contract,
    content=(
      #|// Generated by pure-tutuca from t.tutuca.ts: the string constants, types and helpers the implementation compiles against.
      #|// Don't edit it: change t.tutuca.ts and run pure-tutuca again.
      #|
      #|import "'" {
      #|    #[import = "Tally"]
      #|    const gs_Tally: js_string;
      #|    #[import = "count"]
      #|    const gs_count: js_string;
      #|    #[import = "mode"]
      #|    const gs_mode: js_string;
      #|    #[import = "up"]
      #|    const gs_up: js_string;
      #|    #[import = "down"]
      #|    const gs_down: js_string;
      #|    #[import = "bump"]
      #|    const gs_bump: js_string;
      #|    #[import = "n"]
      #|    const gs_n: js_string;
      #|    #[import = "changed"]
      #|    const gs_changed: js_string;
      #|    #[import = "main"]
      #|    const gs_main: js_string;
      #|    #[import = "click"]
      #|    const gt_click: js_string;
      #|    #[import = "class"]
      #|    const gt_class: js_string;
      #|    #[import = "btn"]
      #|    const gt_btn: js_string;
      #|    #[import = "type"]
      #|    const gt_type: js_string;
      #|    #[import = "button"]
      #|    const gt_button: js_string;
      #|    #[import = "missing"]
      #|    const gt_missing: js_string;
      #|    #[import = "wrong type"]
      #|    const gt_wrong_type: js_string;
      #|    #[import = "invalid"]
      #|    const gt_invalid: js_string;
      #|}
      #|
      #|// ---- Tally ---------------------------------------------------------------------
      #|
      #|type Tally_state = { count: f64, mode: js_string };
      #|
      #|// state with count set to v.
      #|fn Tally_with_count(state: &Tally_state, v: f64) -> &Tally_state {
      #|    {Tally_state| count: v, mode: state.mode };
      #|}
      #|
      #|// state with mode set to v.
      #|fn Tally_with_mode(state: &Tally_state, v: js_string) -> &Tally_state {
      #|    {Tally_state| count: state.count, mode: v };
      #|}
      #|
      #|// notify changed: to the parent, bubbling until a handler stops it.
      #|fn Tally_notify_changed(ctx: &context, count: f64) {
      #|    let args = [value_array|null; 1];
      #|    args[0] = value_number(count);
      #|    ctx_notify(ctx, gs_changed, args);
      #|}
      #|
      #|
    ),
  )
  inspect(
    out.glue,
    content=(
      #|// Generated by pure-tutuca from t.tutuca.ts: the boilerplate: specs, schemas, vtables, message routing, registration.
      #|// Don't edit it: change t.tutuca.ts and run pure-tutuca again.
      #|
      #|// ---- Tally ---------------------------------------------------------------------
      #|
      #|fn Tally_view_main() -> &view {
      #|    let t0 = [arg_array|null; 1];
      #|    t0[0] = arg_value(value_number(1.0));
      #|    let t1 = [str_array|null; 2];
      #|    t1[0] = gt_class;
      #|    t1[1] = gt_type;
      #|    let t2 = [view_array|null; 2];
      #|    t2[0] = view_const(value_string(gt_btn));
      #|    t2[1] = view_const(value_string(gt_button));
      #|    let t3 = [view_array|null; 1];
      #|    t3[0] = view_field(gs_count);
      #|    let t4 = [view_on_array|null; 1];
      #|    t4[0] = view_on(gt_click, view_action(gs_bump, t0));
      #|    let t5 = view_el(gt_button, null, t1, t2, null, t3, t4);
      #|    t5;
      #|}
      #|
      #|let Tally_schema_made: &?component_schema = null;
      #|
      #|// Tally's schema: what the runtime checks its values and messages against.
      #|fn Tally_schema() -> &component_schema {
      #|    if !!Tally_schema_made {
      #|        return Tally_schema_made!;
      #|    }
      #|    let t0 = [constraint_array|null; 3];
      #|    t0[0] = constraint_int();
      #|    t0[1] = constraint_min(0.0, 0);
      #|    t0[2] = constraint_max(9.0, 0);
      #|    let t1 = [str_array|null; 2];
      #|    t1[0] = gs_up;
      #|    t1[1] = gs_down;
      #|    let t2 = [constraint_array|null; 0];
      #|    let t3 = [field_schema_array|null; 2];
      #|    t3[0] = field_schema_set_default(field_schema_new(gs_count, vtype_number(), t0, sync_shared), value_number(0.0));
      #|    t3[1] = field_schema_set_default(field_schema_new(gs_mode, vtype_enum(t1), t2, sync_shared), value_string(gs_up));
      #|    let t4 = [field_schema_array|null; 0];
      #|    let t5 = [constraint_array|null; 2];
      #|    t5[0] = constraint_int();
      #|    t5[1] = constraint_min(1.0, 0);
      #|    let t6 = [field_schema_array|null; 1];
      #|    t6[0] = field_schema_set_default(field_schema_new(gs_n, vtype_number(), t5, sync_shared), value_number(1.0));
      #|    let t7 = [str_array|null; 1];
      #|    t7[0] = gs_count;
      #|    let t8 = [emit_array|null; 1];
      #|    t8[0] = emit_spec_new(emit_kind_notify, gs_changed);
      #|    let t9 = [message_schema_array|null; 1];
      #|    t9[0] = message_schema_new(gs_bump, t6, null, Tally_when_bump, Tally_ensures_bump, t7, t8);
      #|    let t10 = [invariant_array|null; 0];
      #|    let t11 = [str_array|null; 0];
      #|    let schema = component_schema_new(t3, t4, t9, t10, t11);
      #|    Tally_schema_made = schema;
      #|    schema;
      #|}
      #|
      #|let Tally_spec_made: &?component_spec = null;
      #|
      #|fn Tally_spec() -> &component_spec {
      #|    if !!Tally_spec_made {
      #|        return Tally_spec_made!;
      #|    }
      #|    let t0 = [str_array|null; 1];
      #|    t0[0] = gs_main;
      #|    let t1 = [view_array|null; 1];
      #|    t1[0] = Tally_view_main();
      #|    let t2 = [loop_def_array|null; 0];
      #|    let t3 = [scope_def_array|null; 0];
      #|    let t4 = [str_array|null; 0];
      #|    let t5 = [selector_array|null; 0];
      #|    let spec = spec_new(gs_Tally, t0, t1, t2, t3, t4, t5);
      #|    spec_set_schema(spec, Tally_schema());
      #|    Tally_spec_made = spec;
      #|    spec;
      #|}
      #|
      #|// init: each field from fields when it's there and fits its schema, else its
      #|// default, with an issue saying why; a field without a default fails. A
      #|// make(name) default is made in ctx's scope, only when it's taken.
      #|fn Tally_vt_init: init_fn (fields: &value, ctx: &init_context) -> &init_result {
      #|    let issues = list_empty();
      #|    let schema = Tally_schema();
      #|    let found: &?value = null;
      #|    let problem: js_string_opt = null;
      #|    let f_count: f64 = 0.0;
      #|    found = field_value(fields, gs_count);
      #|    if !found {
      #|        issues = init_issue(issues, gs_count, gt_missing);
      #|    } else {
      #|        problem = vtype_problem((schema.fields[0]!).vtype, found!);
      #|        if !!problem {
      #|            issues = init_issue(issues, gs_count, gt_wrong_type);
      #|        } else {
      #|            problem = constraints_problem((schema.fields[0]!).constraints, found!, null);
      #|            if !!problem {
      #|                issues = init_issue(issues, gs_count, gt_invalid);
      #|            } else {
      #|                f_count = value_to_f64(found!);
      #|            }
      #|        }
      #|    }
      #|    let f_mode: js_string = gs_up;
      #|    found = field_value(fields, gs_mode);
      #|    if !found {
      #|        issues = init_issue(issues, gs_mode, gt_missing);
      #|    } else {
      #|        problem = vtype_problem((schema.fields[1]!).vtype, found!);
      #|        if !!problem {
      #|            issues = init_issue(issues, gs_mode, gt_wrong_type);
      #|        } else {
      #|            problem = constraints_problem((schema.fields[1]!).constraints, found!, null);
      #|            if !!problem {
      #|                issues = init_issue(issues, gs_mode, gt_invalid);
      #|            } else {
      #|                f_mode = value_string_of(found!)!;
      #|            }
      #|        }
      #|    }
      #|    let state = {Tally_state| count: f_count, mode: f_mode };
      #|    init_ok(state, issues);
      #|}
      #|
      #|// handle: routes a message to its handler. The runtime checked its arguments
      #|// against the message's schema before this runs, so they decode as declared.
      #|fn Tally_vt_handle: handle_fn (instance: &eq, m: &message, ctx: &context) -> &message_result {
      #|    let state = instance as &Tally_state;
      #|    if m.answer != answer_none {
      #|        return message_result_rejected(message_error_unknown_message());
      #|    }
      #|    if str_eq(m.name, gs_bump) {
      #|        return message_result_of(state, Tally_on_bump(state, ctx, value_to_f64(m.args[0]!)));
      #|    }
      #|    message_result_rejected(message_error_unknown_message());
      #|}
      #|
      #|fn Tally_vt_get: get_fn (instance: &eq, name: js_string) -> (i32, &?value) {
      #|    let state = instance as &Tally_state;
      #|    if str_eq(name, gs_count) {
      #|        return (property_ok, value_number(state.count));
      #|    }
      #|    if str_eq(name, gs_mode) {
      #|        return (property_ok, value_string(state.mode));
      #|    }
      #|    (property_no_such_property, null);
      #|}
      #|
      #|// set: a field, when the value fits its schema; a property is read only.
      #|fn Tally_vt_set: set_fn (instance: &eq, name: js_string, v: &value) -> (i32, &?eq) {
      #|    let state = instance as &Tally_state;
      #|    let schema = Tally_schema();
      #|    if str_eq(name, gs_count) {
      #|        if !!vtype_problem((schema.fields[0]!).vtype, v) {
      #|            return (property_wrong_type, null);
      #|        }
      #|        if !!constraints_problem((schema.fields[0]!).constraints, v, null) {
      #|            return (property_invalid, null);
      #|        }
      #|        return (property_ok, Tally_with_count(state, value_to_f64(v)));
      #|    }
      #|    if str_eq(name, gs_mode) {
      #|        if !!vtype_problem((schema.fields[1]!).vtype, v) {
      #|            return (property_wrong_type, null);
      #|        }
      #|        if !!constraints_problem((schema.fields[1]!).constraints, v, null) {
      #|            return (property_invalid, null);
      #|        }
      #|        return (property_ok, Tally_with_mode(state, value_string_of(v)!));
      #|    }
      #|    (property_no_such_property, null);
      #|}
      #|
      #|fn Tally_vtable() -> &vtable {
      #|    {vtable| init: Tally_vt_init, handle: Tally_vt_handle, get: Tally_vt_get, set: Tally_vt_set, query: null };
      #|}
      #|
      #|// ---- The package ------------------------------------------------------------
      #|
      #|#[export = "tutuca_abi_version"]
      #|fn tutuca_abi_version() -> i32 {
      #|    tutuca_abi_version_current;
      #|}
      #|
      #|#[export = "tutuca_register"]
      #|fn tutuca_register(s: &scope) {
      #|    scope_register(s, gs_Tally, Tally_spec(), Tally_vtable());
      #|}
      #|
      #|
    ),
  )
  debug_inspect(
    out.required.map(r => r.signature()),
    content=(
      #|["fn Tally_on_bump(state: &Tally_state, ctx: &context, n: f64) -> &Tally_state"]
    ),
  )
}

///|
/// A name an implementation reads as gs_<name> keeps it whatever a view says
/// first that reads the same: a "Notes" label before the field notes.
test "the package's names claim their gs_ constants before view text" {
  let (pkg, diags) = pkg_of(
    (
      #|import { div, field, span } from "tutuca/view";
      #|export type Shelf = { notes: string[] };
      #|export const Shelf = {
      #|  defaults: { notes: [] },
      #|  on: { addNote: { changes: ["notes"], run(next) { next.notes.push(""); } } },
      #|  view: div({}, span({}, "Notes"), span({}, "Add note"), field("notes")),
      #|};
    ),
  )
  debug_inspect(diags.length(), content="0")
  let contract = @gen.generate(pkg, "t.tutuca.ts").contract
  let consts = contract
    .split("\n")
    .filter(l => l.contains("#[import = ") || l.contains("const g"))
    .map(l => l.trim().to_owned())
    .collect()
  debug_inspect(
    consts.filter(l => l.contains("ote")),
    content=(
      #|[
      #|  "#[import = \"notes\"]",
      #|  "const gs_notes: js_string;",
      #|  "#[import = \"addNote\"]",
      #|  "const gs_addNote: js_string;",
      #|  "#[import = \"Notes\"]",
      #|  "const gt_notes: js_string;",
      #|  "#[import = \"Add note\"]",
      #|  "const gt_add_note: js_string;",
      #|]
    ),
  )
}

///|
/// The init hook gets the init context, to make components with.
test "the init hook takes the init context" {
  let (pkg, diags) = pkg_of(
    (
      #|import { p } from "tutuca/view";
      #|export type Leaf = {};
      #|export const Leaf = { view: p({}, "x") };
      #|export type Holder = { child: Leaf | null };
      #|export const Holder = {
      #|  defaults: { child: null },
      #|  init(next, ctx) { next.child = ctx.make("Leaf"); },
      #|  view: p({}, "x"),
      #|};
    ),
  )
  debug_inspect(diags.length(), content="0")
  let glue = @gen.generate(pkg, "t.tutuca.ts").glue
  let lines = glue
    .split("\n")
    .filter(l => {
      l.contains("ctx") && !l.contains("//") && !l.contains("&context")
    })
    .map(l => l.trim().to_owned())
    .collect()
  debug_inspect(
    lines,
    content=(
      #|[
      #|  "fn Leaf_vt_init: init_fn (fields: &value, ctx: &init_context) -> &init_result {",
      #|  "fn Holder_vt_init: init_fn (fields: &value, ctx: &init_context) -> &init_result {",
      #|  "init_ok(Holder_init(state, ctx), issues);",
      #|]
    ),
  )
}

///|
test "a swap handler swaps in a component or keeps its own, with changes checked when it keeps" {
  let (pkg, diags) = pkg_of(
    (
      #|import { field, p } from "tutuca/view";
      #|export type Other = {};
      #|export const Other = { view: p({}, "x") };
      #|export type Slot = { note: string };
      #|export const Slot = {
      #|  defaults: { note: "" },
      #|  on: {
      #|    become: {
      #|      swap: true,
      #|      changes: ["note"],
      #|      run(next, [], ctx) { return ctx.make("Other"); },
      #|    },
      #|  },
      #|  view: p({}, field("note")),
      #|};
    ),
  )
  debug_inspect(diags.length(), content="0")
  let out = @gen.generate(pkg, "t.tutuca.ts")
  let pick = (text : String, keep : (String) -> Bool) => {
    text
    .split("\n")
    .filter(l => keep(l.to_owned()))
    .map(l => l.trim().to_owned())
    .collect()
  }
  debug_inspect(
    pick(out.contract, l => l.contains("swap") || l.contains("slot_keep")),
    content=(
      #|[
      #|  "// What a swap handler gives: a component to swap in (Slot_swap_to), or the",
      #|  "type Slot_swap_result = { component: &?component, state: &?Slot_state };",
      #|  "// swap this component for c.",
      #|  "fn Slot_swap_to(c: &component) -> &Slot_swap_result {",
      #|  "{Slot_swap_result| component: c, state: null };",
      #|  "fn Slot_keep(state: &Slot_state) -> &Slot_swap_result {",
      #|  "{Slot_swap_result| component: null, state };",
      #|]
    ),
  )
  debug_inspect(
    pick(out.glue, l => {
      !l.contains("//") && (l.contains("r.") || l.contains("slot_on_become"))
    }),
    content=(
      #|[
      #|  "if !!r.component {",
      #|  "return message_result_swapped(r.component!);",
      #|  "return message_result_of(state, r.state!);",
      #|]
    ),
  )
}

///|
/// gs_empty is the empty text whatever comes first: text of only symbols
/// is gt_text, and the next gt_text_2.
test "only the empty text is gs_empty" {
  let (pkg, diags) = pkg_of(
    (
      #|import { button, div, field } from "tutuca/view";
      #|export type C = { note: string };
      #|export const C = {
      #|  defaults: { note: "" },
      #|  view: div({}, button({}, "+"), button({}, "×"), field("note")),
      #|};
    ),
  )
  debug_inspect(diags.length(), content="0")
  let contract = @gen.generate(pkg, "t.tutuca.ts").contract
  let lines = contract.split("\n").map(l => l.trim().to_owned()).collect()
  let consts = []
  for i, l in lines {
    if l.has_prefix("const g") && i > 0 && lines[i - 1].contains("#[import") {
      consts.push(lines[i - 1] + " " + l)
    }
  }
  debug_inspect(
    consts.filter(l => l.contains("gs_empty") || l.contains("gt_text")),
    content=(
      #|[
      #|  "#[import = \"+\"] const gt_text: js_string;",
      #|  "#[import = \"×\"] const gt_text_2: js_string;",
      #|  "#[import = \"\"] const gs_empty: js_string;",
      #|]
    ),
  )
}

///|
/// The names inside types and arguments are gs_, view text gt_: a "?", an
/// "Open" and a "To!" never take the record field text's gs_text, the enum
/// member open's gs_open or the argument to's gs_to.
test "names inside types and arguments claim their gs_ first" {
  let (pkg, diags) = pkg_of(
    (
      #|import { button, div, send, span } from "tutuca/view";
      #|export type C = { items: { text: string }[]; show: "all" | "open" };
      #|export const C = {
      #|  defaults: { items: [], show: "all" },
      #|  on: { go: { changes: [], run(next, [to]: [string]) {} } },
      #|  view: div({}, button({ "on:click": send("go", "x") }, "?"), span({}, "Open"), span({}, "To!")),
      #|};
    ),
  )
  debug_inspect(diags.length(), content="0")
  let contract = @gen.generate(pkg, "t.tutuca.ts").contract
  let lines = contract.split("\n").map(l => l.trim().to_owned()).collect()
  let consts = []
  for i, l in lines {
    if l.has_prefix("const g") && i > 0 && lines[i - 1].contains("#[import") {
      consts.push(lines[i - 1] + " " + l)
    }
  }
  debug_inspect(
    consts.filter(l => {
      l.contains("_text") ||
      l.contains("_open") ||
      l.contains(" gs_to") ||
      l.contains("gt_to")
    }),
    content=(
      #|[
      #|  "#[import = \"text\"] const gs_text: js_string;",
      #|  "#[import = \"open\"] const gs_open: js_string;",
      #|  "#[import = \"to\"] const gs_to: js_string;",
      #|  "#[import = \"?\"] const gt_text: js_string;",
      #|  "#[import = \"Open\"] const gt_open: js_string;",
      #|  "#[import = \"To!\"] const gt_to: js_string;",
      #|]
    ),
  )
}

///|
/// A type's gs_ keeps its case: a field editor and a type Editor are
/// gs_editor and gs_Editor.
test "a field keeps its gs_ over a type of the same name" {
  let (pkg, diags) = pkg_of(
    (
      #|import { div, field, renderEach } from "tutuca/view";
      #|export type Editor = { n: number };
      #|export const Editor = {
      #|  defaults: { n: 0 },
      #|  constraints: { n: { int: true } },
      #|  view: div({}, field("n")),
      #|};
      #|export type Studio = { editor: Editor[] };
      #|export const Studio = {
      #|  defaults: { editor: [] },
      #|  view: div({}, renderEach(field("editor"))),
      #|};
    ),
  )
  debug_inspect(diags.length(), content="0")
  let contract = @gen.generate(pkg, "t.tutuca.ts").contract
  let lines = contract.split("\n").map(l => l.trim().to_owned()).collect()
  let consts = []
  for i, l in lines {
    if l.has_prefix("const gs_") &&
      l.contains("ditor") &&
      i > 0 &&
      lines[i - 1].contains("#[import") {
      consts.push(lines[i - 1] + " " + l)
    }
  }
  debug_inspect(
    consts,
    content=(
      #|[
      #|  "#[import = \"Editor\"] const gs_Editor: js_string;",
      #|  "#[import = \"editor\"] const gs_editor: js_string;",
      #|]
    ),
  )
}

///|
/// A view's name reaches the runtime as written, wherever it's named: so a
/// push_view of a name a property holds finds it as a literal one does.
test "view names are kept as written" {
  let (pkg, diags) = pkg_of(
    (
      #|import { div, field, p, pushView, render } from "tutuca/view";
      #|export type Row = { mode: string };
      #|export const Row = {
      #|  defaults: { mode: "" },
      #|  view: p({}, "x"),
      #|  views: { compactRow: p({}, "y") },
      #|};
      #|export type Board = { mode: string; child: Row | null };
      #|export const Board = {
      #|  defaults: { mode: "", child: null },
      #|  view: div(
      #|    {},
      #|    pushView("compactRow", render(field("child"))),
      #|    pushView(field("mode"), render(field("child"), "compactRow")),
      #|  ),
      #|};
    ),
  )
  debug_inspect(diags.length(), content="0")
  let out = @gen.generate(pkg, "t.tutuca.ts")
  let pick = (text : String, keep : (String) -> Bool) => {
    text
    .split("\n")
    .filter(l => keep(l.to_owned()))
    .map(l => l.trim().to_owned())
    .collect()
  }
  debug_inspect(
    pick(out.contract, l => l.contains("compact") || l.contains("Compact")),
    content=(
      #|["#[import = \"compactRow\"]", "const gs_compactRow: js_string;"]
    ),
  )
  debug_inspect(
    pick(out.glue, l => l.contains("compact") || l.contains("Compact")),
    content=(
      #|[
      #|  "fn Row_view_compactRow() -> &view {",
      #|  "t0[1] = gs_compactRow;",
      #|  "t1[1] = Row_view_compactRow();",
      #|  "let t3 = view_push_view(view_const(value_string(gs_compactRow)), t2);",
      #|  "let t4 = view_render(view_field(gs_child), gs_compactRow);",
      #|]
    ),
  )
}

///|
/// A name that's a Wax keyword is escaped where it stands alone (a
/// parameter: type_), not inside a longer name (c_ask_open).
test "a keyword is escaped only where it stands alone" {
  let (pkg, diags) = pkg_of(
    (
      #|import { div } from "tutuca/view";
      #|export interface CAsks { open(type: string): boolean; }
      #|export type C = {};
      #|export const C = { view: div({}) };
    ),
  )
  debug_inspect(diags.length(), content="0")
  let contract = @gen.generate(pkg, "t.tutuca.ts").contract
  debug_inspect(
    contract
    .split("\n")
    .filter(l => l.has_prefix("fn c_ask_"))
    .map(l => l.to_owned())
    .collect(),
    content=(
      #|[]
    ),
  )
}

///|
/// An enum is its member's name, a js_string, at any depth: no index
/// helpers, a record inside a list reads and makes it as a string.
test "an enum inside a list of records is held as its name" {
  let (pkg, diags) = pkg_of(
    (
      #|import { div } from "tutuca/view";
      #|export type C = { cards: { id: number; tag: "feature" | "bug" }[] };
      #|export const C = { defaults: { cards: [] }, view: div({}, "cards") };
    ),
  )
  debug_inspect(diags.length(), content="0")
  let out = @gen.generate(pkg, "t.tutuca.ts")
  let indexes = out.contract.contains("pt_enum") || out.glue.contains("pt_enum")
  let strings = out.contract.contains("tag_: js_string")
  debug_inspect(
    (indexes, strings),
    content=(
      #|(false, true)
    ),
  )
}
