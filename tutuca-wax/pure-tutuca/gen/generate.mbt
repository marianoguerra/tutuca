// Generating a package: the contract and glue files, and what the
// implementation (the lowered module) must define.

///|
pub(all) struct Output {
  /// <pkg>.contract.wax: string constants, types and helpers.
  contract : String
  /// <pkg>.glue.wax: specs, schemas, vtables, registration.
  glue : String
  required : Array[Required]
}

///|
/// The generated files of pkg; source names the module, for their headers.
pub fn generate(
  pkg : @check.Package,
  source : String,
  have? : Array[String],
) -> Output {
  let g = Gen::new(pkg, have?)
  let glue = g.glue()
  let contract = g.contract()
  let header = (what : String) => {
    "// Generated by pure-tutuca from \{source}: \{what}.\n// Don't edit it: change \{source} and run pure-tutuca again.\n"
  }
  {
    contract: header(
      "the string constants, types and helpers the implementation compiles against",
    ) +
    "\n" +
    g.strings.imports() +
    "\n" +
    contract,
    glue: header(
      "the boilerplate: specs, schemas, vtables, message routing, registration",
    ) +
    "\n" +
    glue,
    required: required(pkg),
  }
}
