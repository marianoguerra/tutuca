///|
/// The model of a pure-tutuca module, checked, built and validated.
fn pkg_of(path : String, src : String) -> @check.Package {
  let checked = match @pure.check_source(path, src) {
    Ok(c) => c
    Err(ds) => abort(ds.map(d => d.message).join("; "))
  }
  let (pkg, diags) = @pure.build(path, src, checked)
  diags.append(@check.validate(pkg))
  if @diag.has_errors(diags) {
    abort(diags.map(d => d.message).join("; "))
  }
  pkg
}

///|
let tally_src : String =
  #|import { field, p } from "tutuca/view";
  #|export type Tally = { count: number; readonly double: number };
  #|export const Tally = {
  #|  defaults: { count: 0 },
  #|  constraints: { count: { int: true, min: 0 } },
  #|  queries: { get double(): number { return this.count * 2; } },
  #|  on: {
  #|    add: {
  #|      changes: ["count"],
  #|      post(prev, next, [n]: [number]) { return next.count === prev.count + n; },
  #|      run(next, [n]: [number]) { next.count += n; },
  #|    },
  #|    reset: { changes: ["count"], run(next) { next.count = 0; } },
  #|  },
  #|  view: p({}, field("count")),
  #|};

///|
fn convention(impl_src : String) -> Array[String] {
  let pkg = pkg_of("t.tutuca.ts", tally_src)
  let out = @gen.generate(pkg, "t.tutuca.ts")
  let impl_ast = @wax.parse_string(impl_src, fname="impl.wax").module_.unwrap_or([],
  )
  let glue = @wax.parse_string(out.glue, fname="glue.wax").module_.unwrap_or([])
  let contract = @wax.parse_string(out.contract, fname="contract.wax").module_.unwrap_or([],
  )
  @compose.check_convention(pkg, out.required, [impl_ast], [contract, glue]).map(d => {
      "\{d.code}: \{d.message}"
    },
  )
}

///|
test "an implementation that follows the convention" {
  debug_inspect(
    convention(
      (
        #|fn Tally_on_add(state: &Tally_state, ctx: &context, n: f64) -> &Tally_state { state; }
        #|fn Tally_on_reset(state: &Tally_state, ctx: &context) -> &Tally_state { state; }
        #|fn Tally_get_double(state: &Tally_state) -> f64 { state.count * 2.0; }
      ),
    ),
    content="[]",
  )
}

///|
test "missing, wrong, undeclared and generated functions" {
  debug_inspect(
    convention(
      (
        #|fn Tally_on_add(state: &Tally_state, ctx: &context, n: i32) -> &Tally_state { state; }
        #|fn Tally_get_double(state: &Tally_state) -> &extern { unreachable; }
        #|fn Tally_on_rest(state: &Tally_state, ctx: &context) -> &Tally_state { state; }
        #|fn Tally_with_count(state: &Tally_state, v: f64) -> &Tally_state { state; }
      ),
    ),
    content=(
      #|[
      #|  "pure-tutuca.impl.signature: parameter 3 of Tally_on_add (n) must be f64: the convention calls it as fn Tally_on_add(state: &Tally_state, ctx: &context, n: f64) -> &Tally_state",
      #|  "pure-tutuca.impl.missing: the implementation has no Tally_on_reset, which handles the message reset",
      #|  "pure-tutuca.impl.signature: Tally_get_double must return f64: the convention calls it as fn Tally_get_double(state: &Tally_state) -> f64",
      #|  "pure-tutuca.impl.undeclared: Tally_on_rest looks like a handler for rest, which Tally doesn't declare; did you mean reset?",
      #|  "pure-tutuca.impl.generated: Tally_with_count is generated by pure-tutuca; the implementation can't define it too",
      #|]
    ),
  )
}

///|
/// The convention spells a string `js_string`, the prelude's alias of
/// `&extern`: an implementation may write either.
fn note_convention(impl_src : String) -> Array[String] {
  let pkg = pkg_of(
    "n.tutuca.ts",
    (
      #|import { field, p } from "tutuca/view";
      #|export type Note = { text: string };
      #|export const Note = {
      #|  defaults: { text: "" },
      #|  on: { set: { changes: ["text"], run(next, [text]: [string]) { next.text = text; } } },
      #|  view: p({}, field("text")),
      #|};
    ),
  )
  let out = @gen.generate(pkg, "n.tutuca.ts")
  let parse = (src : String, name : String) => {
    @wax.parse_string(src, fname=name).module_.unwrap_or([])
  }
  let prelude = parse(
    "type js_string = &extern;\ntype js_string_opt = &?extern;\n", "js_string.wax",
  )
  @compose.check_convention(
    pkg,
    out.required,
    [parse(impl_src, "impl.wax")],
    [parse(out.contract, "contract.wax"), parse(out.glue, "glue.wax")],
    prelude=[prelude],
  ).map(d => "\{d.code}: \{d.message}")
}

///|
test "a string parameter, as the alias or as the type it stands for" {
  debug_inspect(
    note_convention(
      "fn Note_on_set(state: &Note_state, ctx: &context, text: js_string) -> &Note_state { state; }",
    ),
    content="[]",
  )
  debug_inspect(
    note_convention(
      "fn Note_on_set(state: &Note_state, ctx: &context, text: &extern) -> &Note_state { state; }",
    ),
    content="[]",
  )
  debug_inspect(
    note_convention(
      "fn Note_on_set(state: &Note_state, ctx: &context, text: &?extern) -> &Note_state { state; }",
    ),
    content=(
      #|["pure-tutuca.impl.signature: parameter 3 of Note_on_set (text) must be js_string: the convention calls it as fn Note_on_set(state: &Note_state, ctx: &context, text: js_string) -> &Note_state"]
    ),
  )
}
