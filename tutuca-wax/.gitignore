# What `npm install` / `just setup` brings: jsdom, Playwright, binaryen.
/node_modules/
# The pinned wax-mb, cloned and built by scripts/setup-wax-mb.sh.
/.tools/
# Build outputs (scripts/build.mjs): the assembled .wax, the generated prelude
# files, <module>.debug.wasm and the optimized <module>.wasm, `just wat`'s .wat.
/dist/
# tcd's build (moon) and fetched dependencies.
/tcd/_build/
/tcd/.mooncakes/
# API keys for the studio's assistant (scripts/studio-server.mjs; see .env.example).
/.env
