// The micro-agents' kit: what every agent's root is to the shell
// (MicroAgent), and the components agents share. The shell loads it into
// the root scope, so an agent that uses it finds them there.
package tutuca:microagent@0.1.0;

/// What the shell needs of an agent's root: made from the JSON it opens
/// (its fields), it says what it holds for the model (summary), what
/// get_state answers (domain), and the JSON it exports (data).
interface MicroAgent {
    /// A short text, with ids, that the system prompt includes.
    get summary: string;
    /// The state as plain JSON, for get_state.
    get domain: any;
    /// The JSON the agent's data exports as: what it opened, changed.
    get data: any;
}

/// A section's title in an agent's workspace.
component SectionTitle {
    field text: string;
    view main = h3(class: "text-xs font-semibold uppercase tracking-wide opacity-60", field(text));
}
