// vega-lite-lab: one Vega-Lite spec drawn from tables bound by name. A table
// is { id, rows } (an array of row objects) or { id, csv, delimiter? } (CSV
// text). The spec reads one with {"data": {"name": "<table id>"}}; the chart
// gets each named table's rows inlined as data.values. Vega-Lite compiles in
// the page (host functions vega_*, microagents/engines/vega.js), and the
// page's <ma-vega> element draws the chart. The root's messages are the
// agent's tools; the editor and the table list send the same messages.
package tutuca:vega_lite_lab@0.1.0;

use "../../kit/kit.tcd".{ MicroAgent };

component VegaLiteLab: MicroAgent {
    /// The Vega-Lite spec, a JSON object; it reads a table with {"data": {"name": "<table id>"}}.
    field spec: map<any> where len(spec) >= 1;
    /// The tables the spec reads, by id: rows (an array of objects) or CSV text with a header row (delimiter "," unless it says).
    field tables: list<one_of<record { id: string, rows: list<map<any>> }, record { id: string, csv: string }, record { id: string, csv: string, delimiter: string }>>;
    /// The spec as the user edits it; "" until it's edited.
    field spec_text: string;
    /// Why spec_text isn't a spec; "" when it is (and spec is its value).
    field spec_error: string;
    /// Why the last set_spec, patch_spec or remove_spec_key changed nothing; "" when it worked.
    field edit_error: string;
    /// The table the preview shows; "" for the first.
    field focus: string;

    get summary: string;
    get domain: any;
    get data: any;
    get headline: string;
    /// Whether the spec compiles: errors, warnings, the tables and the Vega marks it makes.
    get compile_report: any;
    /// What a spec edit answers with: compile_report, or { error } when the edit changed nothing.
    get edit_report: any;
    /// Every table's columns with type, min, max, distinct and null counts, and 3 sample rows.
    get describe_tables: any;
    get error_list: list<record { text: string }>;
    get warning_list: list<record { text: string }>;
    get can_render: bool;
    /// The spec as the chart draws it, as JSON text: each named table's rows inlined as data.values.
    get chart_spec: string;
    /// The spec as JSON text, as the editor shows it.
    get editor_text: string;
    get table_rows: list<record { id: string, label: string, on: bool }>;
    get has_tables: bool;
    get preview_title: string;
    get preview_columns: list<record { name: string, type: string }>;
    get preview_rows: list<record { cells: list<record { text: string }> }>;

    /// Replace the whole Vega-Lite spec (a JSON object). Tables are read with {"data": {"name": id}}.
    pure message set_spec(spec: map<any> where len(spec) >= 1) changes spec, spec_text, spec_error, edit_error;
    /// The spec's text, from its editor: kept while it isn't a JSON object.
    pure message set_spec_text(text: string) changes spec, spec_text, spec_error, edit_error;
    /// Set one value in the spec at a JSON pointer such as /encoding/x/field (/- appends to an array). The value is JSON as itself (an object, not its JSON text). The parent must exist: with no /encoding/color, set it to {"field": "region", "type": "nominal"}, not /encoding/color/field.
    pure message patch_spec(pointer: string where pointer matches "^/", value: any) changes spec, spec_text, spec_error, edit_error;
    /// Remove the value at a JSON pointer from the spec.
    pure message remove_spec_key(pointer: string where pointer matches "^/") changes spec, spec_text, spec_error, edit_error;
    /// Replace a table's rows, or add a table with this id; rows is an array of objects. A CSV table stays CSV.
    pure message set_table(id: string where id matches "^[A-Za-z0-9_-]+$", rows: list<map<any>>) changes tables;
    /// Remove a table.
    pure message remove_table(id: string where check(table_id)) changes tables, focus
        ensures len(next.tables) == len(tables) - 1;
    /// Move a table to a position (0 is first).
    pure message reorder_tables(id: string where check(table_id), index: s32 where index >= 0) changes tables
        ensures len(next.tables) == len(tables);
    /// Which table the preview shows.
    pure message focus(id: string) changes focus ensures next.focus == id;

    view main = div(class: "flex flex-col gap-4",
        header(class: "flex items-baseline justify-between gap-2",
            h2(class: "text-lg font-bold", "Vega-Lite lab"),
            span(class: "text-sm opacity-70", field(headline))),
        if(field(can_render),
            el("ma-vega", class: "block min-h-64 w-full", spec: field(chart_spec)),
            p(class: "text-sm opacity-60", "The chart shows once the spec compiles.")),
        ul(class: "flex flex-col gap-1 text-sm text-error",
            each(field(error_list), li(field(text)))),
        ul(class: "flex flex-col gap-1 text-sm text-warning",
            each(field(warning_list), li(field(text)))),
        h3(class: "text-xs font-semibold uppercase tracking-wide opacity-60", "Spec"),
        textarea(class: "textarea textarea-bordered w-full font-mono text-xs", rows: "16", "aria-label": "Spec JSON",
            value: field(editor_text), on_input: send(set_spec_text, target_value())),
        if(field(spec_error) != "", p(class: "text-xs text-error", field(spec_error))),
        h3(class: "text-xs font-semibold uppercase tracking-wide opacity-60", "Tables"),
        if(field(has_tables),
            div(class: "flex flex-col gap-1",
                each(field(table_rows),
                    div(class: "join w-full",
                        button(class: if(field(on), "btn btn-sm btn-active join-item flex-1 justify-start font-mono", "btn btn-sm join-item flex-1 justify-start font-mono"),
                            title: "Preview this table", on_click: send(focus, field(id)), field(label)),
                        button(class: "btn btn-sm join-item", title: "Remove", "aria-label": "Remove",
                            on_click: send(remove_table, field(id)), "✕")))),
            p(class: "text-sm opacity-60", "No tables yet: the model adds them with set_table.")),
        if(field(has_tables),
            div(class: "flex flex-col gap-1",
                p(class: "text-xs opacity-60", field(preview_title)),
                div(class: "overflow-x-auto rounded-box border border-base-300",
                    table(class: "table table-xs",
                        thead(tr(each(field(preview_columns), th(class: "font-mono", field(name), span(class: "opacity-50", " ", field(type)))))),
                        tbody(each(field(preview_rows), tr(each(field(cells), td(field(text)))))))))));
}
