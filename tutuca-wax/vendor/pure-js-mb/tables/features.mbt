///|
/// Why pure-js leaves out a by-design feature.
pub fn Feature::why(self : Feature) -> String? {
  match self {
    ModuleStatement =>
      Some(
        "a module only declares: running it does nothing but make its constants",
      )
    ModuleLet => Some("what a module declares is constant")
    DefaultExport => Some("an export is a declaration")
    NamespaceImport => Some("an import names what it takes")
    RecursiveCall =>
      Some(
        "a program must terminate: the calls between a module's functions can't form a cycle",
      )
    VarDeclaration => Some("var is function-scoped and hoisted")
    LoopStatement =>
      Some(
        "a program must terminate: it can only iterate through the methods of lists",
      )
    ForInStatement => Some("it walks inherited properties")
    ThrowStatement =>
      Some("errors are not values in pure-js; only hosts abort a run")
    LabeledStatement => Some("there are no loops to break out of")
    EmptyStatement => Some("a lone semicolon does nothing")
    FunctionDeclaration =>
      Some("a program is one function; a callback is an arrow passed to a call")
    ClassDeclaration => Some("values are plain data")
    WithStatement => Some("it changes what names mean at run time")
    DebuggerStatement => Some("it reaches outside the program")
    ModuleSyntax => Some("a program can only use what its host provides")
    UselessExpression => Some("they compute a value and drop it")
    LineBreakAfterReturn => Some("JavaScript would return undefined there")
    MissingSemicolon =>
      Some(
        "semicolons are required, so no statement depends on where lines break",
      )
    LooseEquality => Some("they convert their operands")
    Exponent => Some("its result is implementation-approximated")
    InOperator => Some("it sees inherited properties")
    Instanceof => Some("values have no classes")
    UnaryPlus => Some("it converts its operand")
    Void => Some("it computes a value and drops it")
    Delete => Some("a field is set, not removed")
    Sequence => Some("it drops values")
    AssignmentExpression => Some("an assignment is a statement")
    Reassignment => Some("a name is bound once")
    ArrowNotCallback =>
      Some(
        "functions are not values, so nothing can recurse or be called after the program ends",
      )
    FunctionExpression => Some("a callback is an arrow passed to a call")
    ArrayHole => Some("arrays are dense")
    ObjectMethod => Some("records are data")
    New => Some("values are plain data, made by literals and host functions")
    Class => Some("values are plain data")
    TaggedTemplate => Some("a tag is a function value")
    Regex => Some("matching is left to hosts")
    Bigint => Some("numbers are doubles")
    LegacyOctal => Some("strict mode has none")
    Async => Some("a run is one synchronous call")
    Generator => Some("a run is one synchronous call")
    Super => Some("values have no classes")
    PrivateName => Some("values have no classes")
    Decorator => Some("they are function values")
    DynamicImport => Some("a program can only use what its host provides")
    MetaProperty => Some("they reach outside the program")
    IdentifierEscape => Some("a name is spelled one way")
    DollarName => Some("they are the compiler's")
    ReservedName => Some("no value has them in pure-js")
    AnyType => Some("it turns checking off")
    TypeAssertion => Some("they turn checking off")
    _ => None
  }
}

///|
/// The profile that will admit an omitted feature.
pub fn Feature::profile(self : Feature) -> String? {
  match self {
    ModuleProgram => Some("module")
    ImportDeclaration => Some("module")
    ExportDeclaration => Some("module")
    HelperFunction => Some("module")
    TypeAlias => Some("module")
    InterfaceDeclaration => Some("module")
    NamespaceMethod => Some("module")
    ThisParameter => Some("module")
    LetDeclaration => Some("let")
    LetAssignment => Some("let")
    MultipleDeclarators => Some("destructuring")
    DestructuringDeclaration => Some("destructuring")
    ForOfStatement => Some("forOf")
    LoopControl => Some("forOf")
    TryStatement => Some("tryCatch")
    BlockArrow => Some("module")
    ObjectPattern => Some("destructuring")
    DefaultValue => Some("destructuring")
    RestElement => Some("destructuring")
    NestedPattern => Some("destructuring")
    ReadonlyType => Some("module")
    MethodType => Some("module")
    _ => None
  }
}

