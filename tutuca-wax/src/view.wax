// Views as data: the constructors of prelude/view.wax's types, one per form
// of the spec's view/view.rkt.

fn view_const(value: &value) -> &view {
    let out: &view_const = { kind: view_kind_const, value };
    out;
}

fn view_field(name: js_string) -> &view {
    let out: &view_field = { kind: view_kind_field, name };
    out;
}

fn view_seq_item(seq_name: js_string, key_name: js_string) -> &view {
    let out: &view_seq_item = { kind: view_kind_seq_item, seq_name, key_name };
    out;
}

fn view_provided(name: js_string) -> &view {
    let out: &view_provided = { kind: view_kind_provided, name };
    out;
}

fn view_lookup_bind(name: js_string) -> &view {
    let out: &view_lookup_bind = { kind: view_kind_lookup_bind, name };
    out;
}

fn view_eq(left: &view, value: &value, negate: i32) -> &view {
    let out: &view_eq = { kind: view_kind_eq, left, value, negate };
    out;
}

fn view_if(test: &view, then: &view, otherwise: &view) -> &view {
    let out: &view_if = { kind: view_kind_if, test, then, otherwise };
    out;
}

fn view_el(
    tag_name: js_string,
    ns: js_string_opt,
    attr_names: &str_array,
    attr_values: &view_array,
    key: &?view,
    childs: &view_array,
    handlers: &view_on_array,
) -> &view {
    let out: &view_el =
        {
            kind: view_kind_el,
            tag_name,
            ns,
            attr_names,
            attr_values,
            key,
            childs,
            handlers,
            template: null,
        };
    out;
}

fn view_frag(childs: &view_array) -> &view {
    let out: &view_frag = { kind: view_kind_frag, childs };
    out;
}

fn view_render(source: &view, view_name: js_string_opt) -> &view {
    let out: &view_render = { kind: view_kind_render, source, view_name };
    out;
}

fn view_each(source: &view, body: &view, loop_name: js_string_opt) -> &view {
    let out: &view_each = { kind: view_kind_each, source, body, loop_name };
    out;
}

fn view_render_each(source: &view, loop_name: js_string_opt) -> &view {
    let out: &view_render_each = { kind: view_kind_render_each, source, loop_name };
    out;
}

fn view_render_it(view_name: js_string_opt) -> &view {
    let out: &view_render_it = { kind: view_kind_render_it, view_name };
    out;
}

fn view_scope(scope_name: js_string, body: &view) -> &view {
    let out: &view_scope = { kind: view_kind_scope, scope_name, body };
    out;
}

fn view_push_view(view_name: &view, body: &view) -> &view {
    let out: &view_push_view = { kind: view_kind_push_view, view_name, body };
    out;
}

// send(name, ...args), for on:<event>.
fn view_action(name: js_string, args: &arg_array) -> &action {
    {action| name, args };
}

fn view_on(event: js_string, action: &action) -> &view_on {
    {view_on| event, action };
}
