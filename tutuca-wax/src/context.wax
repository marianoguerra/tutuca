// What a handler does through its context (MessageContext in tutuca's
// src/tasks.js): records effects, which the host turns into tasks once the
// handler returns; reads the world through the host, so a run can be
// repeated; and makes components in the handling component's scope.

fn ctx_notify(ctx: &context, name: js_string, args: &value_array) {
    let e: &effect_notify = { kind: effect_kind_notify, name, args };
    effect_buf_push(ctx.effects, e);
}

// The id the next ask gets.
let next_request: i32 = 1;

// Asks the scope's ask handler, once the transaction commits; the request's id,
// which the answer's handler reads as ctx.request.
fn ctx_ask(ctx: &context, name: js_string, args: &value_array) -> i32 {
    let request = next_request;
    next_request = request + 1;
    let e: &effect_ask = { kind: effect_kind_ask, name, args, request };
    effect_buf_push(ctx.effects, e);
    request;
}

fn ctx_send_at(ctx: &context, name: js_string, args: &value_array, selector: &selector) {
    let e: &effect_send_at = { kind: effect_kind_send_at, name, args, selector };
    effect_buf_push(ctx.effects, e);
}

fn ctx_forward_at(ctx: &context, selector: &selector) {
    let e: &effect_forward_at = { kind: effect_kind_forward_at, selector };
    effect_buf_push(ctx.effects, e);
}

fn ctx_stop_next(ctx: &context) {
    effect_buf_push(ctx.effects, EFFECT_STOP_NEXT);
}

fn ctx_log(ctx: &context, v: &value) {
    let e: &effect_log = { kind: effect_kind_log, value: v };
    effect_buf_push(ctx.effects, e);
}

// The world, as the host's env gives it. Handlers use these instead of a
// clock or a random source of their own.
fn ctx_now(ctx: &context) -> f64 {
    env_now();
}

fn ctx_random(ctx: &context) -> f64 {
    env_random();
}

fn ctx_uuid(ctx: &context) -> js_string {
    env_uuid();
}

// A component of a type registered in the handling component's scope, e.g.
// the one a handler returns in Swapped.
fn ctx_make(ctx: &context, name: js_string, fields: &value) -> &component {
    scope_make_or_fail(ctx.scope, name, fields);
}

// ctx_make's result instead of its failure: Ok(the component), or Err({
// error, issues }) saying why it can't be made (scope_try_make), for a
// handler to show instead of failing its task.
fn ctx_try_make(ctx: &context, name: js_string, fields: &value) -> &value {
    scope_try_make(ctx.scope, name, fields);
}

// The names of the types a handler can make: those registered in the
// handling component's scope, and with walk in its parents too (scope_names).
// An ask handler gets the asker's context, so these are the asker's.
fn ctx_component_names(ctx: &context, walk: i32) -> &value {
    scope_names(ctx.scope, walk);
}

// A component of a type registered in the scope the component init is making
// is being made in, e.g. the default of a field that holds a component.
fn init_ctx_make(ctx: &init_context, name: js_string, fields: &value) -> &component {
    scope_make_or_fail(ctx.scope, name, fields);
}
