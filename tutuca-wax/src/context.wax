// What a handler does through its context (MessageContext in tutuca's
// src/core/tree-binding.js): records effects, which the host turns into tasks once the
// handler returns; reads the world through the host, so a run can be
// repeated; and makes components in the handling component's scope.

fn ctx_notify(ctx: &context, name: js_string, args: &value_array) {
    let e: &effect_notify = { kind: effect_kind_notify, name, args };
    effect_buf_push(ctx.effects, e);
}

// The id the next ask or watch made from ctx gets: the host's count, so
// runs repeat.
fn ctx_next_id(ctx: &context) -> i32 {
    ctx.ids.n = ctx.ids.n + 1;
    ctx.ids.n;
}

// Asks the scope's ask handler, once the transaction commits; the request's id,
// which the answer's handler reads as ctx.request.
fn ctx_ask(ctx: &context, name: js_string, args: &value_array) -> i32 {
    let request = ctx_next_id(ctx);
    let e: &effect_ask = { kind: effect_kind_ask, name, args, request, detached: 0 };
    effect_buf_push(ctx.effects, e);
    request;
}

// ctx_ask, with the ask and its answer in no watch: nothing waits for them.
fn ctx_ask_detached(ctx: &context, name: js_string, args: &value_array) -> i32 {
    let request = ctx_next_id(ctx);
    let e: &effect_ask = { kind: effect_kind_ask, name, args, request, detached: 1 };
    effect_buf_push(ctx.effects, e);
    request;
}

fn ctx_send_at(ctx: &context, name: js_string, args: &value_array, selector: &selector) {
    let none = [value_array|null; 0];
    let e: &effect_send_at =
        {
            kind: effect_kind_send_at,
            name,
            args,
            selector,
            watch_id: 0,
            settled: null,
            settled_args: none,
            progress: null,
            progress_args: none,
            timeout: -1.0,
            detached: 0,
        };
    effect_buf_push(ctx.effects, e);
}

// A message down selector with a watch (tutuca's sendAt with { settled,
// progress, timeout, detached }), its id, which ctx_cancel takes: settled
// (a name, or null) is sent back here with settled_args and the watch's
// report ({ id, outcome, tasks, failed }) after them once the message and
// everything it caused ran; progress likewise ({ id, tasks, open, failed })
// after what runs in it, one queued at a time; timeout (ms, negative for
// none) cancels it if it hasn't settled by then. With none of the three it
// opens none, and gives 0. Detached, it's in no watch around it: nothing
// waits for it.
fn ctx_send_watched(
    ctx: &context,
    name: js_string,
    args: &value_array,
    selector: &selector,
    settled: js_string_opt,
    settled_args: &value_array,
    progress: js_string_opt,
    progress_args: &value_array,
    timeout: f64,
    detached: i32,
) -> i32 {
    let id = 0;
    if !!settled | !!progress | (timeout >= 0.0) {
        id = ctx_next_id(ctx);
    }
    let e: &effect_send_at =
        {
            kind: effect_kind_send_at,
            name,
            args,
            selector,
            watch_id: id,
            settled,
            settled_args,
            progress,
            progress_args,
            timeout,
            detached,
        };
    effect_buf_push(ctx.effects, e);
    id;
}

// Cancels the watch id (ctx_send_watched's) once this handler commits: its
// queued tasks are dropped, its asks aborted, the watches inside it
// cancelled, and it settles as cancelled once what's running is done.
fn ctx_cancel(ctx: &context, id: i32) {
    let e: &effect_cancel = { kind: effect_kind_cancel, id };
    effect_buf_push(ctx.effects, e);
}

// A message to the sender of the one being handled, where and as it was when
// it sent it (tutuca's ctx.reply): a sender another component replaced since
// is stale; a notification keeps its sender at every hop, so a reply from
// any hop reaches the component that notified; one to the host (from an
// event's, a host send's or an answer's handler) is unhandled.
fn ctx_reply(ctx: &context, name: js_string, args: &value_array) {
    let e: &effect_reply = { kind: effect_kind_reply, name, args };
    effect_buf_push(ctx.effects, e);
}

fn ctx_forward_at(ctx: &context, selector: &selector) {
    let e: &effect_forward_at = { kind: effect_kind_forward_at, selector };
    effect_buf_push(ctx.effects, e);
}

fn ctx_stop_next(ctx: &context) {
    effect_buf_push(ctx.effects, EFFECT_STOP_NEXT);
}

fn ctx_log(ctx: &context, v: &value) {
    let e: &effect_log = { kind: effect_kind_log, value: v };
    effect_buf_push(ctx.effects, e);
}

// The world, as the host's env gives it. Handlers use these instead of a
// clock or a random source of their own.
fn ctx_now(ctx: &context) -> f64 {
    env_now();
}

fn ctx_random(ctx: &context) -> f64 {
    env_random();
}

fn ctx_uuid(ctx: &context) -> js_string {
    env_uuid();
}

// A component of a type registered in the handling component's scope, e.g.
// the one a handler returns in Swapped.
fn ctx_make(ctx: &context, name: js_string, fields: &value) -> &component {
    scope_make_or_fail(ctx.scope, name, fields);
}

// ctx_make's outcome instead of its failure: { ok: the component }, or
// { err: { error, issues } } saying why it can't be made (scope_try_make),
// for a handler to show instead of failing its task.
fn ctx_try_make(ctx: &context, name: js_string, fields: &value) -> &value {
    scope_try_make(ctx.scope, name, fields);
}

// The names of the types a handler can make: those registered in the
// handling component's scope, and with walk in its parents too (scope_names).
// An ask handler gets the asker's context, so these are the asker's.
fn ctx_component_names(ctx: &context, walk: i32) -> &value {
    scope_names(ctx.scope, walk);
}

// A component of a type registered in the scope the component init is making
// is being made in, e.g. the default of a field that holds a component.
fn init_ctx_make(ctx: &init_context, name: js_string, fields: &value) -> &component {
    scope_make_or_fail(ctx.scope, name, fields);
}

// The default of owner's field, a component of type name made in ctx's
// scope, as an outcome: { ok: the component }, or { err: why it can't be made },
// prefixed with where (tutuca's prefixed: "Board.child: ..."), which init
// gives back as its own error (init_made_fail), so a default inside a
// default says each field on the way.
fn init_make_field(
    ctx: &init_context,
    owner: js_string,
    field: js_string,
    name: js_string,
) -> &value {
    let made = scope_make(ctx.scope, name, map_empty());
    if !!made.component {
        return outcome_ok(value_component(made.component!));
    }
    let b = text_builder_new();
    text_push(b, owner);
    text_push_unit(b, '.');
    text_push(b, field);
    text_push(b, s_colon_space);
    if !!made.error {
        text_push(b, reason_text(made.error!));
    } else {
        text_push(b, s_err_cant_make);
        text_push(b, name);
    }
    outcome_err(value_string(text_finish(b)));
}
