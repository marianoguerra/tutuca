// Scopes (NOTES.md; tutuca's src/scope.js): the names component types are
// registered under, nested into a tree, and making components through them.

fn scope_new(name: &extern, parent: &?scope) -> &scope {
    {scope|
        name,
        parent,
        children: smap_empty(),
        entries: smap_empty(),
        ask_handlers: smap_empty(),
        interfaces: smap_empty(),
    };
}

fn scope_root() -> &scope {
    scope_new(s_empty, null);
}

// The child scope named so, made on first use.
fn scope_enter(s: &scope, name: &extern) -> &scope {
    let child = smap_get(s.children, name);
    if !!child {
        return child! as &scope;
    }
    let made = scope_new(name, s);
    s.children = smap_assoc(s.children, name, made);
    made;
}

// A type registered under an interface's name visible here must implement
// it, and so must a type that declares interfaces visible here; registering
// one that doesn't fails. Interfaces registered later are checked when a
// component is made.
fn scope_register(s: &scope, name: &extern, spec: &component_spec, vtable: &vtable) {
    let problem = scope_entry_problem(s, name, spec);
    if !!problem {
        host_fail(problem!);
    }
    s.entries = smap_assoc(s.entries, name, {scope_entry| spec, vtable });
}

// Here first, then in the parents: inner registrations win.
fn scope_lookup(s: &scope, name: &extern) -> &?scope_entry {
    let at: &?scope = s;
    while !!at {
        let found = smap_get((at!).entries, name);
        if !!found {
            return found! as &scope_entry;
        }
        at = (at!).parent;
    }
    null;
}

// The names of the types registered here, sorted; with walk, those in the
// parents too, each once: an inner registration hides an outer one, as
// scope_lookup resolves them. A list value of strings.
fn scope_names(s: &scope, walk: i32) -> &value {
    let acc = {map_entries_acc| keys: pv_empty(), values: pv_empty() };
    let from: &?scope = s;
    while !!from {
        phm_each((from!).entries, acc, map_entries_visit);
        from = walk?(from!).parent:null;
    }
    // Kept sorted as they come, inner ones first: there are few.
    let names = ext_buf_new(pv_count(acc.keys));
    let i = 0;
    while i <s pv_count(acc.keys) {
        let (_, key) = pv_get(acc.keys, i);
        let name = (key! as &value_string).value;
        // Where name goes: the first slot not before it.
        let at = 0;
        let placed = 0;
        let seen = 0;
        while (at <s names.len) & !placed {
            let here = ext_buf_at(names, at);
            if str_lt(here, name) {
                at += 1;
            } else {
                placed = 1;
                seen = str_eq(here, name);
            }
        }
        if !seen {
            ext_buf_push(names, name);
            let j = names.len - 1;
            while j >s at {
                names.items[j] = names.items[j - 1];
                j -= 1;
            }
            names.items[at] = name;
        }
        i += 1;
    }
    let out = list_empty();
    let j = 0;
    while j <s names.len {
        out = list_push(out, value_string(ext_buf_at(names, j)));
        j += 1;
    }
    out;
}

// A name that makes a component of spec's type from s: one it's registered
// under here or in a parent that no inner registration hides. null when
// there's none, e.g. for a type loaded elsewhere or registered under a
// renamed name in another scope.
fn scope_name_of(s: &scope, spec: &component_spec) -> &?extern {
    let from: &?scope = s;
    while !!from {
        let acc = {map_entries_acc| keys: pv_empty(), values: pv_empty() };
        phm_each((from!).entries, acc, map_entries_visit);
        let i = 0;
        while i <s pv_count(acc.keys) {
            let (_, key) = pv_get(acc.keys, i);
            let (_, entry) = pv_get(acc.values, i);
            let name = (key! as &value_string).value;
            if (entry! as &scope_entry).spec == spec {
                let found = scope_lookup(s, name);
                if !!found & ((found!).spec == spec) {
                    return name;
                }
            }
            i += 1;
        }
        from = (from!).parent;
    }
    null;
}

fn scope_register_ask(s: &scope, name: &extern, handler: &ask_fn) {
    s.ask_handlers = smap_assoc(s.ask_handlers, name, {ask_handler| handler });
}

fn scope_lookup_ask(s: &scope, name: &extern) -> &?ask_handler {
    let at: &?scope = s;
    while !!at {
        let found = smap_get((at!).ask_handlers, name);
        if !!found {
            return found! as &ask_handler;
        }
        at = (at!).parent;
    }
    null;
}

// What making a component by name gave: the component, or null and why.
// issues are init's, for the caller to report.
type make_result = { component: &?component, issues: &value, error: &?value };

// Makes a component by name. It gets the scope that was asked, not the parent
// the entry was found in, so the names it asks for resolve from where it was
// made.
fn scope_make(s: &scope, name: &extern, fields: &value) -> &make_result {
    let entry = scope_lookup(s, name);
    if !entry {
        let message = value_string(js_string_concat(s_err_unknown_component, name));
        return {make_result| component: null, issues: list_empty(), error: message };
    }
    let e = entry!;
    let problem = scope_entry_problem(s, name, e.spec);
    if !!problem {
        return {make_result| component: null, issues: list_empty(), error: value_string(problem!) };
    }
    let made = e.vtable.init(fields, {init_context| scope: s });
    if !made.instance {
        return {make_result| component: null, issues: made.issues, error: made.error };
    }
    let c = component_new(e.spec, made.instance!, e.vtable, s);
    {make_result| component: c, issues: made.issues, error: null };
}

// Why making a component of type name failed, in words.
fn make_failure_text(name: &extern, made: &make_result) -> &extern {
    let text = js_string_concat(s_err_cant_make, name);
    if !!made.error {
        text = js_string_concat(js_string_concat(text, s_colon_space), reason_text(made.error!));
    }
    text;
}

// Makes a component by name, failing the task when it can't.
fn scope_make_or_fail(s: &scope, name: &extern, fields: &value) -> &component {
    let made = scope_make(s, name, fields);
    if !made.component {
        host_fail(make_failure_text(name, made));
        unreachable;
    }
    made.component!;
}

// Makes a component by name, as a result: Ok(the component), or Err({ error,
// issues }) when it can't: error says why in words, issues are init's
// ({ field, problem } each).
fn scope_try_make(s: &scope, name: &extern, fields: &value) -> &value {
    let made = scope_make(s, name, fields);
    if !!made.component {
        return value_ok(value_component(made.component!));
    }
    let why = map_assoc(map_empty(), s_error, value_string(make_failure_text(name, made)));
    value_err(map_assoc(why, s_issues, made.issues));
}

// Answers asks of this name through the host's ask import, later
// (host_ask_handler, api.wax).
fn scope_register_host_ask(s: &scope, name: &extern) {
    scope_register_ask(s, name, host_ask_handler);
}
