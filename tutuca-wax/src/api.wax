// Why v breaks constraint c, as a string value, or null: for tools and tests
// that check values the way a schema does, without an owner.
#[export = "constraint_problem"]
fn api_constraint_problem(c: &constraint, v: &value) -> &value {
    let problem = constraint_problem(c, v, null);
    if !problem {
        return VALUE_NULL;
    }
    value_string(problem!);
}

// After a task failed: a dev host whose queue that emptied checks the
// invariants of the settled state, as it does after a task that committed.
#[export = "host_after_failure"]
fn api_host_after_failure(h: &host) {
    if h.dev & !host_has_tasks(h) {
        host_check_settled(h);
    }
}

