// Why v breaks constraint c, as a string value, or null: for tools and tests
// that check values the way a schema does, without an owner.
#[export = "constraint_problem"]
fn api_constraint_problem(c: &constraint, v: &value) -> &value {
    let problem = constraint_problem(c, v, null);
    if !problem {
        return VALUE_NULL;
    }
    value_string(problem!);
}

// After a task failed: a dev host whose queue that emptied checks the
// invariants of the settled state, as it does after a task that committed.
// What became of the task host_step last ran (host_transition), or null.
#[export = "host_transition"]
fn api_host_transition(h: &host) -> &value {
    host_transition(h);
}

// Applies the pure message name(args) to the component sel reaches, now
// (host_apply); args is a list value.
#[export = "host_apply"]
fn api_host_apply(h: &host, name: js_string, args: &value, sel: &selector) -> &value {
    host_apply(h, name, list_to_values(args), sel);
}

// What sel reaches from the root, now (a component, or null), and where:
// { path, id } (tutuca's addressOf).
#[export = "host_value_at"]
fn api_host_value_at(h: &host, sel: &selector) -> &value {
    key_path_get_or_null(host_route_at(h, sel).key_path, h.root);
}

#[export = "host_address_of"]
fn api_host_address_of(h: &host, sel: &selector) -> &value {
    route_value(host_route_at(h, sel), 0);
}

// The records made besides the tasks' transitions since the last call
// (host_take_events): dropped tasks' transitions, watches opening and
// settling.
#[export = "host_take_events"]
fn api_host_take_events(h: &host) -> &value {
    host_take_events(h);
}

// Cancels the open watch id, as timed out when timeout (its timer fired);
// 0 when there's none such open.
#[export = "host_cancel_watch"]
fn api_host_cancel_watch(h: &host, id: i32, timeout: i32) -> i32 {
    watch_cancel_id(h, id, timeout?watch_timeout:watch_cancelled);
}

// Drops every queued task and the asks pending: for a host that stops.
#[export = "host_clear"]
fn api_host_clear(h: &host) {
    h.queue.head = 0;
    h.queue.len = 0;
    h.queue.items = [task_array|null; 16];
    h.pending = pv_empty();
    h.watches = pv_empty();
}

#[export = "host_after_failure"]
fn api_host_after_failure(h: &host) {
    // It failed: counted in its watches, and done.
    if !!h.cur {
        watch_task_failed(h.cur!);
        watch_leave(h, h.cur!);
    }
    if h.dev & !host_has_tasks(h) {
        host_check_settled(h);
    }
}

#[export = "host_render"]
fn api_host_render(h: &host) -> i32 {
    host_render(h);
}

// A DOM event: the event itself, its target and type, and the value
// handlers read as ctx.event.
#[export = "host_dispatch_event"]
fn api_host_dispatch_event(
    h: &host,
    e: dom_event,
    target: dom_node,
    kind: js_string,
    event: &value,
