}

#[export = "view_array_set"]
fn api_view_array_set(a: &view_array, i: i32, v: &view) {
    a[i] = v;
}

#[export = "view_on_array_new"]
fn api_view_on_array_new(n: i32) -> &view_on_array {
    [view_on_array|null; n];
}

#[export = "view_on_array_set"]
fn api_view_on_array_set(a: &view_on_array, i: i32, h: &view_on) {
    a[i] = h;
}

#[export = "template_array_length"]
fn api_template_array_length(a: &template_array) -> i32 {
    a.length();
}

#[export = "template_array_get"]
fn api_template_array_get(a: &template_array, i: i32) -> &template {
    a[i]!;
}

#[export = "template_tid"]
fn api_template_tid(t: &template) -> i32 {
    t.tid;
}

// The template collecting an element's views set on it, or null.
#[export = "view_el_template"]
fn api_view_el_template(v: &view) -> &?template {
    (v as &view_el).template;
}

// The constant class names of a component type's views, each once: what
// loadComponent reports for the types a module registers, to compile CSS for.
#[export = "spec_classes"]
fn api_spec_classes(spec: &component_spec) -> &value {
    spec_class_names(spec);
}

// A walker that records the kinds it visits, as a list of numbers.
type kinds_state = { kinds: mut &value };

fn kinds_record(w: &walker, n: &view) {
    let s = w.state as &kinds_state;
    s.kinds = list_push(s.kinds, value_number(n.kind as f64_s));
}

fn kinds_node: visit_fn (w: &walker, n: &view) {
    kinds_record(w, n);
    walk_children(w, n);
}

fn kinds_element: visit_fn (w: &walker, n: &view) {
    kinds_record(w, n);
    walk_element_default(w, n);
}

// Every kind, in walk order: node and element overridden.
#[export = "views_walk_kinds"]
fn api_views_walk_kinds(views: &view_array) -> &value {
    let vt = walker_vtable_default();
    vt.node = kinds_node;
    vt.element = kinds_element;
    let s = {kinds_state| kinds: list_empty() };
    walk_all(walker_new(s, vt), views);
    s.kinds;
}

// Only each and render overridden: render_each reaches each, render_it render.
#[export = "views_walk_loops"]
fn api_views_walk_loops(views: &view_array) -> &value {
    let vt = walker_vtable_default();
    vt.each = kinds_node;
    vt.render = kinds_node;
    let s = {kinds_state| kinds: list_empty() };
    walk_all(walker_new(s, vt), views);
    s.kinds;
}

#[export = "path_key_array_array_new"]
fn api_path_key_array_array_new(n: i32) -> &path_key_array_array {
    [path_key_array_array|null; n];
}

#[export = "path_key_array_array_set"]
fn api_path_key_array_array_set(a: &path_key_array_array, i: i32, keys: &path_key_array) {
    a[i] = keys;
}

// A component's render that provides names[i] at keys[i].
#[export = "snode_component_providing"]
fn api_snode_component_providing(
    name: js_string,
    names: &str_array,
    keys: &path_key_array_array,
    childs: &snode_array,
) -> &snode {
    snode_component(name, meta_component_text(names, keys), childs);
}

// The keys to the component (and loop item) node was rendered in, as the DOM's
// metadata says; null outside container or any component.
#[export = "dom_key_path_of"]
fn api_dom_key_path_of(container: dom_node, node: dom_node) -> &?value {
    let p = path_of(container, node);
    if !p {
        return null;
    }
    keys_to_list(dispatch_path_to_key_path(p!).keys);
}
