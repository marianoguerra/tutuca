// Host.render's lowering: the vnodes of a semantic tree.
#[export = "lower"]
fn api_lower(nodes: &snode_array) -> &vnode_array {
    lower_all(nodes);
}

// For the fromCharCodeArray polyfill, on engines without the builtin: JS
// can't read a wasm-gc array otherwise.
#[export = "u16_array_get"]
fn api_u16_array_get(units: &u16_array, i: i32) -> i32 {
    units[i] as i32_u;
}

// The component runtime: scopes, making components, hosts.

#[export = "scope_root"]
fn api_scope_root() -> &scope {
    scope_root();
}

#[export = "scope_enter"]
fn api_scope_enter(s: &scope, name: js_string) -> &scope {
    scope_enter(s, name);
}

#[export = "scope_leave"]
fn api_scope_leave(s: &scope, name: js_string) {
    scope_leave(s, name);
}

// Makes a component by name: { ok: it }, or { err: why }. fields is a map
// value.
#[export = "scope_make"]
fn api_scope_make(s: &scope, name: js_string, fields: &value) -> &value {
    let made = scope_make(s, name, fields);
    if !made.component {
        return outcome_err(made.error!);
    }
    outcome_ok(value_component(made.component!));
}

// The issues init reported making a component by name: a list value.
#[export = "scope_make_issues"]
fn api_scope_make_issues(s: &scope, name: js_string, fields: &value) -> &value {
    scope_make(s, name, fields).issues;
}

fn list_to_values(list: &value) -> &value_array {
    let n = list_count(list);
    let out = [value_array|null; n];
    let i = 0;
    while i <s n {
        out[i] = list_get(list, i);
        i += 1;
    }
    out;
}

fn values_to_list(args: &value_array) -> &value {
    let out = list_empty();
    let i = 0;
    while i <s args.length() {
        out = list_push(out, args[i]!);
        i += 1;
    }
    out;
}

// Answers asks of this name through the host's ask import: now, later (the
// host calls host_settle with the id it returned) or not at all.
fn host_ask_handler: ask_fn (name: js_string, args: &value_array, ctx: &context) -> &ask_result {
    let answer = host_ask(name, values_to_list(args) as &extern);
    if answer.kind == value_kind_map {
        return ask_result_reply(answer);
    }
    if answer.kind == value_kind_number {
        return ask_result_pending((answer as &value_number).value as i32_s);
    }
    ask_result_not_found();
}

// The name of a component value's type.
#[export = "component_type_name"]
fn api_component_type_name(v: &value) -> js_string {
    (value_as_component(v)!).spec.name;
}

// The name a component value's type is made by from s (scope_name_of), as a
// string value, or null.
#[export = "scope_name_of"]
fn api_scope_name_of(s: &scope, v: &value) -> &value {
    let c = value_as_component(v);
    if !c {
        return VALUE_NULL;
    }
    let name = scope_name_of(s, (c!).spec);
    if !name {
        return VALUE_NULL;
    }
    value_string(name!);
}

// A component value's property, through its vtable's get.
#[export = "component_get"]
fn api_component_get(v: &value, name: js_string) -> &value {
    get_key(v, path_key_name(name));
}

// A host rendering into container in doc; headless when both are null.
#[export = "host_new"]
fn api_host_new(doc: dom_document_opt, container: dom_node_opt, root: &value) -> &host {
    host_new(doc, container, root);
}

// Dev mode: checks the whole state now, then after each task.
// Whether h's renders reuse what the last one rendered where nothing it
// depends on changed (on by default, as tutuca's CopyCache).
#[export = "host_set_render_cache"]
fn api_host_set_render_cache(h: &host, enabled: i32) {
    h.render_cache = enabled;
    h.cache_tree = cache_children_new();
}

// How many components h's renders reused from the cache, and rendered:
// { hits, misses }.
#[export = "host_cache_stats"]
fn api_host_cache_stats(h: &host) -> &value {
    let m = map_assoc(map_empty(), s_hits, value_number(h.cache_stats.hits as f64_s));
    map_assoc(m, s_misses, value_number(h.cache_stats.misses as f64_s));
}

#[export = "host_set_dev"]
fn api_host_set_dev(h: &host, dev: i32) {
    h.dev = dev;
    if dev {
        host_check(h);
    }
}

// A component's type's schema as a value, or null.
#[export = "component_schema"]
fn api_component_schema(v: &value) -> &value {
    let c = value_as_component(v);
    if !c {
        return VALUE_NULL;
    }
    spec_schema_value((c!).spec);
}

// Why the component v can't take the message name with args (a list value)
// now, as a string value, or null when it can.
#[export = "component_message_problem"]
fn api_component_message_problem(v: &value, name: js_string, args: &value) -> &value {
    let c = value_as_component(v);
    if !c {
        return VALUE_NULL;
    }
    let problem = message_problem(c!, name, list_to_values(args));
    if !problem {
        return VALUE_NULL;
    }
    value_string(problem!);
}

// Runs the component v's query name with args (a list value): { ok: its
// value }, or { err } saying why it couldn't.
// What component_query or component_apply_js give when what they ran
// threw (a host call that failed, or a trap): { err } with code failed and
// the error's message as its detail, as a handler that rejects gives.
#[export = "component_failure"]
fn api_component_failure(v: &value, name: js_string, detail: js_string) -> &value {
    let c = value_as_component(v);
    if !c {
        return not_component_error(name);
    }
    apply_fail(c!, name, s_a_failed, detail);
}

#[export = "component_query"]
fn api_component_query(v: &value, name: js_string, args: &value) -> &value {
    let c = value_as_component(v);
    if !c {
        return not_component_error(name);
    }
    component_query(c!, name, list_to_values(args));
}

// The component v after its pure message name with args (a list value),
// outside any task: { ok: the new component } (v when nothing changed) with
// its invariants checked, or { err: { code, issues, detail, component,
// message } }.
#[export = "component_apply_js"]
fn api_component_apply(v: &value, name: js_string, args: &value) -> &value {
    value_try_apply(v, name, list_to_values(args), 1);
}

// The identity of the component v (tutuca's idOf), or 0 for a value that
// isn't one.
#[export = "component_id"]
fn api_component_id(v: &value) -> i32 {
    let c = value_as_component(v);
    if !c {
        return 0;
    }
    (c!).id;
}

// What the component v offers (component_contract), or null.
#[export = "component_contract"]
fn api_component_contract(v: &value) -> &value {
    let c = value_as_component(v);
    if !c {
        return VALUE_NULL;
    }
    component_contract(c!);
}

// What the type registered as name, visible from s, offers, its interfaces
// resolved in s (spec_contract); null for no such type or one without a
// schema.
#[export = "scope_contract"]
fn api_scope_contract(s: &scope, name: js_string) -> &value {
    let entry = scope_lookup(s, name);
    if !entry {
        return VALUE_NULL;
    }
    spec_contract((entry!).spec, s);
}

// What the component v lacks to implement the interface name, as a list of
// problems, empty when it implements it.
#[export = "component_supports"]
fn api_component_supports(v: &value, name: js_string) -> &value {
    let c = value_as_component(v);
    if !c {
        return list_push(list_empty(), value_string(s_a_not_component));
    }
    component_supports(c!, name);
}

// The interface registered as name, visible from s, as a value, or null.
#[export = "scope_interface"]
fn api_scope_interface(s: &scope, name: js_string) -> &value {
    let iface = scope_lookup_interface(s, name);
    if !iface {
        return VALUE_NULL;
    }
    interface_schema_value(iface!);
}

// What the type registered as name, visible from s, says under uri, over
// the defaults of s's schema for it (scope_meta_of); null for no such type.
#[export = "scope_meta_of"]
fn api_scope_meta_of(s: &scope, name: js_string, uri: js_string) -> &value {
    scope_meta_of(s, name, uri);
}

// What a component value says under uri, read in the scope it was made in.
#[export = "component_meta_of"]
fn api_component_meta_of(v: &value, uri: js_string) -> &value {
    let c = value_as_component(v);
    if !c {
        return VALUE_NULL;
    }
    spec_meta_in((c!).scope, (c!).spec, uri);
}

// What the component v renders for target (render_target), as data.
#[export = "render_target"]
fn api_render_target(v: &value, target: js_string, view: js_string_opt, falls_back: i32) -> &value {
    render_target(v, target, view, falls_back);
}

// Whether the component v says anything under uri (tutuca's hasMeta).
#[export = "component_has_meta"]
fn api_component_has_meta(v: &value, uri: js_string) -> i32 {
    let c = value_as_component(v);
    if !c {
        return 0;
    }
    !!map_get((c!).spec.meta, uri);
}

// What's wrong with what the component v says under uri, against its
// scope's schema for it (component_meta_problems).
#[export = "component_meta_problems"]
fn api_component_meta_problems(v: &value, uri: js_string) -> &value {
    let c = value_as_component(v);
    if !c {
        return list_empty();
    }
    component_meta_problems(c!, uri);
}

// The meta schema registered for uri, visible from s, as a value: { uri,
// fields, defaults }, or null.
#[export = "scope_meta_schema"]
fn api_scope_meta_schema(s: &scope, uri: js_string) -> &value {
    let schema = scope_lookup_meta_schema(s, uri);
    if !schema {
        return VALUE_NULL;
    }
    let m = map_empty();
    m = map_assoc(m, s_uri, value_string((schema!).uri));
    m = map_assoc(m, s_fields, field_schemas_value((schema!).fields));
    map_assoc(m, s_defaults, (schema!).defaults);
}

#[export = "host_root"]
fn api_host_root(h: &host) -> &value {
