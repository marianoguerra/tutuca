// What the JS side calls: building values, vnodes and semantic trees, and
// rendering them. js/tutuca-rt.js wraps these in a friendlier API. It also
// calls the component ABI's exports (src/abi.wax): value constructors, List
// and Map, the semantic tree's nodes.

#[export = "str_array_new"]
fn api_str_array_new(n: i32) -> &str_array {
    [str_array|null; n];
}

#[export = "str_array_set"]
fn api_str_array_set(a: &str_array, i: i32, s: js_string) {
    a[i] = s;
}

#[export = "value_array_new"]
fn api_value_array_new(n: i32) -> &value_array {
    [value_array|null; n];
}

#[export = "value_array_set"]
fn api_value_array_set(a: &value_array, i: i32, v: &value) {
    a[i] = v;
}

#[export = "vnode_array_new"]
fn api_vnode_array_new(n: i32) -> &vnode_array {
    [vnode_array|null; n];
}

#[export = "vnode_array_set"]
fn api_vnode_array_set(a: &vnode_array, i: i32, v: &vnode) {
    a[i] = v;
}

#[export = "vnode_array_length"]
fn api_vnode_array_length(a: &vnode_array) -> i32 {
    a.length();
}

