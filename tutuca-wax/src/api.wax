// Paths, for testing them against the spec's component/paths.rkt cases: a
// dispatch path from frames, and what it resolves to, as values.

#[export = "frame_array_new"]
fn api_frame_array_new(n: i32) -> &frame_array {
    [frame_array|null; n];
}

#[export = "frame_array_set"]
fn api_frame_array_set(a: &frame_array, i: i32, f: &frame) {
    a[i] = f;
}

fn keys_to_list(keys: &path_key_array) -> &value {
    let out = list_empty();
    let i = 0;
    while i <s keys.length() {
        out = list_push(out, value_from_key(keys[i]!));
        i += 1;
    }
    out;
}

fn keys_from_list(list: &value) -> &update_path {
    let n = list_count(list);
    let keys = [path_key_array|null; n];
    let i = 0;
    while i <s n {
        keys[i] = key_from_value(list_get(list, i)!);
        i += 1;
    }
    {update_path| keys };
}

#[export = "path_resolve"]
fn api_path_resolve(frames: &frame_array) -> &value {
    keys_to_list(dispatch_path_resolve({dispatch_path| frames }).keys);
}

#[export = "path_to_update"]
fn api_path_to_update(frames: &frame_array) -> &value {
    keys_to_list(dispatch_path_to_update({dispatch_path| frames }).keys);
}

#[export = "path_source_key_in"]
fn api_path_source_key_in(frames: &frame_array, receiver: &frame_array) -> &value {
    let key =
        dispatch_path_source_key_in({dispatch_path| frames }, {dispatch_path| frames: receiver });
    if !key {
        return VALUE_NULL;
    }
    value_from_key(key!);
}

#[export = "path_get_in"]
fn api_path_get_in(keys: &value, root: &value) -> &value {
    update_path_get_in(keys_from_list(keys), root);
}

#[export = "path_set_in"]
fn api_path_set_in(keys: &value, root: &value, item: &value) -> &value {
    update_path_set_in(keys_from_list(keys), root, item);
}

