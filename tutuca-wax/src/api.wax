// The constant class names of a component type's views, each once: what
// loadComponent reports for the types a module registers, to compile CSS for.
#[export = "spec_classes"]
fn api_spec_classes(spec: &component_spec) -> &value {
    views_collect_classes(spec.views);
}

// A walker that records the kinds it visits, as a list of ints.
type kinds_state = { kinds: mut &value };

fn kinds_record(w: &walker, n: &view) {
    let s = w.state as &kinds_state;
    s.kinds = list_push(s.kinds, value_int(n.kind));
}

fn kinds_node: visit_fn (w: &walker, n: &view) {
    kinds_record(w, n);
    walk_children(w, n);
}

fn kinds_element: visit_fn (w: &walker, n: &view) {
    kinds_record(w, n);
    walk_element_default(w, n);
}

// Every kind, in walk order: node and element overridden.
#[export = "views_walk_kinds"]
fn api_views_walk_kinds(views: &view_array) -> &value {
    let vt = walker_vtable_default();
    vt.node = kinds_node;
    vt.element = kinds_element;
    let s = {kinds_state| kinds: list_empty() };
    walk_all(walker_new(s, vt), views);
    s.kinds;
}

// Only each and render overridden: render_each reaches each, render_it render.
#[export = "views_walk_loops"]
fn api_views_walk_loops(views: &view_array) -> &value {
    let vt = walker_vtable_default();
    vt.each = kinds_node;
    vt.render = kinds_node;
    let s = {kinds_state| kinds: list_empty() };
    walk_all(walker_new(s, vt), views);
    s.kinds;
}
