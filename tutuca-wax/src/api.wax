// The component runtime: scopes, making components, hosts.

#[export = "scope_root"]
fn api_scope_root() -> &scope {
    scope_root();
}

#[export = "scope_enter"]
fn api_scope_enter(s: &scope, name: js_string) -> &scope {
    scope_enter(s, name);
}

#[export = "scope_leave"]
fn api_scope_leave(s: &scope, name: js_string) {
    scope_leave(s, name);
}

// Makes a component by name: an ok result holding it, or an err result
// holding why. fields is a map value.
#[export = "scope_make"]
fn api_scope_make(s: &scope, name: js_string, fields: &value) -> &value {
    let made = scope_make(s, name, fields);
    if !made.component {
        return value_err(made.error!);
    }
    value_ok(value_component(made.component!));
}

// The issues init reported making a component by name: a list value.
#[export = "scope_make_issues"]
fn api_scope_make_issues(s: &scope, name: js_string, fields: &value) -> &value {
    scope_make(s, name, fields).issues;
}

fn list_to_values(list: &value) -> &value_array {
    let n = list_count(list);
    let out = [value_array|null; n];
    let i = 0;
    while i <s n {
        out[i] = list_get(list, i);
        i += 1;
    }
    out;
}

fn values_to_list(args: &value_array) -> &value {
    let out = list_empty();
    let i = 0;
    while i <s args.length() {
        out = list_push(out, args[i]!);
        i += 1;
    }
    out;
}

// Answers asks of this name through the host's ask import: now, later (the
// host calls host_settle with the id it returned) or not at all.
fn host_ask_handler: ask_fn (name: js_string, args: &value_array, ctx: &context) -> &ask_result {
    let answer = host_ask(name, values_to_list(args) as &extern);
    if answer.kind == value_kind_result {
        return ask_result_reply(answer);
    }
    if answer.kind == value_kind_int {
        return ask_result_pending((answer as &value_int).value);
    }
    ask_result_not_found();
}

// The name of a component value's type.
#[export = "component_type_name"]
fn api_component_type_name(v: &value) -> js_string {
    (value_as_component(v)!).spec.name;
}

// The name a component value's type is made by from s (scope_name_of), as a
// string value, or null.
#[export = "scope_name_of"]
fn api_scope_name_of(s: &scope, v: &value) -> &value {
    let c = value_as_component(v);
    if !c {
        return VALUE_NULL;
    }
    let name = scope_name_of(s, (c!).spec);
    if !name {
        return VALUE_NULL;
    }
    value_string(name!);
}

// A component value's property, through its vtable's get.
#[export = "component_get"]
fn api_component_get(v: &value, name: js_string) -> &value {
    get_key(v, path_key_name(name));
}

// A host rendering into container in doc; headless when both are null.
#[export = "host_new"]
fn api_host_new(doc: dom_document_opt, container: dom_node_opt, root: &value) -> &host {
    host_new(doc, container, root);
}

// Dev mode: checks the whole state now, then after each task.
#[export = "host_set_dev"]
fn api_host_set_dev(h: &host, dev: i32) {
    h.dev = dev;
    if dev {
        host_check(h);
    }
}

// A component's type's schema as a value, or null.
#[export = "component_schema"]
fn api_component_schema(v: &value) -> &value {
    let c = value_as_component(v);
    if !c {
        return VALUE_NULL;
    }
    spec_schema_value((c!).spec);
}

// Why the component v can't take the message name with args (a list value)
// now, as a string value, or null when it can.
#[export = "component_message_problem"]
fn api_component_message_problem(v: &value, name: js_string, args: &value) -> &value {
    let c = value_as_component(v);
    if !c {
        return VALUE_NULL;
    }
    let problem = message_problem(c!, name, list_to_values(args));
    if !problem {
        return VALUE_NULL;
    }
    value_string(problem!);
}

// The interface registered as name, visible from s, as a value, or null.
#[export = "scope_interface"]
fn api_scope_interface(s: &scope, name: js_string) -> &value {
    let iface = scope_lookup_interface(s, name);
    if !iface {
        return VALUE_NULL;
    }
    interface_schema_value(iface!);
}

#[export = "host_root"]
fn api_host_root(h: &host) -> &value {
