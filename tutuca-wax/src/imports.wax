// What the runtime imports from its host, besides the js-string builtins
// (prelude/js_string.wax).
//
// Strings are JS strings: a `js_string` (prelude/js_string.wax), an externref
// passed through as it is, so a string crosses the boundary without being
// copied. Optional strings are `js_string_opt`.

// String constants (imported string constants, the "'" module): each global
// is the JS string its import name spells.
import "'" {
    #[import = "value"]
    const s_value: js_string;
    #[import = "checked"]
    const s_checked: js_string;
    #[import = "is"]
    const s_is: js_string;
    #[import = "dangerouslySetInnerHTML"]
    const s_dangerously_set_inner_html: js_string;
    #[import = ""]
    const s_empty: js_string;
    #[import = "PROGRESS"]
    const s_progress_tag: js_string;
    #[import = "SELECT"]
    const s_select_tag: js_string;
    #[import = "svg"]
    const s_svg: js_string;
    #[import = "math"]
    const s_math: js_string;
    #[import = "foreignobject"]
    const s_foreign_object_lower: js_string;
    #[import = "http://www.w3.org/1999/xhtml"]
    const s_html_ns: js_string;
    #[import = "http://www.w3.org/2000/svg"]
    const s_svg_ns: js_string;
    #[import = "http://www.w3.org/1998/Math/MathML"]
    const s_math_ns: js_string;
    #[import = "className"]
    const s_class_name: js_string;
    #[import = "class"]
    const s_class: js_string;
    #[import = "htmlFor"]
    const s_html_for: js_string;
    #[import = "for"]
    const s_for: js_string;
    // DOM properties that must be set as attributes.
    #[import = "width"]
    const s_width: js_string;
    #[import = "height"]
    const s_height: js_string;
    #[import = "href"]
    const s_href: js_string;
    #[import = "list"]
    const s_list: js_string;
    #[import = "form"]
    const s_form: js_string;
    #[import = "tabIndex"]
    const s_tab_index: js_string;
    #[import = "download"]
    const s_download: js_string;
    #[import = "rowSpan"]
    const s_row_span: js_string;
    #[import = "colSpan"]
    const s_col_span: js_string;
    #[import = "role"]
    const s_role: js_string;
    #[import = "popover"]
    const s_popover: js_string;
    #[import = "data-eid"]
    const s_data_eid: js_string;
    #[import = "null"]
    const s_null: js_string;
    #[import = "__html"]
    const s_html_key: js_string;
    #[import = "key"]
    const s_key: js_string;
    // Views (eval.wax).
    #[import = "main"]
    const s_main: js_string;
    #[import = "true"]
    const s_true: js_string;
    #[import = "false"]
    const s_false: js_string;
    #[import = "[object Object]"]
    const s_object_object: js_string;
    #[import = ","]
    const s_comma: js_string;
    // The pieces of the metadata comments (meta.wax).
    #[import = "§{\"t\":\"component\"}§"]
    const s_meta_component: js_string;
    #[import = "§/§"]
    const s_meta_close: js_string;
    #[import = "§{\"t\":\"frame\",\"p\":"]
