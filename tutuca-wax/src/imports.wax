// The DOM, as the host gives it: the DomNode trait of tutuca-mb's
// vdom/dom.mbt, flattened so that nothing but nodes, strings, numbers and
// booleans crosses the boundary (NOTES.md has the mapping).
import "dom" {
    #[import = "create_element"]
    fn dom_create_element(doc: &extern, tag_name: &extern, ns: &?extern, is_attr: &?extern) -> &extern;
    #[import = "create_text"]
    fn dom_create_text(doc: &extern, text: &extern) -> &extern;
    #[import = "create_comment"]
    fn dom_create_comment(doc: &extern, text: &extern) -> &extern;
    #[import = "create_fragment"]
    fn dom_create_fragment(doc: &extern) -> &extern;

    #[import = "append_child"]
    fn dom_append_child(parent: &extern, child: &extern);
    // Appends when ref_node is null.
    #[import = "insert_before"]
    fn dom_insert_before(parent: &extern, node: &extern, ref_node: &?extern);
    #[import = "remove_child"]
    fn dom_remove_child(parent: &extern, child: &extern);
    #[import = "replace_child"]
    fn dom_replace_child(parent: &extern, node: &extern, old: &extern);
    // replaceChildren() with no arguments: removes every child.
    #[import = "replace_children"]
    fn dom_replace_children(node: &extern);
    #[import = "parent_node"]
    fn dom_parent_node(node: &extern) -> &?extern;
    #[import = "previous_sibling"]
    fn dom_previous_sibling(node: &extern) -> &?extern;
    // A comment's text, or null for any other node.
    #[import = "comment_data"]
    fn dom_comment_data(node: &extern) -> &?extern;
    // An element's data-eid as a number, -1 when it has none.
    #[import = "get_eid"]
    fn dom_get_eid(node: &extern) -> i32;
    // The value of the element with a handler, as a Value (a wasm value the
    // host made through the exports): checked for a checkbox, value otherwise.
    #[import = "target_value"]
    fn dom_target_value(node: &extern) -> &extern;
    #[import = "first_child"]
    fn dom_first_child(node: &extern) -> &?extern;
    #[import = "next_sibling"]
    fn dom_next_sibling(node: &extern) -> &?extern;
    // Identity: externrefs can't be compared inside wasm.
    #[import = "is_same_node"]
    fn dom_is_same_node(a: &extern, b: &extern) -> i32;

    #[import = "set_attribute_string"]
    fn dom_set_attribute_string(node: &extern, name: &extern, value: &extern);
    #[import = "set_attribute_number"]
    fn dom_set_attribute_number(node: &extern, name: &extern, value: f64);
    #[import = "set_attribute_bool"]
    fn dom_set_attribute_bool(node: &extern, name: &extern, value: i32);
    // setAttribute with an opaque object: String(value).
    #[import = "set_attribute_ref"]
    fn dom_set_attribute_ref(node: &extern, name: &extern, value: &extern);
    #[import = "remove_attribute"]
    fn dom_remove_attribute(node: &extern, name: &extern);
    // `name in node`: whether a prop is set as a property or an attribute.
    #[import = "has_property"]
    fn dom_has_property(node: &extern, name: &extern) -> i32;
    // node[name] = value; 0 when the assignment threw.
    #[import = "set_string_property"]
    fn dom_set_string_property(node: &extern, name: &extern, value: &extern) -> i32;
    #[import = "set_number_property"]
    fn dom_set_number_property(node: &extern, name: &extern, value: f64) -> i32;
    #[import = "set_bool_property"]
    fn dom_set_bool_property(node: &extern, name: &extern, value: i32) -> i32;
    // A list, map, result or component, as the opaque object it is.
    #[import = "set_ref_property"]
    fn dom_set_ref_property(node: &extern, name: &extern, value: &extern) -> i32;
    #[import = "get_inner_html"]
    fn dom_get_inner_html(node: &extern) -> &extern;
    #[import = "set_inner_html"]
    fn dom_set_inner_html(node: &extern, html: &extern);
    // Text and comment character data.
    #[import = "set_data"]
    fn dom_set_data(node: &extern, text: &extern);
    // Uppercase for HTML elements, as in the DOM.
    #[import = "tag_name"]
    fn dom_tag_name(node: &extern) -> &extern;
    // null for nodes without one.
    #[import = "namespace_uri"]
    fn dom_namespace_uri(node: &extern) -> &?extern;

    // The nodes render made (a WeakSet on the host). Morphing matches vnodes
    // to these only, so nodes other code put in a rendered element don't
    // shift the match, and stay.
    #[import = "own"]
    fn dom_own(node: &extern);
    #[import = "is_owned"]
    fn dom_is_owned(node: &extern) -> i32;

    // Drag and drop: the closest element with draggable="true", or null;
    // node.dataset[name], or null when unset; setting and deleting it.
    #[import = "closest_draggable"]
    fn dom_closest_draggable(node: &extern) -> &?extern;
    #[import = "dataset_get"]
    fn dom_dataset_get(node: &extern, name: &extern) -> &?extern;
    #[import = "dataset_set"]
    fn dom_dataset_set(node: &extern, name: &extern, value: &extern);
    #[import = "dataset_delete"]
    fn dom_dataset_delete(node: &extern, name: &extern);
    // Whether node is container or inside it; 0 for null.
    #[import = "contains"]
    fn dom_contains(container: &extern, node: &?extern) -> i32;
    // The event's: preventDefault(), its relatedTarget, and its dataTransfer
    // (when it has one) set up for a move: data, so Firefox starts the drag,
    // and the effect allowed at dragstart; the drop effect over a target.
    #[import = "prevent_default"]
    fn dom_prevent_default(e: &extern);
    #[import = "stop_propagation"]
    fn dom_stop_propagation(e: &extern);
    #[import = "related_target"]
    fn dom_related_target(e: &extern) -> &?extern;
    #[import = "drag_start"]
    fn dom_drag_start(e: &extern);
    #[import = "drop_effect_move"]
    fn dom_drop_effect_move(e: &extern);

    // Throws a JS Error with this message; never returns.
    #[import = "fail"]
    fn host_fail(message: &extern);
}

// The world, as the host gives it (MessageContext's now, random and uuid), so
// a run can be repeated by a host that gives the same answers.
import "env" {
    #[import = "now"]
    fn env_now() -> f64;
    #[import = "random"]
    fn env_random() -> f64;
    #[import = "uuid"]
    fn env_uuid() -> &extern;
}

// What the host is told while it runs tasks, and asks it answers.
import "host" {
    // A handler's log: a Value, as an externref.
    #[import = "observe_log"]
    fn observe_log(v: &extern);
    // A message the component has no handler for: it stays as it was.
    #[import = "observe_unhandled"]
    fn observe_unhandled(name: &extern);
    // An ask the host answers (see scope_register_host_ask): its name and its
    // arguments as a list Value. Returns its answer: a result value when it
    // answers now, an int, the id host_settle gets back, when it answers
    // later, or null when the host has no answer for it.
    #[import = "ask"]
    fn host_ask(name: &extern, args: &extern) -> &value;
    // A float as JS's String(n) writes it, for rendering it as text.
    #[import = "number_text"]
    fn host_number_text(n: f64) -> &extern;
    // Whether s matches the regular expression pattern (a pattern constraint).
    #[import = "regex_test"]
    fn host_regex_test(pattern: &extern, s: &extern) -> i32;
    // Throws a JS Error with this message whose rejection is info (a Value):
    // a message a component rejected, with why; never returns.
    #[import = "reject"]
    fn host_reject(message: &extern, info: &extern);
    // What dev mode found: kind is stateInvalid or messageInvalid, info a Value.
    #[import = "observe_issue"]
    fn observe_issue(kind: &extern, info: &extern);
    // Text as JS's Number(text) reads it, NaN for blank text.
    #[import = "parse_number"]
    fn host_parse_number(text: &extern) -> f64;
}
