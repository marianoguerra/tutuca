    #[import = "false"]
    const s_false: &extern;
    #[import = "[object Object]"]
    const s_object_object: &extern;
    #[import = ","]
    const s_comma: &extern;
    // The pieces of the metadata comments (meta.wax).
    #[import = "§{\"t\":\"component\"}§"]
    const s_meta_component: &extern;
    #[import = "§/§"]
    const s_meta_close: &extern;
    #[import = "§{\"t\":\"frame\",\"p\":"]
