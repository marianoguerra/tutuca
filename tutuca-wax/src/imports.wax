// What the runtime imports from its host, besides the js-string builtins
// (prelude/js_string.wax).
//
// Strings are JS strings: an `&extern` passed through as it is, so a string
// crosses the boundary without being copied. Optional strings are `&?extern`.

// String constants (imported string constants, the "'" module): each global
// is the JS string its import name spells.
import "'" {
    #[import = "value"]
    const s_value: &extern;
    #[import = "checked"]
    const s_checked: &extern;
    #[import = "is"]
    const s_is: &extern;
    #[import = "dangerouslySetInnerHTML"]
    const s_dangerously_set_inner_html: &extern;
    #[import = ""]
    const s_empty: &extern;
    #[import = "PROGRESS"]
    const s_progress_tag: &extern;
    #[import = "SELECT"]
    const s_select_tag: &extern;
    #[import = "svg"]
    const s_svg: &extern;
    #[import = "math"]
    const s_math: &extern;
    #[import = "foreignobject"]
    const s_foreign_object_lower: &extern;
    #[import = "http://www.w3.org/1999/xhtml"]
    const s_html_ns: &extern;
    #[import = "http://www.w3.org/2000/svg"]
    const s_svg_ns: &extern;
    #[import = "http://www.w3.org/1998/Math/MathML"]
    const s_math_ns: &extern;
    #[import = "className"]
    const s_class_name: &extern;
    #[import = "class"]
    const s_class: &extern;
    #[import = "htmlFor"]
    const s_html_for: &extern;
    #[import = "for"]
    const s_for: &extern;
    // DOM properties that must be set as attributes.
    #[import = "width"]
    const s_width: &extern;
    #[import = "height"]
    const s_height: &extern;
    #[import = "href"]
    const s_href: &extern;
    #[import = "list"]
    const s_list: &extern;
    #[import = "form"]
    const s_form: &extern;
    #[import = "tabIndex"]
    const s_tab_index: &extern;
    #[import = "download"]
    const s_download: &extern;
    #[import = "rowSpan"]
    const s_row_span: &extern;
    #[import = "colSpan"]
    const s_col_span: &extern;
    #[import = "role"]
