// The DOM, as the host gives it: the DomNode trait of tutuca-mb's
// vdom/dom.mbt, flattened so that nothing but nodes, strings, numbers and
// booleans crosses the boundary (NOTES.md has the mapping).
//
// What its externrefs hold, as js_string names strings: a node (an element,
// text, comment or fragment), the document nodes are made in, an event. A
// Value the host is given or gives back crosses as an externref too, a
// `value_extern`: `v as &extern` going out, `as &any as &value` coming back.
type dom_node = &extern;
type dom_node_opt = &?extern;
type dom_document = &extern;
type dom_document_opt = &?extern;
type dom_event = &extern;
type value_extern = &extern;

import "dom" {
    #[import = "create_element"]
    fn dom_create_element(doc: dom_document, tag_name: js_string, ns: js_string_opt, is_attr: js_string_opt) -> dom_node;
    #[import = "create_text"]
    fn dom_create_text(doc: dom_document, text: js_string) -> dom_node;
    #[import = "create_comment"]
    fn dom_create_comment(doc: dom_document, text: js_string) -> dom_node;
    #[import = "create_fragment"]
    fn dom_create_fragment(doc: dom_document) -> dom_node;

    #[import = "append_child"]
    fn dom_append_child(parent: dom_node, child: dom_node);
    // Appends when ref_node is null.
    #[import = "insert_before"]
    fn dom_insert_before(parent: dom_node, node: dom_node, ref_node: dom_node_opt);
    #[import = "remove_child"]
    fn dom_remove_child(parent: dom_node, child: dom_node);
    #[import = "replace_child"]
    fn dom_replace_child(parent: dom_node, node: dom_node, old: dom_node);
    // replaceChildren() with no arguments: removes every child.
    #[import = "replace_children"]
    fn dom_replace_children(node: dom_node);
    #[import = "parent_node"]
    fn dom_parent_node(node: dom_node) -> dom_node_opt;
    #[import = "previous_sibling"]
    fn dom_previous_sibling(node: dom_node) -> dom_node_opt;
    // A comment's text, or null for any other node.
    #[import = "comment_data"]
    fn dom_comment_data(node: dom_node) -> js_string_opt;
    // An element's data-eid as a number, -1 when it has none.
    #[import = "get_eid"]
    fn dom_get_eid(node: dom_node) -> i32;
    // The value of the element with a handler, as a Value (a wasm value the
    // host made through the exports): checked for a checkbox, value otherwise.
    #[import = "target_value"]
    fn dom_target_value(node: dom_node) -> value_extern;
    #[import = "first_child"]
    fn dom_first_child(node: dom_node) -> dom_node_opt;
    #[import = "next_sibling"]
    fn dom_next_sibling(node: dom_node) -> dom_node_opt;
    // Identity: externrefs can't be compared inside wasm.
    #[import = "is_same_node"]
    fn dom_is_same_node(a: dom_node, b: dom_node) -> i32;

    #[import = "set_attribute_string"]
    fn dom_set_attribute_string(node: dom_node, name: js_string, value: js_string);
    #[import = "set_attribute_number"]
    fn dom_set_attribute_number(node: dom_node, name: js_string, value: f64);
    #[import = "set_attribute_bool"]
    fn dom_set_attribute_bool(node: dom_node, name: js_string, value: i32);
    // setAttribute with an opaque object: String(value).
    #[import = "set_attribute_ref"]
    fn dom_set_attribute_ref(node: dom_node, name: js_string, value: value_extern);
    #[import = "remove_attribute"]
    fn dom_remove_attribute(node: dom_node, name: js_string);
    // `name in node`: whether a prop is set as a property or an attribute.
    #[import = "has_property"]
    fn dom_has_property(node: dom_node, name: js_string) -> i32;
    // node[name] = value; 0 when the assignment threw.
    #[import = "set_string_property"]
    fn dom_set_string_property(node: dom_node, name: js_string, value: js_string) -> i32;
    #[import = "set_number_property"]
    fn dom_set_number_property(node: dom_node, name: js_string, value: f64) -> i32;
    #[import = "set_bool_property"]
    fn dom_set_bool_property(node: dom_node, name: js_string, value: i32) -> i32;
    // A list, map, result or component, as the opaque object it is.
    #[import = "set_ref_property"]
    fn dom_set_ref_property(node: dom_node, name: js_string, value: value_extern) -> i32;
    #[import = "get_inner_html"]
    fn dom_get_inner_html(node: dom_node) -> js_string;
    #[import = "set_inner_html"]
    fn dom_set_inner_html(node: dom_node, html: js_string);
    // Text and comment character data.
    #[import = "set_data"]
    fn dom_set_data(node: dom_node, text: js_string);
    // Uppercase for HTML elements, as in the DOM.
    #[import = "tag_name"]
    fn dom_tag_name(node: dom_node) -> js_string;
    // null for nodes without one.
    #[import = "namespace_uri"]
    fn dom_namespace_uri(node: dom_node) -> js_string_opt;

    // The nodes render made (a WeakSet on the host). Morphing matches vnodes
    // to these only, so nodes other code put in a rendered element don't
    // shift the match, and stay.
    #[import = "own"]
    fn dom_own(node: dom_node);
    #[import = "is_owned"]
    fn dom_is_owned(node: dom_node) -> i32;

    // Drag and drop: the closest element with draggable="true", or null;
    // node.dataset[name], or null when unset; setting and deleting it.
    #[import = "closest_draggable"]
    fn dom_closest_draggable(node: dom_node) -> dom_node_opt;
    #[import = "dataset_get"]
    fn dom_dataset_get(node: dom_node, name: js_string) -> js_string_opt;
    #[import = "dataset_set"]
    fn dom_dataset_set(node: dom_node, name: js_string, value: js_string);
    #[import = "dataset_delete"]
    fn dom_dataset_delete(node: dom_node, name: js_string);
    // Whether node is container or inside it; 0 for null.
    #[import = "contains"]
    fn dom_contains(container: dom_node, node: dom_node_opt) -> i32;
    // The event's: preventDefault(), its relatedTarget, and its dataTransfer
    // (when it has one) set up for a move: data, so Firefox starts the drag,
    // and the effect allowed at dragstart; the drop effect over a target.
    #[import = "prevent_default"]
    fn dom_prevent_default(e: dom_event);
    #[import = "stop_propagation"]
    fn dom_stop_propagation(e: dom_event);
    #[import = "related_target"]
    fn dom_related_target(e: dom_event) -> dom_node_opt;
    #[import = "drag_start"]
    fn dom_drag_start(e: dom_event);
    #[import = "drop_effect_move"]
    fn dom_drop_effect_move(e: dom_event);

    // Throws a JS Error with this message; never returns.
    #[import = "fail"]
    fn host_fail(message: js_string);
}

// The world, as the host gives it (MessageContext's now, random and uuid), so
// a run can be repeated by a host that gives the same answers.
import "env" {
    #[import = "now"]
    fn env_now() -> f64;
    #[import = "random"]
    fn env_random() -> f64;
    #[import = "uuid"]
    fn env_uuid() -> js_string;
}

// What the host is told while it runs tasks, and asks it answers.
import "host" {
    // A handler's log: a Value, as an externref.
    #[import = "observe_log"]
    fn observe_log(v: value_extern);
    // A message the component has no handler for: it stays as it was.
    #[import = "observe_unhandled"]
    fn observe_unhandled(name: js_string);
    // An ask the host answers (see scope_register_host_ask): its name and its
    // arguments as a list Value. Returns its answer: a result value when it
    // answers now, an int, the id host_settle gets back, when it answers
    // later, or null when the host has no answer for it.
    #[import = "ask"]
    fn host_ask(name: js_string, args: value_extern) -> &value;
    // A float as JS's String(n) writes it, for rendering it as text.
    #[import = "number_text"]
    fn host_number_text(n: f64) -> js_string;
    // Whether s matches the regular expression pattern (a pattern constraint).
    #[import = "regex_test"]
    fn host_regex_test(pattern: js_string, s: js_string) -> i32;
    // Throws a JS Error with this message whose rejection is info (a Value):
    // a message a component rejected, with why; never returns.
    #[import = "reject"]
    fn host_reject(message: js_string, info: value_extern);
    // What dev mode found: kind is stateInvalid or messageInvalid, info a Value.
    #[import = "observe_issue"]
    fn observe_issue(kind: js_string, info: value_extern);
    // Text as JS's Number(text) reads it, NaN for blank text.
    #[import = "parse_number"]
    fn host_parse_number(text: js_string) -> f64;
}
