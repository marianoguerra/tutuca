// The host (NOTES.md; tutuca's src/core/host.js and src/core/tree-binding.js; the spec's
// system/host.rkt): the root state and a queue of tasks, run one at a time,
// each as one transaction. The handler runs on the component the task's route
// reaches, its effects become child tasks, the new root is set, and every
// child's target freezes against the new root. A failure aborts the whole
// transaction: it throws (host_fail) or traps out of host_step before
// anything is committed, so the root stays, the child tasks are dropped, and
// the JS side, which calls host_step once per task, reports it. Only logs,
// observed as they come, survive, like any side effect in JS.

// What a task is: how it reaches its target and what it runs there. A
// fieldless enum that is only compared, so an i32.
const task_kind_plain = 0; // a send, a sendAt, a forwardAt
const task_kind_notify = 1; // handled, then sent on to the parent
const task_kind_ask = 2; // starts the scope's ask handler; its answer is a task of its own
const task_kind_event = 3; // an event on a rendered element
const task_kind_answer = 4; // an ask's answer, name.ok/.error/.unhandled, to the asker

// The element being dragged: where it was rendered, its data-dragtype and
// the value there when the drag started.
type drag = { path: &dispatch_path, drag_type: js_string_opt, node: dom_node, value: &value };

type task = {
    kind: i32,
    name: js_string,
    // A progress message's are set as it runs (watch_progress_args).
    args: mut &value_array,
    // The sender (tutuca's from): the route of the component that sent it,
    // its path and its identity then; for what comes from outside the tree
    // (a host send, an event, an ask's answer), the host's, with from_host
    // set, which has no handlers to reply to.
    from: &route,
    from_host: i32,
    target: &target,
    // Where it goes (tutuca's to): fixed for events, replies, asks and
    // answers; every other task's is frozen from its target against the root
    // when its sender commits.
    route: mut &?route,
    // For event tasks: the event and what was being dragged when it happened
    // (null otherwise), and the element with the handler. Its arguments were
    // evaluated when it arrived.
    event: &value,
    drag: &?drag,
    node: dom_node_opt,
    // For notifications: whether a hop so far had a handler for it. One that
    // reaches the root with none is reported unhandled, once.
    any_hop_handled: mut i32,
    // For an ask and its answer: the request's id, which the answer's handler
    // reads as ctx.request; 0 otherwise.
    request: mut i32,
    // A notification's hop after its first: a bubble under way, which is one
    // turn, so an event that arrives waits behind it.
    hop: i32,
    // Its number, given as it's first queued (0 before), counted per host so
    // runs repeat; cause, the number of the task that sent it (0 for the
    // host's); origin, the number its chain started with.
    seq: mut i32,
    cause: i32,
    origin: mut i32,
    // The watch it's in (watch.wax), its sender's unless it opens one or is
    // detached; for a progress message, the watch it tells about; whether
    // its watch was cancelled before it ran (dropped).
    watch: mut &?watch,
    progress_of: mut &?watch,
    dropped: mut i32
};

type task_array = [mut &?task];
// A FIFO: the tasks a task queues run after the ones already queued.
type task_queue = { items: mut &task_array, head: mut i32, len: mut i32 };

fn task_queue_new() -> &task_queue {
    {task_queue| items: [task_array|null; 16], head: 0, len: 0 };
}

fn task_queue_push(q: &task_queue, t: &task) {
    if q.len == q.items.length() {
        let live = q.len - q.head;
        let size = live * 2 + 16;
        let bigger = [task_array|null; size];
        bigger.copy(0, q.items, q.head, live);
        q.items = bigger;
        q.head = 0;
        q.len = live;
    }
    q.items[q.len] = t;
    q.len = q.len + 1;
}

// t first, before what's queued: a notification's next hop, so a bubble's
// hops run back to back, and an ask's answer given now.
fn task_queue_push_front(q: &task_queue, t: &task) {
    if q.head == 0 {
        let live = q.len;
        let room = 16;
        let bigger = [task_array|null; live + room * 2];
        bigger.copy(room, q.items, 0, live);
        q.items = bigger;
        q.head = room;
        q.len = room + live;
    }
    q.head = q.head - 1;
    q.items[q.head] = t;
}

// t after the queued tasks a bubble under way has, ahead of the rest: an
// event's place (tutuca's Scheduler.arrive, the spec's env rule).
fn task_queue_arrive(q: &task_queue, t: &task) {
    let i = q.head;
    let more = 1;
    while more & (i <s q.len) {
        if (q.items[i]!).hop {
            i += 1;
        } else {
            more = 0;
        }
    }
    if i == q.head {
        task_queue_push_front(q, t);
        return;
    }
    // Room for one more at the back, then the ones from i move up one.
    task_queue_push(q, t);
    let j = q.len - 1;
    while j >s i {
        q.items[j] = q.items[j - 1];
        j -= 1;
    }
    q.items[i] = t;
}

fn task_queue_pop(q: &task_queue) -> &?task {
    if q.head == q.len {
        return null;
    }
    let t = q.items[q.head];
    q.items[q.head] = null;
    q.head = q.head + 1;
    if q.head == q.len {
        q.head = 0;
        q.len = 0;
    }
    t;
}

// An ask whose answer hasn't arrived: the answer goes to the asker, as it
// was when it asked, and is caused by the ask.
type pending_reply = {
    id: i32,
    name: js_string,
    asker: &route,
    request: i32,
    cause: i32,
    origin: i32,
    // The ask, whose watch its answer is in.
    ask: &task
};

// A host renders into container, in doc; a headless host has neither, and
// only runs tasks (for tests and tools).
type host = {
    doc: dom_document_opt,
    container: dom_node_opt,
    root: mut &value,
    queue: &task_queue,
    // The pending_replies of asks answered later.
    pending: mut &pv_vector,
    // What the last render rendered, and from which root.
    rendered: mut &?vnode_array,
    rendered_root: mut &?value,
    // The element being dragged, from dragstart to dragend, and the drop
    // target marked with data-draggingover.
    drag: mut &?drag,
    drag_over: mut dom_node_opt,
    // The event names host_new_event_names gave, as keys.
    listening: mut &phm_map,
    // Dev mode: check the state against its schemas after each task, and
    // the invariants of what changed when the queue settles, from the root
    // as of the last time it did; and messages against their contracts.
    // What fails is reported through observe_issue.
    dev: mut i32,
    settled_root: mut &value,
    // The path from the root of the component the task running (or the last
    // one run) is for, as a list of keys (names and indices); null while
    // rendering. What's reported, a log, an issue, a failure, came from there.
    at: mut &value,
    // The number the last task queued got.
    seqs: mut i32,
    // What became of the task host_step last ran (tutuca's Transition):
    // the task, its outcome (transition_*), what its handler sent ({ kind,
    // name, args } each) and the messages it made that nobody handles.
    cur: mut &?task,
    outcome: mut i32,
    emitted: mut &value,
    unhandled: mut &value,
    // The ids of the asks and watches made in its tasks, counted per host so
    // runs repeat; the watches that haven't settled; and the records for
    // host.listen made besides each task's transition (a dropped task's, a
    // watch opening and settling), until the JS side takes them.
    ids: &id_counter,
    watches: mut &pv_vector,
    events: mut &value,
    // Whether renders reuse what the last one rendered where nothing it
    // depends on changed (render.wax's cache), and its entries.
    render_cache: mut i32,
    cache_tree: mut &cache_children,
    cache_stats: &cache_stats
};

// What became of a task (tutuca's TRANSITION_OUTCOMES, but failed, which
// the JS side sees as host_step throws, and lost, dropped, which can't
// happen here yet). A fieldless enum that is only compared, so an i32.
const transition_handled = 0; // its handler ran
const transition_passed = 1; // a notification's hop with no handler, which passes it on
const transition_unhandled = 2; // nobody handles it
const transition_stale = 3; // another component took the place it was for
const transition_orphaned = 4; // no component is at the place it was for
const transition_asked = 5; // an ask, handed to its handler

fn empty_selector() -> &selector {
    {selector| steps: [selector_step_array|null; 0] };
}

fn empty_args() -> &value_array {
    [value_array|null; 0];
}

fn root_dispatch_path() -> &dispatch_path {
    {dispatch_path| frames: [frame_array|null; 0] };
}

// The host's address (tutuca's HOST): the root's parent, what host sends,
// events and ask answers come from. It has no handlers.
fn host_route() -> &route {
    route_for(root_dispatch_path());
}

fn host_new(doc: dom_document_opt, container: dom_node_opt, root: &value) -> &host {
    {host|
        doc,
        container,
        root,
        queue: task_queue_new(),
        pending: pv_empty(),
        rendered: null,
        rendered_root: null,
        drag: null,
        drag_over: null,
        listening: smap_empty(),
        dev: 0,
        settled_root: root,
        at: VALUE_NULL,
        seqs: 0,
        cur: null,
        outcome: transition_handled,
        emitted: VALUE_NULL,
        unhandled: VALUE_NULL,
        ids: {id_counter| n: 0 },
        watches: pv_empty(),
        events: list_empty(),
        render_cache: 1,
        cache_tree: cache_children_new(),
        cache_stats: {cache_stats| hits: 0, misses: 0 },
    };
}

// A task from the component at from to target, sent by cause (its number
// and its origin's), with no route yet.
fn task_new(
    kind: i32,
    name: js_string,
    args: &value_array,
    from: &route,
    target: &target,
    cause: &task,
) -> &task {
    {task|
        kind,
        name,
        args,
        from,
        from_host: 0,
        target,
        route: null,
        event: VALUE_NULL,
        drag: null,
        node: null,
        any_hop_handled: 0,
        request: 0,
        hop: 0,
        seq: 0,
        cause: cause.seq,
        origin: cause.origin,
        watch: cause.watch,
        progress_of: null,
        dropped: 0,
    };
}

// A task from the host to target: the first of its chain.
fn host_task(kind: i32, name: js_string, args: &value_array, target: &target) -> &task {
    {task|
        kind,
        name,
        args,
        from: host_route(),
        from_host: 1,
        target,
        route: null,
        event: VALUE_NULL,
        drag: null,
        node: null,
        any_hop_handled: 0,
        request: 0,
        hop: 0,
        seq: 0,
        cause: 0,
        origin: 0,
        watch: null,
        progress_of: null,
        dropped: 0,
    };
}

// A notification's next hop: the same message from the same sender, to the
// parent, remembering whether a hop so far handled it.
fn task_notify_hop(t: &task, parent: &target, any_hop_handled: i32) -> &task {
    {task|
        kind: task_kind_notify,
        name: t.name,
        args: t.args,
        from: t.from,
        from_host: t.from_host,
        target: parent,
        route: null,
        event: VALUE_NULL,
        drag: null,
        node: null,
        any_hop_handled,
        request: 0,
        hop: 1,
        seq: 0,
        cause: t.seq,
        origin: t.origin,
        watch: t.watch,
        progress_of: null,
        dropped: 0,
    };
}

// The task with its route: frozen from its target against root unless fixed.
fn task_prepare(t: &task, root: &value) -> &task {
    if !t.route {
        t.route = route_at(target_freeze(t.target, root), root);
    }
    t;
}

// Numbers t as it's first queued (tutuca's Scheduler.enter), the first of
// its chain when nothing sent it, and counts it in its watch; 0 when its
// watch was cancelled, so it isn't queued.
fn host_enter(h: &host, t: &task) -> i32 {
    if t.seq == 0 {
        h.seqs = h.seqs + 1;
        t.seq = h.seqs;
        if t.origin == 0 {
            t.origin = t.seq;
        }
    }
    watch_enter(h, t);
}

// Queues a task at the back, freezing its target against the current root.
fn host_push(h: &host, t: &task) {
    let prepared = task_prepare(t, h.root);
    if host_enter(h, prepared) {
        task_queue_push(h.queue, prepared);
    }
}

// A message from the host to the component sel reaches from the root, its
// number. Sent now (as an event is: tutuca's send with now, the spec's env
// rule) it goes ahead of the queue, behind a bubble under way; otherwise at
// the back.
fn host_send(h: &host, name: js_string, args: &value_array, sel: &selector, now: i32) -> i32 {
    let t =
        host_task(
            task_kind_plain,
            name,
            args,
            {target| base: root_dispatch_path(), selector: sel },
        );
    let queued = task_prepare(t, h.root);
    // A task from the host is in no watch: it's always queued.
    if host_enter(h, queued) {
        if now {
            task_queue_arrive(h.queue, queued);
        } else {
            task_queue_push(h.queue, queued);
        }
    }
    t.seq;
}

// a's steps, then b's.
fn selector_join(a: &selector, b: &selector) -> &selector {
    let steps = [selector_step_array|null; a.steps.length() + b.steps.length()];
    steps.copy(0, a.steps, 0, a.steps.length());
    steps.copy(a.steps.length(), b.steps, 0, b.steps.length());
    {selector| steps };
}

fn host_has_tasks(h: &host) -> i32 {
    h.queue.head != h.queue.len;
}

// Runs the next task as one transaction; 0 when there was none. The task
// leaves the queue first, so a task that fails is dropped.
fn host_step(h: &host) -> i32 {
    let t = task_queue_pop(h.queue);
    if !t {
        return 0;
    }
    h.cur = t;
    h.outcome = transition_handled;
    h.emitted = list_empty();
    h.unhandled = list_empty();
    // A progress message says how its watch is when it runs.
    if !!(t!).progress_of {
        (t!).args = watch_progress_args((t!).progress_of!);
    }
    let tx =
        {transaction|
            children: [task_array|null; 4],
            count: 0,
            next_hop: null,
            pending: h.pending,
            issues: list_empty(),
            cancels: list_empty(),
            ask_pending: 0,
        };
    let prev = h.root;
    let root = host_transaction(h, t!, tx);
    // Commit: nothing above threw.
    h.root = root;
    h.pending = tx.pending;
    let i = 0;
    while i <s tx.count {
        let child = tx.children[i]!;
        if host_enter(h, child) {
            task_queue_push(h.queue, child);
        }
        i += 1;
    }
    // A bubble's hops run back to back; what each hop sends waits behind
    // them. An ask's answer given now runs next too.
    if !!tx.next_hop {
        if host_enter(h, tx.next_hop!) {
            task_queue_push_front(h.queue, tx.next_hop!);
        }
    }
    // The watches it cancels, once it committed; progress for the watches
    // it ran in; and it's done, but an ask whose answer is on its way.
    i = 0;
    while i <s list_count(tx.cancels) {
        watch_cancel_id(h, (list_get(tx.cancels, i)! as &value_int).value, watch_cancelled);
        i += 1;
    }
    let ran =
        (h.outcome == transition_handled) | (h.outcome == transition_passed)
            | (h.outcome == transition_unhandled);
    if ran {
        watch_ran(h, t!);
    }
    if !tx.ask_pending {
        watch_leave(h, t!);
    }
    if h.dev {
        host_check_task(h, t!, prev, tx.issues);
    }
    1;
}

// What a transaction makes besides the new root, committed only if it ends:
// its child tasks, the asks pending, and in dev mode what the handler broke
// of its message's contract (a list of messageInvalid infos).
type transaction = {
    children: mut &task_array,
    count: mut i32,
    // A notification's next hop, which runs right after this task.
    next_hop: mut &?task,
    pending: mut &pv_vector,
    issues: mut &value,
    // The ids of the watches its handler cancels (ctx_cancel), and whether,
    // an ask, its answer is on its way.
    cancels: mut &value,
    ask_pending: mut i32
};

fn transaction_push(tx: &transaction, t: &task) {
    if tx.count == tx.children.length() {
        let bigger = [task_array|null; tx.count * 2];
        bigger.copy(0, tx.children, 0, tx.count);
        tx.children = bigger;
    }
    tx.children[tx.count] = t;
    tx.count = tx.count + 1;
}

// Whether s has a dot: only an answer's name does.
fn has_dot(s: js_string) -> i32 {
    let i = 0;
    let n = js_string_length(s);
    while i <s n {
        if js_string_char_code_at(s, i) == 46 {
            return 1;
        }
        i += 1;
    }
    0;
}

// The component at r in h's root, or null when r reaches none (orphaned,
// reported) or another took its place since r was fixed (stale: it was
// replaced, or a list shifted, so the message, for the one before, is
// dropped and reported): tutuca's Scheduler.receiver.
fn host_receiver(h: &host, t: &task, r: &route) -> &?component {
    let found = key_path_find(r.key_path, h.root);
    let c: &?component = null;
    if !!found {
        c = value_as_component(found!);
    }
    if !c {
        h.outcome = transition_orphaned;
        observe_orphaned(t.name);
        return null;
    }
    if (c!).id != r.id {
        h.outcome = transition_stale;
        observe_stale(t.name);
        return null;
    }
    c;
}

fn host_transaction(h: &host, t: &task, tx: &transaction) -> &value {
    let r = t.route!;
    h.at = key_path_value(r.key_path);
    // A notification starts from its sender, found as any address is.
    if (t.kind == task_kind_notify) & !t.hop & !t.from_host {
        if !host_receiver(h, t, t.from) {
            return h.root;
        }
    }
    let c = host_receiver(h, t, r);
    if !c {
        return h.root;
    }
    let comp = c!;
    let path = dispatch_path_to_component(r.path);
    // Only an ask's answer has a dotted name (name.ok): a message named so,
    // from a send or from outside, can't forge one.
    if (t.kind != task_kind_answer) & has_dot(t.name) {
        note_unhandled(h, t.name);
        h.outcome = transition_unhandled;
        return h.root;
    }
    // The child the message came through; for one from the host, such as
    // an event, the loop item it reached, below the component.
    let through = t.from.path;
    if t.from_host {
        through = r.path;
    }
    let ctx =
        {context|
            scope: comp.scope,
            path,
            source_key: dispatch_path_source_key_in(through, path),
            event: t.event,
            drag: drag_value(t.drag, path),
            effects: effect_buf_new(),
            request: t.request,
            ids: h.ids,
        };
    let args = t.args;
    // Where what the handler sends comes from: here, as this component.
    let me = {route| path, key_path: r.key_path, id: comp.id };
    // The message the component handles: the task's, or for an ask the reply
    // the ask's handler gives (none while it's pending).
    let msg: &?message = {message| name: t.name, args };
    if t.kind == task_kind_ask {
        msg = ask_reply(comp, t, args, ctx, tx);
    }
    // Its schema: arguments that don't fit it are rejected before the handler
    // sees them; in dev mode, its contract is checked around it.
    let ms: &?message_schema = null;
    let pre_held = 1;
    let result = MESSAGE_RESULT_UNCHANGED;
    if !!msg {
        let m = msg!;
        ms = spec_message_schema(comp.spec, m.name);
        if !!ms {
            check_message_args(comp, ms!, m.args);
            if h.dev & !!(ms!).pre {
                pre_held = ((ms!).pre!)(comp.instance, m.args, ctx);
            }
        }
        result = comp.vtable.handle(comp.instance, m, ctx);
    }
    // Effects first, so the logs of a handler that rejects its message are
    // observed, as a throwing handler's are.
    let stop = effect_tasks(h, t, args, ctx, me, tx);
    let leaf: &?value = null;
    if result.kind == message_result_kind_updated {
        let instance = (result as &message_result_updated).instance;
        leaf = value_component(component_updated(comp, instance));
    }
    if result.kind == message_result_kind_swapped {
        leaf = value_component((result as &message_result_swapped).component);
    }
    // Whether this component had a handler for the message.
    let handled = 1;
    if result.kind == message_result_kind_rejected {
        let error = (result as &message_result_rejected).error;
        if error.kind == message_error_kind_unknown_message {
            // A message the component doesn't handle, from an event or not:
            // the component stays as it was. A notification passes on
            // silently, and is reported only if it reaches the root unhandled;
            // any other message is reported here.
            handled = 0;
            if t.kind != task_kind_notify {
                note_unhandled(h, (msg!).name);
            }
        } else {
            reject_message(comp, (msg!).name, error);
            unreachable;
        }
    }
    if h.dev & !!ms {
        let next = comp;
        if !!leaf {
            next = value_as_component(leaf!)!;
        }
        check_message_contract(tx, t, msg!, comp, next, ms!, ctx, pre_held);
    }
    if (t.kind == task_kind_notify) & !stop {
        let any_handled = t.any_hop_handled | handled;
        if dispatch_path_is_root(path) {
            if !any_handled {
                note_unhandled(h, t.name);
            }
        } else {
            let parent = {target| base: dispatch_path_to_parent(path), selector: empty_selector() };
            tx.next_hop = task_notify_hop(t, parent, any_handled);
        }
    }
    // What became of it: an ask was handed to its handler; a message no
    // handler ran for is unhandled when nobody handles it, and passed on
    // otherwise (a notification's hop).
    if t.kind == task_kind_ask {
        h.outcome = transition_asked;
    } else {
        if !handled {
            h.outcome = transition_passed;
            if list_has_string(h.unhandled, t.name) {
                h.outcome = transition_unhandled;
            }
        }
    }
    // The same root when nothing changed, so nothing renders.
    let root = h.root;
    if !!leaf {
        root = key_path_set_in(r.key_path, h.root, leaf!);
    }
    let i = 0;
    while i <s tx.count {
        tx.children[i] = task_prepare(tx.children[i]!, root);
        i += 1;
    }
    if !!tx.next_hop {
        tx.next_hop = task_prepare(tx.next_hop!, root);
    }
    root;
}

// An ask's answer: a message from the host to the asker, routed to its
// path and its identity, so it reaches the asker or is dropped stale.
fn reply_task(
    name: js_string,
    args: &value_array,
    asker: &route,
    request: i32,
    cause: i32,
    origin: i32,
    watch: &?watch,
) -> &task {
    {task|
        kind: task_kind_answer,
        name,
        args,
        from: host_route(),
        from_host: 1,
        target: {target| base: asker.path, selector: empty_selector() },
        route: asker,
        event: VALUE_NULL,
        drag: null,
        node: null,
        any_hop_handled: 0,
        request,
        hop: 0,
        seq: 0,
        cause,
        origin,
        watch,
        progress_of: null,
        dropped: 0,
    };
}

// An ask runs no handler on the asker: what asked has committed, so it starts
// the scope's ask handler, and the answer comes back as a reply task of its
// own (name_reply_ok, name_reply_error or name_handler_not_found), which runs
// next, ahead of the queue; a pending answer's comes when it settles. Either
// way a reply that fails fails only itself. It gives no message to handle.
fn ask_reply(
    c: &component,
    t: &task,
    args: &value_array,
    ctx: &context,
    tx: &transaction,
) -> &?message {
    let found = scope_lookup_ask(c.scope, t.name);
    let answer = ask_result_not_found();
    if !!found {
        // An ask handler only answers: its context is the asker's, to read
        // (its scope, to list or make components), with effects of its own,
        // where only logs are allowed.
        let own =
            {context|
                scope: ctx.scope,
                path: ctx.path,
                source_key: ctx.source_key,
                event: ctx.event,
                drag: ctx.drag,
                effects: effect_buf_new(),
                request: ctx.request,
                ids: ctx.ids,
            };
        answer = (found!).handler(t.name, args, own);
        let i = 0;
        while i <s own.effects.len {
            let e = own.effects.items[i]!;
            if e.kind != effect_kind_log {
                host_fail(js_string_concat(s_err_ask_sends, t.name));
            }
            observe_log((e as &effect_log).value as &extern);
            i += 1;
        }
    }
    let asker = t.route!;
    if answer.kind == ask_result_kind_not_found {
        tx.next_hop =
            reply_task(
                js_string_concat(t.name, s_answer_unhandled),
                empty_args(),
                asker,
                t.request,
                t.seq,
                t.origin,
                t.watch,
            );
        return null;
    }
    if answer.kind == ask_result_kind_pending {
        let id = (answer as &ask_result_pending).id;
        tx.pending =
            pv_push(
                tx.pending,
                {pending_reply|
                    id,
                    name: t.name,
                    asker,
                    request: t.request,
                    cause: t.seq,
                    origin: t.origin,
                    ask: t,
                },
            );
        tx.ask_pending = 1;
        return null;
    }
    let result = (answer as &ask_result_reply).result as &value_result;
    let reply = [value_array|null; 1];
    reply[0] = result.value;
    let name = js_string_concat(t.name, result.ok?s_answer_ok:s_answer_error);
    tx.next_hop = reply_task(name, reply, asker, t.request, t.seq, t.origin, t.watch);
    null;
}

// The handler's effects, in order, as child tasks from me, the component
// that ran it; whether it stopped a notify. Logs are observed as they come.
fn effect_tasks(
    h: &host,
    t: &task,
    args: &value_array,
    ctx: &context,
    me: &route,
    tx: &transaction,
) -> i32 {
    let stop = 0;
    let here = ctx.path;
    let i = 0;
    while i <s ctx.effects.len {
        let e = ctx.effects.items[i]!;
        let kind = e.kind;
        if kind == effect_kind_notify {
            let n = e as &effect_notify;
            note_emitted(h, s_e_notify, n.name, n.args);
            if dispatch_path_is_root(here) {
                // The root has no ancestors: nobody can handle it.
                note_unhandled(h, n.name);
            } else {
                let parent =
                    {target| base: dispatch_path_to_parent(here), selector: empty_selector() };
                transaction_push(tx, task_new(task_kind_notify, n.name, n.args, me, parent, t));
            }
        }
        if kind == effect_kind_ask {
            let a = e as &effect_ask;
            note_emitted(h, s_e_ask, a.name, a.args);
            // To the asker as it is now: the answer comes back here.
            let ask =
                task_new(
                    task_kind_ask,
                    a.name,
                    a.args,
                    me,
                    {target| base: here, selector: empty_selector() },
                    t,
                );
            ask.route = me;
            ask.request = a.request;
            // Detached, the ask and its answer are in no watch.
            if a.detached {
                ask.watch = null;
            }
            transaction_push(tx, ask);
        }
        if kind == effect_kind_send_at {
            let s = e as &effect_send_at;
            note_emitted(h, s_e_send_at, s.name, s.args);
            let sent =
                task_new(
                    task_kind_plain,
                    s.name,
                    s.args,
                    me,
                    {target| base: here, selector: s.selector },
                    t,
                );
            // Detached it's in no watch; with a watch it opens one, inside
            // the one this task is in unless detached.
            if s.detached {
                sent.watch = null;
            }
            if s.watch_id != 0 {
                let outer = t.watch;
                if s.detached {
                    outer = null;
                }
                sent.watch =
                    watch_new(
                        s.watch_id,
                        me,
                        s.settled,
                        s.settled_args,
                        s.progress,
                        s.progress_args,
                        s.timeout,
                        outer,
                    );
            }
            transaction_push(tx, sent);
        }
        if kind == effect_kind_forward_at {
            let f = e as &effect_forward_at;
            note_emitted(h, s_e_send_at, t.name, args);
            transaction_push(
                tx,
                task_new(
                    task_kind_plain,
                    t.name,
                    args,
                    me,
                    {target| base: here, selector: f.selector },
                    t,
                ),
            );
        }
        if kind == effect_kind_reply {
            // To the sender, where and as it was when it sent the message (a
            // notification keeps its sender at every hop); the host has no
            // handlers, so one to it is unhandled.
            let rp = e as &effect_reply;
            note_emitted(h, s_e_reply, rp.name, rp.args);
            if t.from_host {
                note_unhandled(h, rp.name);
            } else {
                let reply =
                    task_new(
                        task_kind_plain,
                        rp.name,
                        rp.args,
                        me,
                        {target| base: t.from.path, selector: empty_selector() },
                        t,
                    );
                reply.route = t.from;
                transaction_push(tx, reply);
            }
        }
        if kind == effect_kind_cancel {
            tx.cancels = list_push(tx.cancels, value_int((e as &effect_cancel).id));
        }
        if kind == effect_kind_stop_next {
            stop = 1;
        }
        if kind == effect_kind_log {
            observe_log((e as &effect_log).value as &extern);
        }
        i += 1;
    }
    stop;
}

// A message nobody handles, made by the task running: observed, and kept
// for its transition.
fn note_unhandled(h: &host, name: js_string) {
    h.unhandled = list_push(h.unhandled, value_string(name));
    observe_unhandled(name);
}

// What the task running's handler sent, for its transition.
fn note_emitted(h: &host, kind: js_string, name: js_string, args: &value_array) {
    let m = map_assoc(map_empty(), s_kind, value_string(kind));
    m = map_assoc(m, s_name, value_string(name));
    h.emitted = list_push(h.emitted, map_assoc(m, s_args, values_to_list(args)));
}

fn list_has_string(list: &value, s: js_string) -> i32 {
    let i = 0;
    while i <s list_count(list) {
        let v = value_string_of(list_get(list, i)!);
        if !!v {
            if str_eq(v!, s) {
                return 1;
            }
        }
        i += 1;
    }
    0;
}

// A route as tutuca's Address reads: { path: its keys, id }; the host's,
// null.
fn route_value(r: &route, from_host: i32) -> &value {
    if from_host {
        return VALUE_NULL;
    }
    let m = map_assoc(map_empty(), s_path, key_path_value(r.key_path));
    map_assoc(m, s_id, value_int(r.id));
}

fn transition_outcome_name(o: i32) -> js_string {
    if o == transition_passed {
        return s_t_passed;
    }
    if o == transition_unhandled {
        return s_t_unhandled;
    }
    if o == transition_stale {
        return s_t_stale;
    }
    if o == transition_orphaned {
        return s_t_orphaned;
    }
    if o == transition_asked {
        return s_t_asked;
    }
    s_t_handled;
}

fn task_mode_name(t: &task) -> js_string {
    if t.kind == task_kind_notify {
        return s_e_notify;
    }
    if t.kind == task_kind_ask {
        return s_e_ask;
    }
    if t.kind == task_kind_answer {
        return s_t_answer;
    }
    s_t_send;
}

// What became of the task host_step last ran, as tutuca's Transition has
// it: { kind: "transition", seq, cause, origin, mode, name, args, from, to,
// outcome, emitted, unhandled, watch }, cause null for the host's, from
// null for the host, watch the id of the watch it ran in or null; outcome
// as of when host_step returned or threw (a task that throws failed, which
// the JS side says). Null before any task ran.
fn host_transition(h: &host) -> &value {
    if !h.cur {
        return VALUE_NULL;
    }
    task_transition_value(h.cur!, transition_outcome_name(h.outcome), h.emitted, h.unhandled);
}

fn task_transition_value(
    t: &task,
    outcome: js_string,
    emitted: &value,
    unhandled: &value,
) -> &value {
    let m = map_assoc(map_empty(), s_kind, value_string(s_transition));
    m = map_assoc(m, s_seq, value_int(t.seq));
    let cause = VALUE_NULL;
    if t.cause != 0 {
        cause = value_int(t.cause);
    }
    m = map_assoc(m, s_cause, cause);
    m = map_assoc(m, s_origin, value_int(t.origin));
    m = map_assoc(m, s_mode, value_string(task_mode_name(t)));
    m = map_assoc(m, s_name, value_string(t.name));
    m = map_assoc(m, s_args, values_to_list(t.args));
    m = map_assoc(m, s_from, route_value(t.from, t.from_host));
    let to = VALUE_NULL;
    if !!t.route {
        to = route_value(t.route!, 0);
    }
    m = map_assoc(m, s_to, to);
    m = map_assoc(m, s_outcome, value_string(outcome));
    m = map_assoc(m, s_emitted, emitted);
    m = map_assoc(m, s_unhandled_key, unhandled);
    let watch = VALUE_NULL;
    if !!t.watch {
        watch = value_int((t.watch!).id);
    }
    map_assoc(m, s_w_watch, watch);
}

// The records made besides the tasks' transitions since the last call, in
// order, and none after it.
fn host_take_events(h: &host) -> &value {
    let out = h.events;
    h.events = list_empty();
    out;
}

// Send arguments, evaluated on dispatch against the message context and the
// receiver: literals, the value of the element with the handler, the source
// key, a field of the receiver or of the item at the source key, or
// conditionals of those.
fn eval_args(
    args: &arg_array,
    ctx: &context,
    node: dom_node_opt,
    receiver: &component,
) -> &value_array {
    let out = [value_array|null; args.length()];
    let i = 0;
    while i <s args.length() {
        out[i] = eval_arg(args[i]!, ctx, node, receiver);
        i += 1;
    }
    out;
}

fn eval_arg(a: &arg, ctx: &context, node: dom_node_opt, receiver: &component) -> &value {
    let kind = a.kind;
    if kind == arg_kind_value {
        return (a as &arg_value).value;
    }
    if kind == arg_kind_target_value {
        if !node {
            return VALUE_NULL;
        }
        return dom_target_value(node!) as &any as &value;
    }
    if kind == arg_kind_source_key {
        if !ctx.source_key {
            return VALUE_NULL;
        }
        return value_from_key(ctx.source_key!);
    }
    if kind == arg_kind_event {
        if ctx.event.kind != value_kind_map {
            return VALUE_NULL;
        }
        let found = map_get(ctx.event, (a as &arg_event).name);
        if !found {
            return VALUE_NULL;
        }
        return found!;
    }
    if kind == arg_kind_drag_key {
        if ctx.drag.kind != value_kind_map {
            return VALUE_NULL;
        }
        return map_get(ctx.drag, s_key)!;
    }
    if kind == arg_kind_field {
        let found = owner_field(receiver, (a as &arg_field).name);
        if !found {
            return VALUE_NULL;
        }
        return found!;
    }
    if kind == arg_kind_item_field {
        let f = a as &arg_item_field;
        let seq = owner_field(receiver, f.seq);
        if !seq | !ctx.source_key {
            return VALUE_NULL;
        }
        let item = get_key(seq!, ctx.source_key!);
        return get_key(item, path_key_name(f.name));
    }
    let c = a as &arg_if;
    if value_truthy(eval_arg(c.test, ctx, node, receiver)) {
        return eval_arg(c.then, ctx, node, receiver);
    }
    eval_arg(c.otherwise, ctx, node, receiver);
}

// Routes a DOM event, e, of type kind on target: queues the task of the
// handler it reaches, if any, from the host, with its route fixed now, its
// arguments evaluated now against the tree it happened on (tutuca's
// eventSend: one that fails fails the event, before anything is queued)
// and what is being dragged, ahead of the queue behind a bubble under way
// (the env rule). Its number when it reached one, 0 otherwise. The drop events reach the nearest
// enclosing component that handles them, so a drop on a child's elements
// gets to the parent's on:drop; before that, the drag they're about is
// tracked from dragstart to dragend.
fn host_dispatch_event(
    h: &host,
    e: dom_event,
    target: dom_node,
    kind: js_string,
    event: &value,
) -> i32 {
    if !h.container {
        return 0;
    }
    let container = h.container!;
    let bubbles = is_drop_event(kind);
    if str_eq(kind, s_dragstart) {
        host_start_drag(h, container, e, target);
    } else {
        if bubbles {
            host_drag_over(h, container, e, target, kind, event);
        }
    }
    let info = decode_event(container, target, kind, h.root, bubbles, event);
    let queued = 0;
    if !!info {
        let i = info!;
        if i.handler.mods & event_mod_prevent {
            dom_prevent_default(e);
        }
        if i.handler.mods & event_mod_stop {
            dom_stop_propagation(e);
        }
        let r = route_at(i.route.path, h.root);
        let path = dispatch_path_to_component(r.path);
        let receiver = value_as_component(key_path_get_in(r.key_path, h.root))!;
        let ctx =
            {context|
                scope: receiver.scope,
                path,
                source_key: dispatch_path_source_key_in(r.path, path),
                event,
                drag: drag_value(h.drag, path),
                effects: effect_buf_new(),
                request: 0,
                ids: h.ids,
            };
        let args = eval_args(i.handler.action.args, ctx, i.node, receiver);
        let t =
            {task|
                kind: task_kind_event,
                name: i.handler.action.name,
                args,
                from: host_route(),
                from_host: 1,
                target: {target| base: r.path, selector: empty_selector() },
                route: r,
                event,
                drag: h.drag,
                node: i.node,
                any_hop_handled: 0,
                request: 0,
                hop: 0,
                seq: 0,
                cause: 0,
                origin: 0,
                watch: null,
                progress_of: null,
                dropped: 0,
            };
        if host_enter(h, t) {
            task_queue_arrive(h.queue, t);
        }
        queued = t.seq;
    }
    if str_eq(kind, s_dragend) {
        host_end_drag(h);
    }
    queued;
}

// ---- Drag and drop (tutuca's src/core/drag.js and its Host's drag methods) --------

fn is_drop_event(kind: js_string) -> i32 {
    if str_eq(kind, s_dragenter) | str_eq(kind, s_dragover) {
        return 1;
    }
    str_eq(kind, s_dragleave) | str_eq(kind, s_drop);
}

// Remembers what is dragged: the closest draggable element, where it was
// rendered and its value.
fn host_start_drag(h: &host, container: dom_node, e: dom_event, target: dom_node) {
    let node = dom_closest_draggable(target);
    if !node {
        return;
    }
    let path = path_of(container, node!);
    if !path {
        return;
    }
    host_end_drag(h);
    let value = key_path_get_in(dispatch_path_to_key_path(path!), h.root);
    h.drag =
        {drag| path: path!, drag_type: dom_dataset_get(node!, s_dragtype), node: node!, value };
    dom_dataset_set(node!, s_dragging, s_empty);
    dom_drag_start(e);
}

// Over a drop target, an element with a drop handler, lets the drop happen
// and marks it: the browser shows a move cursor over a drop target, a
// not-allowed one elsewhere. A drag from outside the page (a file) is
// copied: the browser forbids moving most.
fn host_drag_over(
    h: &host,
    container: dom_node,
    e: dom_event,
    target: dom_node,
    kind: js_string,
    event: &value,
) {
    if str_eq(kind, s_drop) {
        dom_prevent_default(e);
        host_mark_drag_over(h, null);
        return;
    }
    if str_eq(kind, s_dragleave) {
        if !dom_contains(container, dom_related_target(e)) {
            host_mark_drag_over(h, null);
        }
        return;
    }
    let info = decode_event(container, target, s_drop, h.root, 1, event);
    if !info {
        host_mark_drag_over(h, null);
        return;
    }
    dom_prevent_default(e);
    dom_drop_effect(e, !h.drag?0:1);
    host_mark_drag_over(h, (info!).node);
}

// data-draggingover on the drop target node (none when null): the dragged
// element's data-dragtype, or "external".
fn host_mark_drag_over(h: &host, node: dom_node_opt) {
    if !node {
        if !h.drag_over {
            return;
        }
    } else {
        if !!h.drag_over {
            if dom_is_same_node(node!, h.drag_over!) {
                return;
            }
        }
    }
    if !!h.drag_over {
        dom_dataset_delete(h.drag_over!, s_draggingover);
    }
    h.drag_over = node;
    if !!node {
        let kind = s_external;
        if !!h.drag {
            let t = (h.drag!).drag_type;
            if !!t {
                kind = t!;
            }
        }
        dom_dataset_set(node!, s_draggingover, kind);
    }
}

fn host_end_drag(h: &host) {
    host_mark_drag_over(h, null);
    if !!h.drag {
        dom_dataset_delete((h.drag!).node, s_dragging);
    }
    h.drag = null;
}

// The key of receiver's child the dragged element is in, as the source key
// is for a message; null when it was dragged from outside receiver.
fn drag_key_in(d: &drag, receiver: &dispatch_path) -> &?path_key {
    dispatch_path_source_key_in(d.path, receiver);
}

// What a handler at receiver reads as ctx.drag: { type, value, key }, or null.
fn drag_value(d: &?drag, receiver: &dispatch_path) -> &value {
    if !d {
        return VALUE_NULL;
    }
    let dd = d!;
    let kind = VALUE_NULL;
    if !!dd.drag_type {
        kind = value_string(dd.drag_type!);
    }
    let key = VALUE_NULL;
    let found = drag_key_in(dd, receiver);
    if !!found {
        key = value_from_key(found!);
    }
    map_assoc(map_assoc(map_assoc(map_empty(), s_type, kind), s_value, dd.value), s_key, key);
}

// ---- Listening --------------------------------------------------------------

// The event names the types registered so far handle (in any scope:
// registered_event_names) that this host hasn't given before: the ones to
// start listening to. An event no component it renders handles finds no
// handler, and goes nowhere.
type event_names_acc = { listening: mut &phm_map, out: mut &value };

fn host_new_event_names(h: &host) -> &value {
    if !registered_event_names {
        return list_empty();
    }
    let acc = {event_names_acc| listening: h.listening, out: list_empty() };
    phm_each(registered_event_names!, acc, event_names_visit);
    h.listening = acc.listening;
    acc.out;
}

fn event_names_visit(context: &?eq, key: &?eq, item: &?eq) {
    let acc = context! as &event_names_acc;
    let name = (key! as &value_string).value;
    if !smap_get(acc.listening, name) {
        acc.listening = smap_assoc(acc.listening, name, value_null());
        acc.out = list_push(acc.out, value_string(name));
    }
}

// An ask answered later settled: its reply joins the queue, routed to the
// asker. result is a result value. 0 when the id isn't pending.
fn host_settle(h: &host, id: i32, result: &value) -> i32 {
    let n = pv_count(h.pending);
    let i = 0;
    while i <s n {
        let p = pv_at(h.pending, i)! as &pending_reply;
        if p.id == id {
            let rest = pv_empty();
            let j = 0;
            while j <s n {
                if j != i {
                    rest = pv_push(rest, pv_at(h.pending, j));
                }
                j += 1;
            }
            h.pending = rest;
            let r = result as &value_result;
            let reply = [value_array|null; 1];
            reply[0] = r.value;
            let name = js_string_concat(p.name, r.ok?s_answer_ok:s_answer_error);
            host_push(
                h,
                reply_task(name, reply, p.asker, p.request, p.cause, p.origin, p.ask.watch),
            );
            // The ask is done once its answer is queued.
            watch_leave(h, p.ask);
            return 1;
        }
        i += 1;
    }
    0;
}

// A key path as a list of its keys: names and indices.
fn key_path_value(p: &key_path) -> &value {
    let out = list_empty();
    let i = 0;
    while i <s p.keys.length() {
        out = list_push(out, value_from_key(p.keys[i]!));
        i += 1;
    }
    out;
}

// Renders the root if it changed since the last render: lowers its view and
// morphs the DOM from what the last render rendered; whether it did. A
// headless host renders nothing.
fn host_render(h: &host) -> i32 {
    h.at = VALUE_NULL;
    if !h.container | !h.doc {
        return 0;
    }
    if !!h.rendered_root {
        if h.rendered_root! == h.root {
            return 0;
        }
    }
    let level: &?cache_level = null;
    if h.render_cache {
        level = {cache_level| from: h.cache_tree, to: cache_children_new(), stats: h.cache_stats };
    }
    let vnodes = lower_all(render_root(h.root, level));
    // Rendered: what this render reached is the cache from now on.
    if !!level {
        h.cache_tree = (level!).to;
    }
    render(h.doc!, h.container!, vnodes, h.rendered);
    h.rendered = vnodes;
    h.rendered_root = h.root;
    1;
}

// ---- Applying from outside (tutuca's host.apply) --------------------------------------

// The route sel reaches from the root, fixed against it now (tutuca's
// addressOf).
fn host_route_at(h: &host, sel: &selector) -> &route {
    route_at(target_freeze({target| base: root_dispatch_path(), selector: sel }, h.root), h.root);
}

// Applies the pure message name(args) to the component sel reaches, at
// once, as a change from outside: no task, no queue (tutuca's host.apply).
// Its invariants are checked: a change that breaks them, or a broken
// contract, changes nothing. What component_try_apply gives: an ok result
// with the component it is now, or an error one ({ code, ... }; code
// not-component when nothing is there). Reported as a transition of mode
// apply, handled or failed.
fn host_apply(h: &host, name: js_string, args: &value_array, sel: &selector) -> &value {
    let r = host_route_at(h, sel);
    h.seqs = h.seqs + 1;
    let seq = h.seqs;
    let t =
        host_task(
            task_kind_plain,
            name,
            args,
            {target| base: root_dispatch_path(), selector: sel },
        );
    t.route = r;
    t.seq = seq;
    t.origin = seq;
    let result =
        value_try_apply(key_path_get_or_null(r.key_path, h.root), name, args, 1) as &value_result;
    let outcome = s_t_failed;
    if result.ok {
        outcome = s_t_handled;
        let next = result.value;
        if next != key_path_get_or_null(r.key_path, h.root) {
            h.root = key_path_set_in(r.key_path, h.root, next);
        }
    }
    let record = task_transition_value(t, outcome, list_empty(), list_empty());
    record = map_assoc(record, s_mode, value_string(s_t_apply));
    if !result.ok {
        record = map_assoc(record, s_error, result.value);
    }
    h.events = list_push(h.events, record);
    result;
}
