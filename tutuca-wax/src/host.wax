// The host (NOTES.md; tutuca's src/host.js and src/tasks.js; the spec's
// system/host.rkt): the root state and a queue of tasks, run one at a time,
// each as one transaction. The handler runs on the component the task's route
// reaches, its effects become child tasks, the new root is set, and every
// child's target freezes against the new root. A failure aborts the whole
// transaction: it throws (host_fail) or traps out of host_step before
// anything is committed, so the root stays, the child tasks are dropped, and
// the JS side, which calls host_step once per task, reports it. Only logs,
// observed as they come, survive, like any side effect in JS.

// What a task is: how it reaches its target and what it runs there. A
// fieldless enum that is only compared, so an i32.
const task_kind_plain = 0; // a send, a sendAt, a forwardAt
const task_kind_notify = 1; // handled, then sent on to the parent
const task_kind_ask = 2; // starts the scope's ask handler; its answer is a task of its own
const task_kind_event = 3; // an event on a rendered element
const task_kind_answer = 4; // an ask's answer, name.ok/.error/.unhandled, to the asker

// The element being dragged: where it was rendered, its data-dragtype and
// the value there when the drag started.
type drag = { path: &dispatch_path, drag_type: js_string_opt, node: dom_node, value: &value };

type task = {
    kind: i32,
    name: js_string,
    args: &value_array,
    // The dispatch path of the component that sent it.
    source: &dispatch_path,
    target: &target,
    // Fixed for events and async replies; every other task's is frozen from
    // its target against the root when it's queued.
    route: &?route,
    // For event tasks: the event and what was being dragged when it
    // happened (null otherwise), the action's arguments, evaluated when the
    // task runs, and the element with the handler, whose value a
    // target-value argument reads.
    event: &value,
    drag: &?drag,
    action_args: &?arg_array,
    node: dom_node_opt,
    // For notifications: whether a hop so far had a handler for it. One that
    // reaches the root with none is reported unhandled, once.
    handled: mut i32,
    // For an ask and its answer: the request's id, which the answer's handler
    // reads as ctx.request; 0 otherwise.
    request: mut i32
};

type task_array = [mut &?task];
// A FIFO: the tasks a task queues run after the ones already queued.
type task_queue = { items: mut &task_array, head: mut i32, len: mut i32 };

fn task_queue_new() -> &task_queue {
    {task_queue| items: [task_array|null; 16], head: 0, len: 0 };
}

fn task_queue_push(q: &task_queue, t: &task) {
    if q.len == q.items.length() {
        let live = q.len - q.head;
        let size = live * 2 + 16;
        let bigger = [task_array|null; size];
        bigger.copy(0, q.items, q.head, live);
        q.items = bigger;
        q.head = 0;
        q.len = live;
    }
    q.items[q.len] = t;
    q.len = q.len + 1;
}

// t first, before what's queued: a notification's next hop, so a bubble's
// hops run back to back.
fn task_queue_push_front(q: &task_queue, t: &task) {
    if q.head == 0 {
        let live = q.len;
        let room = 16;
        let bigger = [task_array|null; live + room * 2];
        bigger.copy(room, q.items, 0, live);
        q.items = bigger;
        q.head = room;
        q.len = room + live;
    }
    q.head = q.head - 1;
    q.items[q.head] = t;
}

fn task_queue_pop(q: &task_queue) -> &?task {
    if q.head == q.len {
        return null;
    }
    let t = q.items[q.head];
    q.items[q.head] = null;
    q.head = q.head + 1;
    if q.head == q.len {
        q.head = 0;
        q.len = 0;
    }
    t;
}

// An ask whose reply hasn't arrived: the reply goes to the asker.
// asker: the identity of the component that asked, for the reply's route.
type pending_reply = {
    id: i32,
    name: js_string,
    source: &dispatch_path,
    asker: i32,
    request: i32
};

// A host renders into container, in doc; a headless host has neither, and
// only runs tasks (for tests and tools).
type host = {
    doc: dom_document_opt,
    container: dom_node_opt,
    root: mut &value,
    queue: &task_queue,
    // The pending_replies of asks answered later.
    pending: mut &pv_vector,
    // What the last render rendered, and from which root.
    rendered: mut &?vnode_array,
    rendered_root: mut &?value,
    // The element being dragged, from dragstart to dragend, and the drop
    // target marked with data-draggingover.
    drag: mut &?drag,
    drag_over: mut dom_node_opt,
    // The event names host_new_event_names gave, as keys.
    listening: mut &phm_map,
    // Dev mode: check the state against its schemas after each task, and
    // the invariants of what changed when the queue settles, from the root
    // as of the last time it did; and messages against their contracts.
    // What fails is reported through observe_issue.
    dev: mut i32,
    settled_root: mut &value,
    // The path from the root of the component the task running (or the last
    // one run) is for, as a list of keys (names and indices); null while
    // rendering. What's reported, a log, an issue, a failure, came from there.
    at: mut &value
};

fn empty_selector() -> &selector {
    {selector| steps: [selector_step_array|null; 0] };
}

fn empty_args() -> &value_array {
    [value_array|null; 0];
}

fn host_new(doc: dom_document_opt, container: dom_node_opt, root: &value) -> &host {
    {host|
        doc,
        container,
        root,
        queue: task_queue_new(),
        pending: pv_empty(),
        rendered: null,
        rendered_root: null,
        drag: null,
        drag_over: null,
        listening: smap_empty(),
        dev: 0,
        settled_root: root,
        at: VALUE_NULL,
    };
}

// A task to target, with no route yet.
fn task_new(
    kind: i32,
    name: js_string,
    args: &value_array,
    source: &dispatch_path,
    target: &target,
) -> &task {
    {task|
        kind,
        name,
        args,
        source,
        target,
        route: null,
        event: VALUE_NULL,
        drag: null,
        action_args: null,
        node: null,
        handled: 0,
        request: 0,
    };
}

// The task with its route: frozen from its target against root unless fixed.
// A notification's next hop: the same message from the same sender, to the
// parent, remembering whether a hop so far handled it.
fn task_notify_hop(t: &task, parent: &target, handled: i32) -> &task {
    let next = task_new(task_kind_notify, t.name, t.args, t.source, parent);
    next.handled = handled;
    next;
}

fn task_prepare(t: &task, root: &value) -> &task {
    if !!t.route {
        return t;
    }
    {task|
        kind: t.kind,
        name: t.name,
        args: t.args,
        source: t.source,
        target: t.target,
        route: route_at(target_freeze(t.target, root), root),
        event: t.event,
        drag: t.drag,
        action_args: t.action_args,
        node: t.node,
        handled: t.handled,
        request: t.request,
    };
}

// Queues a task, freezing its target against the current root.
fn host_push(h: &host, t: &task) {
    task_queue_push(h.queue, task_prepare(t, h.root));
}

// A message to the root component, from outside it.
fn host_send(h: &host, name: js_string, args: &value_array) {
    let root_path = {dispatch_path| frames: [frame_array|null; 0] };
    host_push(
        h,
        task_new(
            task_kind_plain,
            name,
            args,
            root_path,
            {target| base: root_path, selector: empty_selector() },
        ),
    );
}

// A message to the component the selector reaches from the root, from
// outside it.
fn host_send_at(h: &host, name: js_string, args: &value_array, sel: &selector) {
    let root_path = {dispatch_path| frames: [frame_array|null; 0] };
    host_push(
        h,
        task_new(task_kind_plain, name, args, root_path, {target| base: root_path, selector: sel }),
    );
}

// a's steps, then b's.
fn selector_join(a: &selector, b: &selector) -> &selector {
    let steps = [selector_step_array|null; a.steps.length() + b.steps.length()];
    steps.copy(0, a.steps, 0, a.steps.length());
    steps.copy(a.steps.length(), b.steps, 0, b.steps.length());
    {selector| steps };
}

fn host_has_tasks(h: &host) -> i32 {
    h.queue.head != h.queue.len;
}

// Runs the next task as one transaction; 0 when there was none. The task
// leaves the queue first, so a task that fails is dropped.
fn host_step(h: &host) -> i32 {
    let t = task_queue_pop(h.queue);
    if !t {
        return 0;
    }
    let tx =
        {transaction|
            children: [task_array|null; 4],
            count: 0,
            next_hop: null,
            pending: h.pending,
            issues: list_empty(),
        };
    let prev = h.root;
    let root = host_transaction(h, t!, tx);
    // Commit: nothing above threw.
    h.root = root;
    h.pending = tx.pending;
    let i = 0;
    while i <s tx.count {
        task_queue_push(h.queue, tx.children[i]!);
        i += 1;
    }
    // A bubble's hops run back to back; what each hop sends waits behind them.
    if !!tx.next_hop {
        task_queue_push_front(h.queue, tx.next_hop!);
    }
    if h.dev {
        host_check_task(h, t!, prev, tx.issues);
    }
    1;
}

// What a transaction makes besides the new root, committed only if it ends:
// its child tasks, the asks pending, and in dev mode what the handler broke
// of its message's contract (a list of messageInvalid infos).
type transaction = {
    children: mut &task_array,
    count: mut i32,
    // A notification's next hop, which runs right after this task.
    next_hop: mut &?task,
    pending: mut &pv_vector,
    issues: mut &value
};

fn transaction_push(tx: &transaction, t: &task) {
    if tx.count == tx.children.length() {
        let bigger = [task_array|null; tx.count * 2];
        bigger.copy(0, tx.children, 0, tx.count);
        tx.children = bigger;
    }
    tx.children[tx.count] = t;
    tx.count = tx.count + 1;
}

// Whether s has a dot: only an answer's name does.
fn has_dot(s: js_string) -> i32 {
    let i = 0;
    let n = js_string_length(s);
    while i <s n {
        if js_string_char_code_at(s, i) == 46 {
            return 1;
        }
        i += 1;
    }
    0;
}

fn host_transaction(h: &host, t: &task, tx: &transaction) -> &value {
    let r = t.route!;
    h.at = update_path_value(r.update_path);
    let c = value_as_component(update_path_get_in(r.update_path, h.root));
    if !c {
        host_fail(js_string_concat(s_err_not_a_component, t.name));
        unreachable;
    }
    let comp = c!;
    // Another component took its place (it was replaced, or a list shifted):
    // the message was for the one before, so it's dropped and reported, not
    // given to this one.
    if (r.id != 0) & (comp.id != r.id) {
        observe_stale(t.name);
        return h.root;
    }
    let path = dispatch_path_to_component(r.path);
    // Only an ask's answer has a dotted name (name.ok): a message named so,
    // from a send or from outside, can't forge one.
    if (t.kind != task_kind_answer) & has_dot(t.name) {
        observe_unhandled(t.name);
        return h.root;
    }
    let ctx =
        {context|
            scope: comp.scope,
            path,
            source_key: dispatch_path_source_key_in(t.source, path),
            event: t.event,
            drag: drag_value(t.drag, path),
            effects: effect_buf_new(),
            request: t.request,
        };
    let args = t.args;
    if !!t.action_args {
        args = eval_args(t.action_args!, ctx, t.node, comp);
    }
    // The message the component handles: the task's, or for an ask the reply
    // the ask's handler gives (none while it's pending).
    let msg: &?message = {message| name: t.name, args };
    if t.kind == task_kind_ask {
        msg = ask_reply(comp, t, args, ctx, tx);
    }
    // Its schema: arguments that don't fit it are rejected before the handler
    // sees them; in dev mode, its contract is checked around it.
    let ms: &?message_schema = null;
    let pre_held = 1;
    let result = MESSAGE_RESULT_UNCHANGED;
    if !!msg {
        let m = msg!;
        ms = spec_message_schema(comp.spec, m.name);
        if !!ms {
            check_message_args(comp, ms!, m.args);
            if h.dev & !!(ms!).pre {
                pre_held = ((ms!).pre!)(comp.instance, m.args, ctx);
            }
        }
        result = comp.vtable.handle(comp.instance, m, ctx);
    }
    // Effects first, so the logs of a handler that rejects its message are
    // observed, as a throwing handler's are.
    let stop = effect_tasks(t, args, ctx, tx);
    let leaf: &?value = null;
    if result.kind == message_result_kind_updated {
        let instance = (result as &message_result_updated).instance;
        leaf = value_component(component_updated(comp, instance));
    }
    if result.kind == message_result_kind_swapped {
        leaf = value_component((result as &message_result_swapped).component);
    }
    // Whether this component had a handler for the message.
    let handled = 1;
    if result.kind == message_result_kind_rejected {
        let error = (result as &message_result_rejected).error;
        if error.kind == message_error_kind_unknown_message {
            // A message the component doesn't handle, from an event or not:
            // the component stays as it was. A notification passes on
            // silently, and is reported only if it reaches the root unhandled;
            // any other message is reported here.
            handled = 0;
            if t.kind != task_kind_notify {
                observe_unhandled((msg!).name);
            }
        } else {
            reject_message(comp, (msg!).name, error);
            unreachable;
        }
    }
    if h.dev & !!ms {
        let next = comp;
        if !!leaf {
            next = value_as_component(leaf!)!;
        }
        check_message_contract(tx, t, msg!, comp, next, ms!, ctx, pre_held);
    }
    if (t.kind == task_kind_notify) & !stop {
        let any_handled = t.handled | handled;
        if dispatch_path_is_root(path) {
            if !any_handled {
                observe_unhandled(t.name);
            }
        } else {
            let parent = {target| base: dispatch_path_to_parent(path), selector: empty_selector() };
            tx.next_hop = task_notify_hop(t, parent, any_handled);
        }
    }
    // The same root when nothing changed, so nothing renders.
    let root = h.root;
    if !!leaf {
        root = update_path_set_in(r.update_path, h.root, leaf!);
    }
    let i = 0;
    while i <s tx.count {
        tx.children[i] = task_prepare(tx.children[i]!, root);
        i += 1;
    }
    if !!tx.next_hop {
        tx.next_hop = task_prepare(tx.next_hop!, root);
    }
    root;
}

// A reply to an ask: a message to the asker, routed to its path and its
// identity, so it reaches the asker or is dropped stale.
fn reply_task(
    name: js_string,
    args: &value_array,
    source: &dispatch_path,
    asker: i32,
    request: i32,
) -> &task {
    {task|
        kind: task_kind_answer,
        name,
        args,
        source,
        target: {target| base: source, selector: empty_selector() },
        route: route_with_id(route_for(source), asker),
        event: VALUE_NULL,
        drag: null,
        action_args: null,
        node: null,
        handled: 0,
        request,
    };
}

// An ask runs no handler on the asker: what asked has committed, so it starts
// the scope's ask handler, and the answer comes back as a reply task of its
// own (name_reply_ok, name_reply_error or name_handler_not_found), which runs
// next, ahead of the queue; a pending answer's comes when it settles. Either
// way a reply that fails fails only itself. It gives no message to handle.
fn ask_reply(
    c: &component,
    t: &task,
    args: &value_array,
    ctx: &context,
    tx: &transaction,
) -> &?message {
    let found = scope_lookup_ask(c.scope, t.name);
    let answer = ask_result_not_found();
    if !!found {
        // An ask handler only answers: its context is the asker's, to read
        // (its scope, to list or make components), with effects of its own,
        // where only logs are allowed.
        let own =
            {context|
                scope: ctx.scope,
                path: ctx.path,
                source_key: ctx.source_key,
                event: ctx.event,
                drag: ctx.drag,
                effects: effect_buf_new(),
                request: ctx.request,
            };
        answer = (found!).handler(t.name, args, own);
        let i = 0;
        while i <s own.effects.len {
            let e = own.effects.items[i]!;
            if e.kind != effect_kind_log {
                host_fail(js_string_concat(s_err_ask_sends, t.name));
            }
            observe_log((e as &effect_log).value as &extern);
            i += 1;
        }
    }
    let asker = (t.route!).id;
    if answer.kind == ask_result_kind_not_found {
        tx.next_hop =
            reply_task(
                js_string_concat(t.name, s_answer_unhandled),
                empty_args(),
                t.source,
                asker,
                t.request,
            );
        return null;
    }
    if answer.kind == ask_result_kind_pending {
        let id = (answer as &ask_result_pending).id;
        tx.pending =
            pv_push(
                tx.pending,
                {pending_reply| id, name: t.name, source: t.source, asker, request: t.request },
            );
        return null;
    }
    let result = (answer as &ask_result_reply).result as &value_result;
    let reply = [value_array|null; 1];
    reply[0] = result.value;
    let name = js_string_concat(t.name, result.ok?s_answer_ok:s_answer_error);
    tx.next_hop = reply_task(name, reply, t.source, asker, t.request);
    null;
}

// The handler's effects, in order, as child tasks; whether it stopped a
// notify. Logs are observed as they come.
fn effect_tasks(t: &task, args: &value_array, ctx: &context, tx: &transaction) -> i32 {
    let stop = 0;
    let here = ctx.path;
    let i = 0;
    while i <s ctx.effects.len {
        let e = ctx.effects.items[i]!;
        let kind = e.kind;
        if kind == effect_kind_notify {
            let n = e as &effect_notify;
            if dispatch_path_is_root(here) {
                // The root has no ancestors: nobody can handle it.
                observe_unhandled(n.name);
            } else {
                let parent =
                    {target| base: dispatch_path_to_parent(here), selector: empty_selector() };
                transaction_push(tx, task_new(task_kind_notify, n.name, n.args, here, parent));
            }
        }
        if kind == effect_kind_ask {
            let a = e as &effect_ask;
            let ask =
                task_new(
                    task_kind_ask,
                    a.name,
                    a.args,
                    here,
                    {target| base: here, selector: empty_selector() },
                );
            ask.request = a.request;
            transaction_push(tx, ask);
        }
        if kind == effect_kind_send_at {
            let s = e as &effect_send_at;
            transaction_push(
                tx,
                task_new(
                    task_kind_plain,
                    s.name,
                    s.args,
                    here,
                    {target| base: here, selector: s.selector },
                ),
            );
        }
        if kind == effect_kind_forward_at {
            let f = e as &effect_forward_at;
            transaction_push(
                tx,
                task_new(
                    task_kind_plain,
                    t.name,
                    args,
                    here,
                    {target| base: here, selector: f.selector },
                ),
            );
        }
        if kind == effect_kind_stop_next {
            stop = 1;
        }
        if kind == effect_kind_log {
            observe_log((e as &effect_log).value as &extern);
        }
        i += 1;
    }
    stop;
}

// Send arguments, evaluated on dispatch against the message context and the
// receiver: literals, the value of the element with the handler, the source
// key, a field of the receiver or of the item at the source key, or
// conditionals of those.
fn eval_args(
    args: &arg_array,
    ctx: &context,
    node: dom_node_opt,
    receiver: &component,
) -> &value_array {
    let out = [value_array|null; args.length()];
    let i = 0;
    while i <s args.length() {
        out[i] = eval_arg(args[i]!, ctx, node, receiver);
        i += 1;
    }
    out;
}

fn eval_arg(a: &arg, ctx: &context, node: dom_node_opt, receiver: &component) -> &value {
    let kind = a.kind;
    if kind == arg_kind_value {
        return (a as &arg_value).value;
    }
    if kind == arg_kind_target_value {
        if !node {
            return VALUE_NULL;
        }
        return dom_target_value(node!) as &any as &value;
    }
    if kind == arg_kind_source_key {
        if !ctx.source_key {
            return VALUE_NULL;
        }
        return value_from_key(ctx.source_key!);
    }
    if kind == arg_kind_event {
        if ctx.event.kind != value_kind_map {
            return VALUE_NULL;
        }
        let found = map_get(ctx.event, (a as &arg_event).name);
        if !found {
            return VALUE_NULL;
        }
        return found!;
    }
    if kind == arg_kind_drag_key {
        if ctx.drag.kind != value_kind_map {
            return VALUE_NULL;
        }
        return map_get(ctx.drag, s_key)!;
    }
    if kind == arg_kind_field {
        let found = owner_field(receiver, (a as &arg_field).name);
        if !found {
            return VALUE_NULL;
        }
        return found!;
    }
    if kind == arg_kind_item_field {
        let f = a as &arg_item_field;
        let seq = owner_field(receiver, f.seq);
        if !seq | !ctx.source_key {
            return VALUE_NULL;
        }
        let item = get_key(seq!, ctx.source_key!);
        return get_key(item, path_key_name(f.name));
    }
    let c = a as &arg_if;
    if value_truthy(eval_arg(c.test, ctx, node, receiver)) {
        return eval_arg(c.then, ctx, node, receiver);
    }
    eval_arg(c.otherwise, ctx, node, receiver);
}

// Routes a DOM event, e, of type kind on target: queues the task of the
// handler it reaches, if any, with its route fixed now and what is being
// dragged. 1 when it reached one. The drop events reach the nearest
// enclosing component that handles them, so a drop on a child's elements
// gets to the parent's on:drop; before that, the drag they're about is
// tracked from dragstart to dragend.
fn host_dispatch_event(
    h: &host,
    e: dom_event,
    target: dom_node,
    kind: js_string,
    event: &value,
) -> i32 {
    if !h.container {
        return 0;
    }
    let container = h.container!;
    let bubbles = is_drop_event(kind);
    if str_eq(kind, s_dragstart) {
        host_start_drag(h, container, e, target);
    } else {
        if bubbles {
            host_drag_over(h, container, e, target, kind, event);
        }
    }
    let info = decode_event(container, target, kind, h.root, bubbles, event);
    let queued = 0;
    if !!info {
        let i = info!;
        if i.handler.mods & event_mod_prevent {
            dom_prevent_default(e);
        }
        if i.handler.mods & event_mod_stop {
            dom_stop_propagation(e);
        }
        let r = route_at(i.route.path, h.root);
        task_queue_push(
            h.queue,
            {task|
                kind: task_kind_event,
                name: i.handler.action.name,
                args: empty_args(),
                source: r.path,
                target: {target| base: r.path, selector: empty_selector() },
                route: r,
                event,
                drag: h.drag,
                action_args: i.handler.action.args,
                node: i.node,
                handled: 0,
                request: 0,
            },
        );
        queued = 1;
    }
    if str_eq(kind, s_dragend) {
        host_end_drag(h);
    }
    queued;
}

// ---- Drag and drop (tutuca's src/drag.js and its Host's drag methods) --------

fn is_drop_event(kind: js_string) -> i32 {
    if str_eq(kind, s_dragenter) | str_eq(kind, s_dragover) {
        return 1;
    }
    str_eq(kind, s_dragleave) | str_eq(kind, s_drop);
}

// Remembers what is dragged: the closest draggable element, where it was
// rendered and its value.
fn host_start_drag(h: &host, container: dom_node, e: dom_event, target: dom_node) {
    let node = dom_closest_draggable(target);
    if !node {
        return;
    }
    let path = path_of(container, node!);
    if !path {
        return;
    }
    host_end_drag(h);
    let value = update_path_get_in(dispatch_path_resolve(path!), h.root);
    h.drag =
        {drag| path: path!, drag_type: dom_dataset_get(node!, s_dragtype), node: node!, value };
    dom_dataset_set(node!, s_dragging, s_empty);
    dom_drag_start(e);
}

// Over a drop target, an element with a drop handler, lets the drop happen
// and marks it: the browser shows a move cursor over a drop target, a
// not-allowed one elsewhere.
fn host_drag_over(
    h: &host,
    container: dom_node,
    e: dom_event,
    target: dom_node,
    kind: js_string,
    event: &value,
) {
    if str_eq(kind, s_drop) {
        dom_prevent_default(e);
        host_mark_drag_over(h, null);
        return;
    }
    if str_eq(kind, s_dragleave) {
        if !dom_contains(container, dom_related_target(e)) {
            host_mark_drag_over(h, null);
        }
        return;
    }
    let info = decode_event(container, target, s_drop, h.root, 1, event);
    if !info {
        host_mark_drag_over(h, null);
        return;
    }
    dom_prevent_default(e);
    dom_drop_effect_move(e);
    host_mark_drag_over(h, (info!).node);
}

// data-draggingover on the drop target node (none when null): the dragged
// element's data-dragtype, or "external".
fn host_mark_drag_over(h: &host, node: dom_node_opt) {
    if !node {
        if !h.drag_over {
            return;
        }
    } else {
        if !!h.drag_over {
            if dom_is_same_node(node!, h.drag_over!) {
                return;
            }
        }
    }
    if !!h.drag_over {
        dom_dataset_delete(h.drag_over!, s_draggingover);
    }
    h.drag_over = node;
    if !!node {
        let kind = s_external;
        if !!h.drag {
            let t = (h.drag!).drag_type;
            if !!t {
                kind = t!;
            }
        }
        dom_dataset_set(node!, s_draggingover, kind);
    }
}

fn host_end_drag(h: &host) {
    host_mark_drag_over(h, null);
    if !!h.drag {
        dom_dataset_delete((h.drag!).node, s_dragging);
    }
    h.drag = null;
}

// The key of receiver's child the dragged element is in, as the source key
// is for a message; null when it was dragged from outside receiver.
fn drag_key_in(d: &drag, receiver: &dispatch_path) -> &?path_key {
    dispatch_path_source_key_in(d.path, receiver);
}

// What a handler at receiver reads as ctx.drag: { type, value, key }, or null.
fn drag_value(d: &?drag, receiver: &dispatch_path) -> &value {
    if !d {
        return VALUE_NULL;
    }
    let dd = d!;
    let kind = VALUE_NULL;
    if !!dd.drag_type {
        kind = value_string(dd.drag_type!);
    }
    let key = VALUE_NULL;
    let found = drag_key_in(dd, receiver);
    if !!found {
        key = value_from_key(found!);
    }
    map_assoc(map_assoc(map_assoc(map_empty(), s_type, kind), s_value, dd.value), s_key, key);
}

// ---- Listening --------------------------------------------------------------

// The event names the types registered so far handle (in any scope:
// registered_event_names) that this host hasn't given before: the ones to
// start listening to. An event no component it renders handles finds no
// handler, and goes nowhere.
type event_names_acc = { listening: mut &phm_map, out: mut &value };

fn host_new_event_names(h: &host) -> &value {
    if !registered_event_names {
        return list_empty();
    }
    let acc = {event_names_acc| listening: h.listening, out: list_empty() };
    phm_each(registered_event_names!, acc, event_names_visit);
    h.listening = acc.listening;
    acc.out;
}

fn event_names_visit(context: &?eq, key: &?eq, item: &?eq) {
    let acc = context! as &event_names_acc;
    let name = (key! as &value_string).value;
    if !smap_get(acc.listening, name) {
        acc.listening = smap_assoc(acc.listening, name, value_null());
        acc.out = list_push(acc.out, value_string(name));
    }
}

// An ask answered later settled: its reply joins the queue, routed to the
// asker. result is a result value. 0 when the id isn't pending.
fn host_settle(h: &host, id: i32, result: &value) -> i32 {
    let n = pv_count(h.pending);
    let i = 0;
    while i <s n {
        let p = pv_at(h.pending, i)! as &pending_reply;
        if p.id == id {
            let rest = pv_empty();
            let j = 0;
            while j <s n {
                if j != i {
                    rest = pv_push(rest, pv_at(h.pending, j));
                }
                j += 1;
            }
            h.pending = rest;
            let r = result as &value_result;
            let reply = [value_array|null; 1];
            reply[0] = r.value;
            let name = js_string_concat(p.name, r.ok?s_answer_ok:s_answer_error);
            task_queue_push(h.queue, reply_task(name, reply, p.source, p.asker, p.request));
            return 1;
        }
        i += 1;
    }
    0;
}

// An update path as a list of its keys: names and indices.
fn update_path_value(p: &update_path) -> &value {
    let out = list_empty();
    let i = 0;
    while i <s p.keys.length() {
        out = list_push(out, value_from_key(p.keys[i]!));
        i += 1;
    }
    out;
}

// Renders the root if it changed since the last render: lowers its view and
// morphs the DOM from what the last render rendered; whether it did. A
// headless host renders nothing.
fn host_render(h: &host) -> i32 {
    h.at = VALUE_NULL;
    if !h.container | !h.doc {
        return 0;
    }
    if !!h.rendered_root {
        if h.rendered_root! == h.root {
            return 0;
        }
    }
    let vnodes = lower_all(render_root(h.root));
    render(h.doc!, h.container!, vnodes, h.rendered);
    h.rendered = vnodes;
    h.rendered_root = h.root;
    1;
}
