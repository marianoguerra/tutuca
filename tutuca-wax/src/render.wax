// Rendering components into the semantic tree (RenderContext and renderView
// in tutuca's src/view.js; the spec's view/view.rkt): what crosses component
// boundaries while a view renders, and wrapping a component's render.

// What a render gets from where it happens: what ancestors provide (name ->
// provided), the view names they pushed, innermost first, and the frames
// entered from the root.
type render_context = { provided: &phm_map, views: &str_array, depth: i32 };

// enterFrame: one frame further, capturing what the value entered provides at
// its depth; its provides shadow outer ones.
fn render_context_enter_frame(ctx: &render_context, entered: &value) -> &render_context {
    let depth = ctx.depth + 1;
    let provided = ctx.provided;
    let c = value_as_component(entered);
    if !!c {
        let spec = (c!).spec;
        let i = 0;
        while i <s spec.provide_names.length() {
            let frames = selector_freeze(spec.provide_selectors[i]!, entered);
            let keys = dispatch_path_resolve({dispatch_path| frames }).keys;
            let v = update_path_get_in({update_path| keys }, entered);
            provided =
                smap_assoc(provided, spec.provide_names[i]!, {provided| value: v, depth, keys });
            i += 1;
        }
    }
    {render_context| provided, views: ctx.views, depth };
}

// pushView: name first among the views the components below prefer.
fn render_context_push_view(ctx: &render_context, name: &extern) -> &render_context {
    let n = ctx.views.length();
    let views = [str_array|null; n + 1];
    views[0] = name;
    views.copy(1, ctx.views, 0, n);
    {render_context| provided: ctx.provided, views, depth: ctx.depth };
}

// The value an ancestor provides under name, or null.
fn render_context_provided(ctx: &render_context, name: &extern) -> &?provided {
    let found = smap_get(ctx.provided, name);
    if !found {
        return null;
    }
    found! as &provided;
}

// The frame a provided source enters: a jump to where it was captured.
fn render_context_provided_frame(ctx: &render_context, name: &extern) -> &?frame {
    let p = render_context_provided(ctx, name);
    if !p {
        return null;
    }
    let provider = {provider| name, depth: (p!).depth, keys: (p!).keys };
    {frame| keys: [path_key_array|null; 0], item: null, provider, is_component: 1 };
}

// renderView: a component's view (the one named, the first of ctx.views it
// has, or its main view) inside its component wrapper.
fn render_view(c: &component, view: &?extern, ctx: &render_context) -> &snode {
    snode_component(c.spec.name, view_eval_component(c, view, ctx));
}

// A child component rendered at a frame, the way the spec's x-render does:
// the frame's wrapper around the child's view, rendered one frame deeper.
fn render_child(f: &frame, child: &value, view: &?extern, ctx: &render_context) -> &snode {
    let c = value_as_component(child);
    if !c {
        host_fail(s_err_render_not_component);
        unreachable;
    }
    let childs = [snode_array|null; 1];
    childs[0] = render_view(c!, view, render_context_enter_frame(ctx, child));
    snode_enter(f, childs);
}

// The root render: the root component, entered from depth -1.
fn render_root(root: &value) -> &snode_array {
    let c = value_as_component(root);
    if !c {
        host_fail(s_err_render_not_component);
        unreachable;
    }
    let start = {render_context| provided: smap_empty(), views: [str_array|null; 0], depth: -1 };
    let out = [snode_array|null; 1];
    out[0] = render_view(c!, null, render_context_enter_frame(start, root));
    out;
}
