// String helpers over JS strings.

// JS ===: null equals null, and nothing else.
fn str_eq(a: js_string_opt, b: js_string_opt) -> i32 {
    js_string_equals(a, b);
}

// Whether s, lowercased in ASCII, is lower (which is already lowercase).
fn str_eq_ascii_lower(s: js_string, lower: js_string) -> i32 {
    let n = js_string_length(s);
    if n != js_string_length(lower) {
        return 0;
    }
    let i = 0;
    while i <s n {
        let c = js_string_char_code_at(s, i);
        if (c >=s 'A') & (c <=s 'Z') {
            c = c + 32;
        }
        if c != js_string_char_code_at(lower, i) {
            return 0;
        }
        i += 1;
    }
    1;
}

// FNV-1a over the UTF-16 code units.
fn str_hash(s: js_string) -> i32 {
    let h = 0x811c9dc5;
    let n = js_string_length(s);
    let i = 0;
    while i <s n {
        h = (h ^ js_string_char_code_at(s, i)) * 0x01000193;
        i += 1;
    }
    h;
}

// Whether a sorts before b, by UTF-16 code units, as JS's < does.
fn str_lt(a: js_string, b: js_string) -> i32 {
    let na = js_string_length(a);
    let nb = js_string_length(b);
    let i = 0;
    while (i <s na) & (i <s nb) {
        let ca = js_string_char_code_at(a, i);
        let cb = js_string_char_code_at(b, i);
        if ca != cb {
            return ca <s cb;
        }
        i += 1;
    }
    na <s nb;
}
