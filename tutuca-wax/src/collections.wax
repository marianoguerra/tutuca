// List and Map: the Value cases over wax-mb's persistent vector and hash map
// (vendor/wax-mb, unmodified), adapted to the runtime. The vendored code
// stores `&?eq`; these functions only ever store `&value`, so what comes out
// is cast back. Both are persistent: an update returns a new list or map and
// the old one stays usable, sharing what didn't change; reference equality on
// the value tells whether it changed.
//
// A map's keys are strings. The HAMT needs keys in the eq hierarchy, and a JS
// string is an externref, so a key is stored as the `value_string` struct
// that holds it, and the map's hash and equality read the string through it:
// the key policy is fixed here instead of passed per map.

fn value_key_hash(key: &eq) -> i32 {
    str_hash((key as &value_string).value);
}

fn value_key_equal(a: &eq, b: &eq) -> i32 {
    str_eq((a as &value_string).value, (b as &value_string).value);
}

// ---- List ----------------------------------------------------------------

fn list_empty() -> &value {
    value_list(pv_empty());
}

fn list_count(list: &value) -> i32 {
    pv_count((list as &value_list).value);
}

// The item at i, or null when i is out of range.
fn list_get(list: &value, i: i32) -> &?value {
    let (found, item) = pv_get((list as &value_list).value, i);
    if found == 0 {
        return null;
    }
    item! as &value;
}

fn list_push(list: &value, item: &value) -> &value {
    value_list(pv_push((list as &value_list).value, item));
}

// The list with item at i; i == count appends.
fn list_assoc(list: &value, i: i32, item: &value) -> &value {
    value_list(pv_assoc((list as &value_list).value, i, item));
}

fn list_pop(list: &value) -> &value {
    value_list(pv_pop((list as &value_list).value));
}

// The list without the item at i (the same list when i is out of range).
fn list_remove_at(list: &value, i: i32) -> &value {
    let n = list_count(list);
    if (i <s 0) | (i >=s n) {
        return list;
    }
    let out = list_empty();
    let j = 0;
    while j <s n {
        if j != i {
            out = list_push(out, list_get(list, j)!);
        }
        j += 1;
    }
    out;
}

// The list with item before the one at i (at the end when i is past it).
fn list_insert(list: &value, i: i32, item: &value) -> &value {
    let n = list_count(list);
    if i >=s n {
        return list_push(list, item);
    }
    let out = list_empty();
    let j = 0;
    while j <s n {
        if j == i {
            out = list_push(out, item);
        }
        out = list_push(out, list_get(list, j)!);
        j += 1;
    }
    out;
}

// ---- Map -----------------------------------------------------------------

// A map keeps its keys in the order they were first set, as a JS object does
// (pure-tutuca's values are JavaScript's): the HAMT holds each key's entry
// (where it is in the order, and its value), and the order the keys, a removed
// one's slot null until more than half are, when it's compacted.

fn map_empty() -> &value {
    value_map(phm_empty(value_key_hash, value_key_equal), pv_empty());
}

fn map_count(map: &value) -> i32 {
    phm_count((map as &value_map).value);
}

fn map_entry_of(map: &value, key: js_string) -> &?map_entry {
    let (found, entry) = phm_get((map as &value_map).value, value_string(key));
    if found == 0 {
        return null;
    }
    entry! as &map_entry;
}

// Whether the map has key (with any value, undefined included).
fn map_has(map: &value, key: js_string) -> i32 {
    !!map_entry_of(map, key);
}

// The value under key, or null when there's none.
fn map_get(map: &value, key: js_string) -> &?value {
    let entry = map_entry_of(map, key);
    if !entry {
        return null;
    }
    (entry!).item;
}

// The map with key set to item: in its place when the map has it, last when
// it doesn't.
fn map_assoc(map: &value, key: js_string, item: &value) -> &value {
    let m = map as &value_map;
    let k = value_string(key);
    let entry = map_entry_of(map, key);
    if !!entry {
        let e = {map_entry| seq: (entry!).seq, item };
        return value_map(phm_assoc(m.value, k, e), m.order);
    }
    let e = {map_entry| seq: pv_count(m.order), item };
    value_map(phm_assoc(m.value, k, e), pv_push(m.order, k));
}

fn map_dissoc(map: &value, key: js_string) -> &value {
    let m = map as &value_map;
    let entry = map_entry_of(map, key);
    if !entry {
        return map;
    }
    let entries = phm_dissoc(m.value, value_string(key));
    let order = pv_assoc(m.order, (entry!).seq, null);
    // More than half the order removed keys: make it again without them.
    if phm_count(entries) * 2 <s pv_count(order) {
        let out = map_empty();
        let i = 0;
        while i <s pv_count(order) {
            let (_, k) = pv_get(order, i);
            if !!k {
                let ks = (k! as &value_string).value;
                let (_, e) = phm_get(entries, k);
                out = map_assoc(out, ks, (e! as &map_entry).item);
            }
            i += 1;
        }
        return out;
    }
    value_map(entries, order);
}

// The keys and values of a map as two lists in the same order, the order the
// keys were set in.
type map_entries_acc = { keys: mut &pv_vector, values: mut &pv_vector };

// For the runtime's own tables (smap): a HAMT's entries in its order.
fn map_entries_visit(context: &?eq, key: &?eq, item: &?eq) {
    let acc = context! as &map_entries_acc;
    acc.keys = pv_push(acc.keys, key);
    acc.values = pv_push(acc.values, item);
}

fn map_entries(map: &value) -> &map_entries_acc {
    let m = map as &value_map;
    let acc = {map_entries_acc| keys: pv_empty(), values: pv_empty() };
    let i = 0;
    while i <s pv_count(m.order) {
        let (_, k) = pv_get(m.order, i);
        if !!k {
            let (_, e) = phm_get(m.value, k);
            acc.keys = pv_push(acc.keys, k);
            acc.values = pv_push(acc.values, (e! as &map_entry).item);
        }
        i += 1;
    }
    acc;
}

fn map_keys(map: &value) -> &value {
    value_list(map_entries(map).keys);
}

fn map_values(map: &value) -> &value {
    value_list(map_entries(map).values);
}

// ---- Outcomes -------------------------------------------------------------------

// The outcome of something that can fail, as JS sees it: a map with one key,
// { ok: value } or { err: error }.
fn outcome_ok(v: &value) -> &value {
    map_assoc(map_empty(), s_ok, v);
}

fn outcome_err(e: &value) -> &value {
    map_assoc(map_empty(), s_err, e);
}

// Whether o is an { ok } outcome.
fn outcome_is_ok(o: &value) -> i32 {
    if o.kind != value_kind_map {
        return 0;
    }
    map_has(o, s_ok);
}

// What an outcome holds: the ok's value or the err's error; null for what
// isn't one.
fn outcome_value(o: &value) -> &value {
    if o.kind != value_kind_map {
        return VALUE_NULL;
    }
    let found = map_get(o, s_ok);
    if !found {
        found = map_get(o, s_err);
    }
    if !found {
        return VALUE_NULL;
    }
    found!;
}

// a == b, as a view's equality compares: numbers by value, strings by
// content, lists and maps item by item, the rest by reference.
fn value_equal(a: &value, b: &value) -> i32 {
    if value_same(a, b) {
        return 1;
    }
    if (a.kind == value_kind_list) & (b.kind == value_kind_list) {
        let n = list_count(a);
        if n != list_count(b) {
            return 0;
        }
        let i = 0;
        while i <s n {
            if !value_equal(list_get(a, i)!, list_get(b, i)!) {
                return 0;
            }
            i += 1;
        }
        return 1;
    }
    if (a.kind == value_kind_map) & (b.kind == value_kind_map) {
        if map_count(a) != map_count(b) {
            return 0;
        }
        let keys = map_keys(a);
        let i = 0;
        while i <s list_count(keys) {
            let key = (list_get(keys, i)! as &value_string).value;
            let other = map_get(b, key);
            if !other {
                return 0;
            }
            if !value_equal(map_get(a, key)!, other!) {
                return 0;
            }
            i += 1;
        }
        return 1;
    }
    0;
}

// ---- String-keyed maps of runtime structs --------------------------------

// The same HAMT and key policy, for the runtime's own tables (a scope's
// children, registrations and ask handlers; a render's provided values),
// whose values are runtime structs rather than values.
fn smap_empty() -> &phm_map {
    phm_empty(value_key_hash, value_key_equal);
}

fn smap_get(map: &phm_map, key: js_string) -> &?eq {
    let (found, item) = phm_get(map, value_string(key));
    if found == 0 {
        return null;
    }
    item;
}

fn smap_assoc(map: &phm_map, key: js_string, item: &eq) -> &phm_map {
    phm_assoc(map, value_string(key), item);
}

fn smap_dissoc(map: &phm_map, key: js_string) -> &phm_map {
    phm_dissoc(map, value_string(key));
}
