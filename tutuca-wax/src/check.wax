// What the host checks with schemas (tutuca's src/host.js checkState,
// checkMessage and checkSettled, and src/schema.js findInvalidFields and
// messageIssues): a message's arguments, always, rejecting the ones that
// don't fit before the handler sees them, with a structured rejection; and
// in dev mode, the message's contract around its handler, the state's fields
// after each task, and invariants when the queue settles, reported through
// observe_issue.

// ---- Rejections ------------------------------------------------------------------

// The text a rejection's reason reads as: a string as it is, anything else short.
fn reason_text(v: &value) -> js_string {
    let s = value_string_of(v);
    if !!s {
        return s!;
    }
    value_short(v);
}

// Aborts the task: the component c rejected the message name, for reason (a
// code: wrongArity, wrongArgType, invalidArg, failed), at the argument
// index (-1 for none); problem says why in words; detail is the handler's own
// reason, when it gave one. JS gets them all as the error's rejection.
fn reject_with(
    c: &component,
    name: js_string,
    reason: js_string,
    index: i32,
    problem: js_string,
    detail: &?value,
) {
    let info = map_assoc(map_empty(), s_message, value_string(name));
    info = map_assoc(info, s_component, value_string(c.spec.name));
    info = map_assoc(info, s_reason, value_string(reason));
    info = map_assoc(info, s_problem, value_string(problem));
    if index >=s 0 {
        info = map_assoc(info, s_index, value_int(index));
    }
    if !!detail {
        info = map_assoc(info, s_detail, detail!);
    }
    let text =
        js_string_concat(
            js_string_concat(js_string_concat(s_err_rejected, name), s_colon_space),
            problem,
        );
    host_reject(text, info as &extern);
}

fn arity_problem(expected: i32, got: i32) -> js_string {
    let b = text_builder_new();
    text_push(b, s_r_takes);
    text_push_int(b, expected);
    text_push(b, expected == 1?s_r_argument_got:s_r_arguments_got);
    text_push_int(b, got);
    text_finish(b);
}

// "argument 0 (n): must be at least 0, got -1"; name is null when unknown.
fn arg_problem(index: i32, name: js_string_opt, problem: js_string) -> js_string {
    let b = text_builder_new();
    text_push(b, s_r_argument);
    text_push_int(b, index);
    if !!name {
        text_push(b, s_r_paren_open);
        text_push(b, name!);
        text_push_unit(b, ')');
    }
    text_push(b, s_colon_space);
    text_push(b, problem);
    text_finish(b);
}

// A handler's rejection, as a structured one.
fn reject_message(c: &component, name: js_string, e: &message_error) {
    let kind = e.kind;
    if kind == message_error_kind_wrong_arity {
        let a = e as &message_error_wrong_arity;
        reject_with(c, name, s_r_wrong_arity, -1, arity_problem(a.expected, a.got), null);
        return;
    }
    if kind == message_error_kind_wrong_arg_type {
        let index = (e as &message_error_wrong_arg_type).index;
        reject_with(
            c,
            name,
            s_r_wrong_arg_type,
            index,
            arg_problem(index, null, s_r_wrong_type),
            null,
        );
        return;
    }
    if kind == message_error_kind_invalid_arg {
        let a = e as &message_error_invalid_arg;
        reject_with(
            c,
            name,
            s_r_invalid_arg,
            a.index,
            arg_problem(a.index, null, reason_text(a.reason)),
            a.reason,
        );
        return;
    }
    let reason = (e as &message_error_failed).reason;
    reject_with(c, name, s_r_failed, -1, reason_text(reason), reason);
}

// Rejects args that don't fit the message's schema: their number, then each
// one's type, then its constraints, against c's state for the ones that read
// it (a key of one of its fields). The ones that fit are coerced to their
// types (vtype_coerce), in place.
fn check_message_args(c: &component, ms: &message_schema, args: &value_array) {
    if args.length() != ms.args.length() {
        reject_with(
            c,
            ms.name,
            s_r_wrong_arity,
            -1,
            arity_problem(ms.args.length(), args.length()),
            null,
        );
        return;
    }
    let i = 0;
    while i <s args.length() {
        let f = ms.args[i]!;
        let arg = args[i]!;
        let problem = vtype_problem(f.vtype, arg);
        if !!problem {
            reject_with(c, ms.name, s_r_wrong_arg_type, i, arg_problem(i, f.name, problem!), null);
            return;
        }
        // A null its type takes (an option's) meets the constraints, which
        // are about the value it's an option of.
        if arg.kind != value_kind_null {
            problem = constraints_problem(f.constraints, arg, c);
        }
        if !!problem {
            reject_with(c, ms.name, s_r_invalid_arg, i, arg_problem(i, f.name, problem!), null);
            return;
        }
        args[i] = vtype_coerce(f.vtype, arg);
        i += 1;
    }
}

// ---- Message contracts (dev mode) ---------------------------------------------------

fn emits_has(emits: &emit_array, kind: i32, name: js_string) -> i32 {
    let i = 0;
    while i <s emits.length() {
        let e = emits[i]!;
        if (e.kind == kind) & str_eq(e.name, name) {
            return 1;
        }
        i += 1;
    }
    0;
}

// "emits:notify:remove_me" when the message may not emit it.
fn emit_issue(issues: &value, emits: &emit_array, kind: i32, name: js_string) -> &value {
    if emits_has(emits, kind, name) {
        return issues;
    }
    let text =
        js_string_concat(
            js_string_concat(js_string_concat(s_r_emits, emit_kind_name(kind)), s_colon),
            name,
        );
    list_push(issues, value_string(text));
}

// What the handler of t, which turned prev into next, broke of its message's
// contract (messageIssues in JS): "pre", "post", "sourceKey",
// "changes:<field>" (a field outside changes isn't the same value),
// "emits:<kind>:<name>". Kept in the transaction, reported once it commits.
// The contract of the message m the task t had handled, on prev becoming
// next.
fn check_message_contract(
    tx: &transaction,
    t: &task,
    m: &message,
    prev: &component,
    next: &component,
    ms: &message_schema,
    ctx: &context,
    pre_held: i32,
) {
    let args = m.args;
    let issues = list_empty();
    if !pre_held {
        issues = list_push(issues, value_string(s_pre));
    }
    if !!ms.post {
        if !(ms.post!)(prev.instance, next.instance, args, ctx) {
            issues = list_push(issues, value_string(s_post));
        }
    }
    if !!ms.source_key {
        let key = VALUE_NULL;
        if !!ctx.source_key {
            key = value_from_key(ctx.source_key!);
        }
        if !!field_problem(ms.source_key!, key, prev) {
            issues = list_push(issues, value_string(s_source_key_name));
        }
    }
    if !!ms.changes & (next.spec == prev.spec) & !!prev.spec.schema {
        let fields = (prev.spec.schema!).fields;
        let i = 0;
        while i <s fields.length() {
            let name = (fields[i]!).name;
            if !str_array_has(ms.changes!, name) {
                let before = owner_field(prev, name);
                let after = owner_field(next, name);
                if !!before & !!after {
                    if !value_same(before!, after!) {
                        issues =
                            list_push(issues, value_string(js_string_concat(s_r_changes, name)));
                    }
                }
            }
            i += 1;
        }
    }
    if !!ms.emits {
        let emits = ms.emits!;
        let i = 0;
        while i <s ctx.effects.len {
            let e = ctx.effects.items[i]!;
            if e.kind == effect_kind_notify {
                issues = emit_issue(issues, emits, emit_kind_notify, (e as &effect_notify).name);
            }
            if e.kind == effect_kind_ask {
                issues = emit_issue(issues, emits, emit_kind_ask, (e as &effect_ask).name);
            }
            if e.kind == effect_kind_send_at {
                issues = emit_issue(issues, emits, emit_kind_send_at, (e as &effect_send_at).name);
            }
            if e.kind == effect_kind_forward_at {
                issues = emit_issue(issues, emits, emit_kind_send_at, t.name);
            }
            i += 1;
        }
    }
    if list_count(issues) == 0 {
        return;
    }
    let info = map_assoc(map_empty(), s_message, value_string(m.name));
    info = map_assoc(info, s_component, value_string(prev.spec.name));
    tx.issues = list_push(tx.issues, map_assoc(info, s_issues, issues));
}

// ---- The state (dev mode) --------------------------------------------------------------

// What a walk of the state reports: the fields that don't fit their schema
// and the invariants that don't hold, as { path, component, field, value,
// reason, problem } maps.
type invalid_acc = { issues: mut &value, fields: i32, invariants: i32 };

fn invalid_issue(
    acc: &invalid_acc,
    path: &value,
    c: &component,
    field: &value,
    v: &value,
    reason: js_string,
    problem: js_string,
) {
    let m = map_assoc(map_empty(), s_path, path);
    m = map_assoc(m, s_component, value_string(c.spec.name));
    m = map_assoc(m, s_field, field);
    m = map_assoc(m, s_value, v);
    m = map_assoc(m, s_reason, value_string(reason));
    acc.issues = list_push(acc.issues, map_assoc(m, s_problem, value_string(problem)));
}

// Walks v, skipping what it shares with prev (the same reference), so after
// a task only what it changed is checked. A component without a schema is a
// leaf: the runtime can't see its fields.
fn find_invalid(acc: &invalid_acc, v: &value, prev: &?value, path: &value) {
    if !!prev {
        if prev! == v {
            return;
        }
    }
    if v.kind == value_kind_list {
        let i = 0;
        while i <s list_count(v) {
            let before: &?value = null;
            if !!prev {
                if (prev!).kind == value_kind_list {
                    if i <s list_count(prev!) {
                        before = list_get(prev!, i);
                    }
                }
            }
            find_invalid(acc, list_get(v, i)!, before, list_push(path, value_int(i)));
            i += 1;
        }
        return;
    }
    if v.kind == value_kind_map {
        let keys = map_keys(v);
        let i = 0;
        while i <s list_count(keys) {
            let key = (list_get(keys, i)! as &value_string).value;
            let before: &?value = null;
            if !!prev {
                if (prev!).kind == value_kind_map {
                    before = map_get(prev!, key);
                }
            }
            find_invalid(acc, map_get(v, key)!, before, list_push(path, value_string(key)));
            i += 1;
        }
        return;
    }
    let found = value_as_component(v);
    if !found {
        return;
    }
    let c = found!;
    if !c.spec.schema {
        return;
    }
    let schema = c.spec.schema!;
    let prev_c: &?component = null;
    if !!prev {
        prev_c = value_as_component(prev!);
    }
    let i = 0;
    while i <s schema.fields.length() {
        let f = schema.fields[i]!;
        let fv = owner_field(c, f.name);
        let at = list_push(path, value_string(f.name));
        if !fv {
            if acc.fields {
                invalid_issue(acc, at, c, value_string(f.name), VALUE_NULL, s_invalid, s_p_missing);
            }
        } else {
            if acc.fields {
                let problem = field_problem(f, fv!, c);
                if !!problem {
                    invalid_issue(acc, at, c, value_string(f.name), fv!, s_invalid, problem!);
                }
            }
            let before: &?value = null;
            if !!prev_c {
                before = owner_field(prev_c!, f.name);
            }
            find_invalid(acc, fv!, before, at);
        }
        i += 1;
    }
    if !acc.invariants {
        return;
    }
    i = 0;
    while i <s schema.invariants.length() {
        let inv = schema.invariants[i]!;
        if !inv.holds(c.instance) {
            let reason = js_string_concat(s_r_invariant, inv.name);
            let problem =
                js_string_concat(js_string_concat(s_r_the_invariant, inv.name), s_r_doesnt_hold);
            invalid_issue(acc, path, c, VALUE_NULL, v, reason, problem);
        }
        i += 1;
    }
}

fn find_invalid_in(root: &value, prev: &?value, fields: i32, invariants: i32) -> &value {
    let acc = {invalid_acc| issues: list_empty(), fields, invariants };
    find_invalid(acc, root, prev, list_empty());
    acc.issues;
}

// stateInvalid, with what the walk found and where it happened.
fn report_state(issues: &value, key: js_string, at: &value) {
    if list_count(issues) == 0 {
        return;
    }
    let info = map_assoc(map_assoc(map_empty(), key, at), s_issues, issues);
    observe_issue(s_state_invalid, info as &extern);
}

// After a task committed: what its handler broke of its message's contract,
// the fields it changed that don't fit, and once the queue is empty, the
// invariants of what changed since it last was. A task can leave invariants
// broken for the tasks it queued, so they wait for the queue to settle.
fn host_check_task(h: &host, t: &task, prev: &value, message_issues: &value) {
    let i = 0;
    while i <s list_count(message_issues) {
        observe_issue(s_message_invalid, list_get(message_issues, i)! as &extern);
        i += 1;
    }
    report_state(find_invalid_in(h.root, prev, 1, 0), s_task, value_string(t.name));
    if !host_has_tasks(h) {
        host_check_settled(h);
    }
}

fn host_check_settled(h: &host) {
    if h.settled_root == h.root {
        return;
    }
    let prev = h.settled_root;
    h.settled_root = h.root;
    report_state(find_invalid_in(h.root, prev, 0, 1), s_settled, value_bool(1));
}

// The whole state, fields and invariants: what a dev host checks when it
// starts.
fn host_check(h: &host) {
    h.settled_root = h.root;
    report_state(find_invalid_in(h.root, null, 1, 1), s_task, VALUE_NULL);
}

// ---- For test runners ----------------------------------------------------------------

// Why the component c can't take the message name with args now, or null
// when it can: the arguments don't fit its schema, or its guard (when)
// doesn't hold on c's state. A runner generating messages only sends the
// ones c can take. No schema, or no such message: null (the vtable decides).
// Why c can't run the query name with args (no such query, or arguments
// that don't fit its schema), or null when it can.
fn query_problem(c: &component, name: js_string, args: &value_array) -> js_string_opt {
    let qs = spec_query_schema(c.spec, name);
    if !qs | !c.vtable.query {
        return s_no_such_query;
    }
    let q = qs!;
    if args.length() != q.args.length() {
        return arity_problem(q.args.length(), args.length());
    }
    let i = 0;
    while i <s args.length() {
        let f = q.args[i]!;
        let problem = field_problem(f, args[i]!, c);
        if !!problem {
            return arg_problem(i, f.name, problem!);
        }
        i += 1;
    }
    null;
}

// Runs c's query name with args: an ok result with its value, or an error
// result saying why it couldn't run.
fn component_query(c: &component, name: js_string, args: &value_array) -> &value {
    let problem = query_problem(c, name, args);
    if !!problem {
        return value_err(value_string(problem!));
    }
    let (code, got) = (c.vtable.query!)(c.instance, name, args);
    if code != (property_ok | !got) {
        return value_err(value_string(s_query_failed));
    }
    value_ok(got!);
}

// ---- Contracts: applying pure messages ------------------------------------------------

// A context for what runs outside a host's task: a message's pre and post
// conditions, and a pure handler (which never reads it).
fn detached_ctx(c: &component) -> &context {
    {context|
        scope: c.scope,
        path: {dispatch_path| frames: [frame_array|null; 0] },
        source_key: null,
        event: VALUE_NULL,
        drag: VALUE_NULL,
        effects: effect_buf_new(),
        request: 0,
    };
}

// An error result of applying name to c (tutuca's ContractError): { code,
// issues, detail, component, message }, code the first of issues.
fn apply_error(c: &component, name: js_string, issues: &value, detail: js_string) -> &value {
    let m = map_assoc(map_empty(), s_code, list_get(issues, 0)!);
    m = map_assoc(m, s_issues, issues);
    m = map_assoc(m, s_detail, value_string(detail));
    m = map_assoc(m, s_component, value_string(c.spec.name));
    value_err(map_assoc(m, s_message, value_string(name)));
}

fn apply_fail(c: &component, name: js_string, code: js_string, detail: js_string) -> &value {
    apply_error(c, name, list_push(list_empty(), value_string(code)), detail);
}

// c after its pure message name(args) (tutuca's apply): an ok result with the
// component it is now (c itself when nothing changed, another one when the
// handler swapped it), or an error result saying what broke: "unknown" (no
// such message, or c has no schema to say it's pure), "not-pure", "args",
// "arg:<i>", "pre" (detail: its why), "failed" (the handler rejected it),
// "post", and with invariants, "invariant:<name>". In a handler, applying to
// a child it holds joins its task, whose dev checks see the invariants.
fn component_try_apply(
    c: &component,
    name: js_string,
    args: &value_array,
    invariants: i32,
) -> &value {
    let found = spec_message_schema(c.spec, name);
    if !found {
        return apply_fail(c, name, s_a_unknown, s_empty);
    }
    let ms = found!;
    if !ms.pure {
        return apply_fail(c, name, s_a_not_pure, s_empty);
    }
    if args.length() != ms.args.length() {
        return apply_fail(c, name, s_args, arity_problem(ms.args.length(), args.length()));
    }
    let coerced = [value_array|null; args.length()];
    let i = 0;
    while i <s args.length() {
        let f = ms.args[i]!;
        let problem = field_problem(f, vtype_coerce(f.vtype, args[i]!), c);
        if !!problem {
            return
                apply_fail(
                    c,
                    name,
                    js_string_concat(s_a_arg, int_text(i)),
                    arg_problem(i, f.name, problem!),
                );
        }
        coerced[i] = vtype_coerce(f.vtype, args[i]!);
        i += 1;
    }
    let ctx = detached_ctx(c);
    if !!ms.pre {
        if !(ms.pre!)(c.instance, coerced, ctx) {
            let why = s_empty;
            if !!ms.why {
                why = ms.why!;
            }
            return apply_fail(c, name, s_pre, why);
        }
    }
    let result = c.vtable.handle(c.instance, {message| name, args: coerced }, ctx);
    let next = c;
    if result.kind == message_result_kind_updated {
        next = component_updated(c, (result as &message_result_updated).instance);
    }
    if result.kind == message_result_kind_swapped {
        next = (result as &message_result_swapped).component;
    }
    if result.kind == message_result_kind_rejected {
        let error = (result as &message_result_rejected).error;
        if error.kind == message_error_kind_unknown_message {
            return apply_fail(c, name, s_a_unknown, s_empty);
        }
        let detail = s_empty;
        if error.kind == message_error_kind_failed {
            detail = reason_text((error as &message_error_failed).reason);
        }
        return apply_fail(c, name, s_a_failed, detail);
    }
    if !!ms.post & (next.spec == c.spec) {
        if !(ms.post!)(c.instance, next.instance, coerced, ctx) {
            return apply_fail(c, name, s_post, s_empty);
        }
    }
    if invariants & (next != c) & !!next.spec.schema {
        let issues = list_empty();
        let invs = (next.spec.schema!).invariants;
        i = 0;
        while i <s invs.length() {
            let inv = invs[i]!;
            if !inv.holds(next.instance) {
                issues = list_push(issues, value_string(js_string_concat(
                                                             s_a_invariant,
                                                             inv.name,
                                                         )));
            }
            i += 1;
        }
        if list_count(issues) != 0 {
            return apply_error(c, name, issues, s_empty);
        }
    }
    value_ok(value_component(next));
}

// What a handler's component_apply gives: the component v holds after its
// pure message name(args), or the task fails saying what broke ("TodoItem
// can't apply set_done: pre (it's archived)").
fn component_apply(v: &value, name: js_string, args: &value_array) -> &value {
    let c = value_as_component(v);
    if !c {
        host_fail(js_string_concat(s_err_apply_not_component, name));
        unreachable;
    }
    let result = component_try_apply(c!, name, args, 0) as &value_result;
    if result.ok {
        return result.value;
    }
    let b = text_builder_new();
    text_push(b, (c!).spec.name);
    text_push(b, s_a_cant_apply);
    text_push(b, name);
    text_push(b, s_colon_space);
    text_push(b, value_string_of(map_get(result.value, s_code)!)!);
    let detail = value_string_of(map_get(result.value, s_detail)!)!;
    if !str_eq(detail, s_empty) {
        text_push(b, s_r_paren_open);
        text_push(b, detail);
        text_push_unit(b, ')');
    }
    host_fail(text_finish(b));
    unreachable;
}

// component_try_apply for a value: an error result for one that isn't a
// component.
fn value_try_apply(v: &value, name: js_string, args: &value_array, invariants: i32) -> &value {
    let c = value_as_component(v);
    if !c {
        let m = map_assoc(map_empty(), s_code, value_string(s_a_not_component));
        m = map_assoc(m, s_issues, list_push(list_empty(), value_string(s_a_not_component)));
        m = map_assoc(m, s_detail, value_string(s_empty));
        return value_err(map_assoc(m, s_message, value_string(name)));
    }
    component_try_apply(c!, name, args, invariants);
}

// What c offers (tutuca's contractOf): { name, implements, messages: [{
// name, pure, args }], queries: [{ name, args }] }, args as field schemas;
// null for a type without a schema.
fn component_contract(c: &component) -> &value {
    if !c.spec.schema {
        return VALUE_NULL;
    }
    let schema = c.spec.schema!;
    let messages = list_empty();
    let i = 0;
    while i <s schema.messages.length() {
        let ms = schema.messages[i]!;
        if !has_dot(ms.name) {
            let m = map_assoc(map_empty(), s_name, value_string(ms.name));
            m = map_assoc(m, s_pure, value_bool(ms.pure));
            messages = list_push(messages, map_assoc(m, s_args, field_schemas_value(ms.args)));
        }
        i += 1;
    }
    let queries = list_empty();
    i = 0;
    while i <s schema.queries.length() {
        let qs = schema.queries[i]!;
        let q = map_assoc(map_empty(), s_name, value_string(qs.name));
        queries = list_push(queries, map_assoc(q, s_args, field_schemas_value(qs.args)));
        i += 1;
    }
    let m = map_assoc(map_empty(), s_name, value_string(c.spec.name));
    m = map_assoc(m, s_implements, strs_value(schema.interfaces));
    m = map_assoc(m, s_messages, messages);
    map_assoc(m, s_queries, queries);
}

// What c lacks to implement the interface registered as name in its scope,
// as a list of problems (tutuca's supports): empty when it implements it.
fn component_supports(c: &component, name: js_string) -> &value {
    let iface = scope_lookup_interface(c.scope, name);
    if !iface {
        return list_push(list_empty(), value_string(js_string_concat(s_a_no_interface, name)));
    }
    let problem = interface_problem(c.spec, iface!);
    if !problem {
        return list_empty();
    }
    list_push(list_empty(), value_string(problem!));
}

fn message_problem(c: &component, name: js_string, args: &value_array) -> js_string_opt {
    let ms = spec_message_schema(c.spec, name);
    if !ms {
        return null;
    }
    let m = ms!;
    if args.length() != m.args.length() {
        return arity_problem(m.args.length(), args.length());
    }
    let i = 0;
    while i <s args.length() {
        let f = m.args[i]!;
        let problem = field_problem(f, args[i]!, c);
        if !!problem {
            return arg_problem(i, f.name, problem!);
        }
        i += 1;
    }
    if !!m.pre {
        let root = {dispatch_path| frames: [frame_array|null; 0] };
        let ctx =
            {context|
                scope: c.scope,
                path: root,
                source_key: null,
                event: VALUE_NULL,
                drag: VALUE_NULL,
                effects: effect_buf_new(),
                request: 0,
            };
        if !(m.pre!)(c.instance, args, ctx) {
            return s_pre;
        }
    }
    null;
}
