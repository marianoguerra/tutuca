// The component ABI: every function a component module imports from the
// runtime, as module "tutuca". The prelude (prelude/*.wax) has the types both
// sides share, and no code: the code is here, once.
//
// This file is the one list of the ABI. The build reads the wrappers below
// and writes the import block components are assembled with
// (dist/prelude/abi_imports.wax), so each wrapper is an export attribute
// naming the export, then `fn abi_` and that name, its parameters (no
// tuples) and its result.
// JS calls these exports too. A change to them, or to the prelude's types,
// is a change of tutuca_abi_version_current.

#[export = "tutuca_abi_version"]
fn abi_tutuca_abi_version() -> i32 {
    tutuca_abi_version_current;
}

// Values (value.wax, str.wax). Reading a value's kind or a case's field is a
// field read, which components do themselves.

#[export = "value_null"]
fn abi_value_null() -> &value {
    value_null();
}

#[export = "value_bool"]
fn abi_value_bool(v: i32) -> &value {
    value_bool(v);
}

#[export = "value_int"]
fn abi_value_int(v: i32) -> &value {
