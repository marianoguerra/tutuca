// Helpers for writing component types in Wax by hand: views, small arrays,
// selectors, and reading init's fields. A view language would generate what
// these spell out. They're compiled into the runtime, once, and component
// modules import them through src/abi.wax like the runtime's own functions.

fn values0() -> &value_array {
    [value_array|null; 0];
}

fn values1(a: &value) -> &value_array {
    let out = [value_array|null; 1];
    out[0] = a;
    out;
}

fn strs0() -> &str_array {
    [str_array|null; 0];
}

fn strs1(a: &extern) -> &str_array {
    let out = [str_array|null; 1];
    out[0] = a;
    out;
}

fn strs2(a: &extern, b: &extern) -> &str_array {
    let out = [str_array|null; 2];
    out[0] = a;
    out[1] = b;
    out;
}

fn strs3(a: &extern, b: &extern, c: &extern) -> &str_array {
    let out = [str_array|null; 3];
    out[0] = a;
    out[1] = b;
    out[2] = c;
    out;
}

// b.item(name, key): the component at key in the field name.
fn selector_item(name: &extern, key: &path_key) -> &selector {
    let steps = [selector_step_array|null; 1];
    steps[0] = selector_step_item(name, key);
    {selector| steps };
}

// b.field(name)
fn selector_field(name: &extern) -> &selector {
    let steps = [selector_step_array|null; 1];
    steps[0] = selector_step_field(name);
    {selector| steps };
}

fn no_provides() -> &selector_array {
    [selector_array|null; 0];
}

fn views0() -> &view_array {
    [view_array|null; 0];
}

fn views1(a: &view) -> &view_array {
    let out = [view_array|null; 1];
    out[0] = a;
    out;
}

fn views2(a: &view, b: &view) -> &view_array {
    let out = [view_array|null; 2];
    out[0] = a;
    out[1] = b;
    out;
}

fn views3(a: &view, b: &view, c: &view) -> &view_array {
    let out = [view_array|null; 3];
    out[0] = a;
    out[1] = b;
    out[2] = c;
    out;
}

fn views4(a: &view, b: &view, c: &view, d: &view) -> &view_array {
    let out = [view_array|null; 4];
    out[0] = a;
    out[1] = b;
    out[2] = c;
    out[3] = d;
    out;
}

fn views5(a: &view, b: &view, c: &view, d: &view, e: &view) -> &view_array {
    let out = [view_array|null; 5];
    out[0] = a;
    out[1] = b;
    out[2] = c;
    out[3] = d;
    out[4] = e;
    out;
}

// A string constant, as an attr value or a text child.
fn text(s: &extern) -> &view {
    view_const(value_string(s));
}

// An element without attrs or handlers.
fn el(tag_name: &extern, childs: &view_array) -> &view {
    view_el(tag_name, null, strs0(), views0(), null, childs, view_ons0());
}

// An element with attrs (names aligned with values) and no handlers.
fn el_attrs(
    tag_name: &extern,
    names: &str_array,
    values: &view_array,
    childs: &view_array,
) -> &view {
    view_el(tag_name, null, names, values, null, childs, view_ons0());
}

// An element whose only attr is a constant class.
fn el_class(tag_name: &extern, class: &extern, childs: &view_array) -> &view {
    view_el(tag_name, null, strs1(s_class), views1(text(class)), null, childs, view_ons0());
}

// The same, with handlers.
fn el_class_on(
    tag_name: &extern,
    class: &extern,
    childs: &view_array,
    ons: &view_on_array,
) -> &view {
    view_el(tag_name, null, strs1(s_class), views1(text(class)), null, childs, ons);
}

// An element with attrs and handlers.
fn el_on(
    tag_name: &extern,
    names: &str_array,
    values: &view_array,
    childs: &view_array,
    ons: &view_on_array,
) -> &view {
    view_el(tag_name, null, names, values, null, childs, ons);
}

// A component type with only a main view, no scopes and no provides.
fn spec_main(name: &extern, main: &view, loops: &loop_def_array) -> &component_spec {
    spec_new(name, strs1(s_main), views1(main), loops, no_scopes(), strs0(), no_provides());
}

fn no_loops() -> &loop_def_array {
    [loop_def_array|null; 0];
}

fn loops1(a: &loop_def) -> &loop_def_array {
    let out = [loop_def_array|null; 1];
    out[0] = a;
    out;
}

fn no_scopes() -> &scope_def_array {
    [scope_def_array|null; 0];
}

fn view_ons0() -> &view_on_array {
    [view_on_array|null; 0];
}

// One handler: on `event`, send `name` with `args`.
fn view_ons1(event: &extern, name: &extern, args: &view_array) -> &view_on_array {
    let out = [view_on_array|null; 1];
    out[0] = view_on(event, view_action(name, args));
    out;
}

// init's issues: a list of { field, problem } maps.
fn init_issue(issues: &value, field: &extern, problem: &extern) -> &value {
    let issue =
        map_assoc(
            map_assoc(map_empty(), s_field, value_string(field)),
            s_problem,
            value_string(problem),
        );
    list_push(issues, issue);
}

fn init_ok(instance: &eq, issues: &value) -> &init_result {
    {init_result| instance, issues, error: null };
}

// The field name of init's fields when it's an int; else default, with an
// issue saying why: missing, or the wrong type.
fn init_int(fields: &value, name: &extern, default: i32, issues: &value) -> (i32, &value) {
    let found = fields.kind == value_kind_map?map_get(fields, name):null;
    if !found {
        return (default, init_issue(issues, name, s_missing));
    }
    if (found!).kind != value_kind_int {
        return (default, init_issue(issues, name, s_wrong_type));
    }
    ((found! as &value_int).value, issues);
}

// The same for a list.
fn init_list(fields: &value, name: &extern, issues: &value) -> (&value, &value) {
    let found = fields.kind == value_kind_map?map_get(fields, name):null;
    if !found {
        return (list_empty(), init_issue(issues, name, s_missing));
    }
    if (found!).kind != value_kind_list {
        return (list_empty(), init_issue(issues, name, s_wrong_type));
    }
    (found!, issues);
}

// The same for a string.
fn init_string(
    fields: &value,
    name: &extern,
    default: &extern,
    issues: &value,
) -> (&extern, &value) {
    let found = fields.kind == value_kind_map?map_get(fields, name):null;
    if !found {
        return (default, init_issue(issues, name, s_missing));
    }
    let text = value_string_of(found!);
    if !text {
        return (default, init_issue(issues, name, s_wrong_type));
    }
    (text!, issues);
}

// The same for a bool.
fn init_bool(fields: &value, name: &extern, default: i32, issues: &value) -> (i32, &value) {
    let found = fields.kind == value_kind_map?map_get(fields, name):null;
    if !found {
        return (default, init_issue(issues, name, s_missing));
    }
    if (found!).kind != value_kind_bool {
        return (default, init_issue(issues, name, s_wrong_type));
    }
    ((found! as &value_bool).value, issues);
}

// The int argument at i, or null when it isn't one.
fn arg_int(args: &value_array, i: i32) -> (i32, i32) {
    if i >=s args.length() {
        return (0, 0);
    }
    let v = args[i]!;
    if v.kind != value_kind_int {
        return (0, 0);
    }
    (1, (v as &value_int).value);
}

// The bool argument at i, the same way.
fn arg_bool(args: &value_array, i: i32) -> (i32, i32) {
    if i >=s args.length() {
        return (0, 0);
    }
    let v = args[i]!;
    if v.kind != value_kind_bool {
        return (0, 0);
    }
    (1, (v as &value_bool).value);
}

// n in decimal, as a JS string.
fn int_text(n: i32) -> &extern {
    let b = text_builder_new();
    text_push_int(b, n);
    text_finish(b);
}

// A string of decimal digits (an optional leading '-') as an int: (1, n), or
// (0, 0) when it isn't one.
fn parse_int(s: &extern) -> (i32, i32) {
    let r = {json_reader| text: s, pos: 0, end: js_string_length(s), ok: 1 };
    let n = jr_int(r);
    if !r.ok | (r.pos != r.end) {
        return (0, 0);
    }
    (1, n);
}

// n as JS's String(n) writes it.
fn number_text(n: f64) -> &extern {
    host_number_text(n);
}

// s as a number, the way JS's Number(s) reads it, blank text not being one:
// (1, n), or (0, 0) when it isn't a finite number.
fn parse_number(s: &extern) -> (i32, f64) {
    let n = host_parse_number(s);
    if (n == n) & (n - n == 0.0) {
        return (1, n);
    }
    (0, 0.0);
}

// s as a JSON string, quoted and escaped as JSON.stringify writes it.
fn json_string(s: &extern) -> &extern {
    let b = text_builder_new();
    text_push_json_string(b, s);
    text_finish(b);
}

// Compact JSON text (no whitespace outside strings) indented as
// JSON.stringify(v, null, 2) writes it: an item or entry per line, two
// spaces a level, ": " after a key, empty arrays and objects as [] and {}.
fn json_indent(text: &extern) -> &extern {
    let b = text_builder_new();
    let n = js_string_length(text);
    let depth = 0;
    let in_string = 0;
    let escaped = 0;
    let i = 0;
    while i <s n {
        let unit = js_string_char_code_at(text, i);
        if in_string {
            text_push_unit(b, unit);
            if escaped {
                escaped = 0;
            } else {
                if unit == UNIT_BACKSLASH {
                    escaped = 1;
                } else {
                    if unit == UNIT_QUOTE {
                        in_string = 0;
                    }
                }
            }
        } else {
            if unit == UNIT_QUOTE {
                in_string = 1;
                text_push_unit(b, unit);
            } else {
                if (unit == '[') | (unit == '{') {
                    text_push_unit(b, unit);
                    let next = -1;
                    if i + 1 <s n {
                        next = js_string_char_code_at(text, i + 1);
                    }
                    if (next == ']') | (next == '}') {
                        text_push_unit(b, next);
                        i += 1;
                    } else {
                        depth += 1;
                        json_indent_line(b, depth);
                    }
                } else {
                    if (unit == ']') | (unit == '}') {
                        depth -= 1;
                        json_indent_line(b, depth);
                        text_push_unit(b, unit);
                    } else {
                        text_push_unit(b, unit);
                        if unit == ',' {
                            json_indent_line(b, depth);
                        }
                        if unit == ':' {
                            text_push_unit(b, ' ');
                        }
                    }
                }
            }
        }
        i += 1;
    }
    text_finish(b);
}

fn json_indent_line(b: &text_builder, depth: i32) {
    text_push_unit(b, '\n');
    let i = 0;
    while i <s depth * 2 {
        text_push_unit(b, ' ');
        i += 1;
    }
}

// ---- Schemas -------------------------------------------------------------------
//
// What a TCD file declares, spelled out by hand: fields and arguments with
// their types and constraints, messages, and a component type's schema.

// A field or an argument: its name and type, no constraints, shared.
fn fs(name: &extern, vt: &vtype) -> &field_schema {
    field_schema_new(name, vt, [constraint_array|null; 0], sync_shared);
}

// The same, with one constraint, or two.
fn fs1(name: &extern, vt: &vtype, c: &constraint) -> &field_schema {
    let cs = [constraint_array|null; 1];
    cs[0] = c;
    field_schema_new(name, vt, cs, sync_shared);
}

fn fs2(name: &extern, vt: &vtype, c1: &constraint, c2: &constraint) -> &field_schema {
    let cs = [constraint_array|null; 2];
    cs[0] = c1;
    cs[1] = c2;
    field_schema_new(name, vt, cs, sync_shared);
}

fn fields0() -> &field_schema_array {
    [field_schema_array|null; 0];
}

fn fields1(a: &field_schema) -> &field_schema_array {
    let out = [field_schema_array|null; 1];
    out[0] = a;
    out;
}

fn fields2(a: &field_schema, b: &field_schema) -> &field_schema_array {
    let out = [field_schema_array|null; 2];
    out[0] = a;
    out[1] = b;
    out;
}

fn fields3(a: &field_schema, b: &field_schema, c: &field_schema) -> &field_schema_array {
    let out = [field_schema_array|null; 3];
    out[0] = a;
    out[1] = b;
    out[2] = c;
    out;
}

// A message without a contract: its arguments only.
fn msg(name: &extern, args: &field_schema_array) -> &message_schema {
    message_schema_new(name, args, null, null, null, null, null);
}

// What a message may emit: one effect, or none.
fn emits1(kind: i32, name: &extern) -> &emit_array {
    let out = [emit_array|null; 1];
    out[0] = emit_spec_new(kind, name);
    out;
}

fn emits0() -> &emit_array {
    [emit_array|null; 0];
}

fn no_invariants() -> &invariant_array {
    [invariant_array|null; 0];
}

// ---- What generated components call (tcd) ---------------------------------------
//
// tcd generates a component's boilerplate from its TCD file; these are the
// runtime's side of that: reading init's fields, the schema checks, a
// handler's result by reference, and what compiled conditions evaluate with.

// The field name of init's fields, or null when it's missing or fields isn't a map.
fn field_value(fields: &value, name: &extern) -> &?value {
    if fields.kind != value_kind_map {
        return null;
    }
    map_get(fields, name);
}

// Init that can't make an instance: field is missing or invalid, and has no
// default (problem says how).
fn init_fail(issues: &value, field: &extern, problem: &extern) -> &init_result {
    let message = js_string_concat(js_string_concat(field, s_colon_space), problem);
    {init_result|
        instance: null,
        issues: init_issue(issues, field, problem),
        error: value_string(message),
    };
}

// A handler's next state: unchanged when it's the same reference.
fn message_result_of(prev: &eq, next: &eq) -> &message_result {
    if prev == next {
        return message_result_unchanged();
    }
    message_result_updated(next);
}

// ---- Conditions (when, ensures, invariant) -----------------------------------------

// a == b, as a condition compares: numbers by value, strings by content,
// lists and maps item by item, the rest by reference.
fn cond_eq(a: &value, b: &value) -> i32 {
    if value_same(a, b) {
        return 1;
    }
    if (a.kind == value_kind_list) & (b.kind == value_kind_list) {
        let n = list_count(a);
        if n != list_count(b) {
            return 0;
        }
        let i = 0;
        while i <s n {
            if !cond_eq(list_get(a, i)!, list_get(b, i)!) {
                return 0;
            }
            i += 1;
        }
        return 1;
    }
    if (a.kind == value_kind_map) & (b.kind == value_kind_map) {
        if map_count(a) != map_count(b) {
            return 0;
        }
        let keys = map_keys(a);
        let i = 0;
        while i <s list_count(keys) {
            let key = (list_get(keys, i)! as &value_string).value;
            let other = map_get(b, key);
            if !other {
                return 0;
            }
            if !cond_eq(map_get(a, key)!, other!) {
                return 0;
            }
            i += 1;
        }
        return 1;
    }
    0;
}

fn is_number(v: &value) -> i32 {
    (v.kind == value_kind_int) | (v.kind == value_kind_float);
}

// -1, 0 or 1 ordering numbers or strings; 2 when they don't order.
fn cond_order(a: &value, b: &value) -> i32 {
    if is_number(a) & is_number(b) {
        let x = value_to_f64(a);
        let y = value_to_f64(b);
        if x < y {
            return -1;
        }
        if x > y {
            return 1;
        }
        if x == y {
            return 0;
        }
        return 2;
    }
    if (a.kind == value_kind_string) & (b.kind == value_kind_string) {
        let s = (a as &value_string).value;
        let t = (b as &value_string).value;
        let n = js_string_length(s);
        let m = js_string_length(t);
        let i = 0;
        while (i <s n) & (i <s m) {
            let c = js_string_char_code_at(s, i);
            let d = js_string_char_code_at(t, i);
            if c != d {
                return c <s d?-1:1;
            }
            i += 1;
        }
        if n == m {
            return 0;
        }
        return n <s m?-1:1;
    }
    2;
}

fn cond_lt(a: &value, b: &value) -> i32 {
    cond_order(a, b) == -1;
}

fn cond_le(a: &value, b: &value) -> i32 {
    let o = cond_order(a, b);
    (o == -1) | (o == 0);
}

fn cond_gt(a: &value, b: &value) -> i32 {
    cond_order(a, b) == 1;
}

fn cond_ge(a: &value, b: &value) -> i32 {
    let o = cond_order(a, b);
    (o == 1) | (o == 0);
}

// a + b and a - b of numbers: an int when both are, null for anything else.
fn cond_add(a: &value, b: &value) -> &value {
    if (a.kind == value_kind_int) & (b.kind == value_kind_int) {
        return value_int((a as &value_int).value + (b as &value_int).value);
    }
    if is_number(a) & is_number(b) {
        return value_float(value_to_f64(a) + value_to_f64(b));
    }
    VALUE_NULL;
}

fn cond_sub(a: &value, b: &value) -> &value {
    if (a.kind == value_kind_int) & (b.kind == value_kind_int) {
        return value_int((a as &value_int).value - (b as &value_int).value);
    }
    if is_number(a) & is_number(b) {
        return value_float(value_to_f64(a) - value_to_f64(b));
    }
    VALUE_NULL;
}

// len(v): a string's, a list's or a map's; null for anything else.
fn cond_len(v: &value) -> &value {
    let n = value_length(v);
    if n <s 0 {
        return VALUE_NULL;
    }
    value_int(n);
}

// The items all(xs, ...) and any(xs, ...) go over: a list's, a map's values.
fn cond_count(v: &value) -> i32 {
    if v.kind == value_kind_list {
        return list_count(v);
    }
    if v.kind == value_kind_map {
        return map_count(v);
    }
    0;
}

fn cond_item(v: &value, i: i32) -> &value {
    if v.kind == value_kind_list {
        return list_get(v, i)!;
    }
    list_get(map_values(v), i)!;
}

// keys(f) and values(f), as lists.
fn cond_keys(v: &value) -> &value {
    if v.kind == value_kind_map {
        return map_keys(v);
    }
    let out = list_empty();
    let i = 0;
    while i <s cond_count(v) {
        out = list_push(out, value_int(i));
        i += 1;
    }
    out;
}

fn cond_values(v: &value) -> &value {
    if v.kind == value_kind_map {
        return map_values(v);
    }
    if v.kind == value_kind_list {
        return v;
    }
    list_empty();
}

// x in xs.
fn cond_in(x: &value, xs: &value) -> i32 {
    let i = 0;
    while i <s cond_count(xs) {
        if cond_eq(x, cond_item(xs, i)) {
            return 1;
        }
        i += 1;
    }
    0;
}

// s matches the regular expression pattern.
fn cond_matches(s: &value, pattern: &extern) -> i32 {
    if s.kind != value_kind_string {
        return 0;
    }
    host_regex_test(pattern, (s as &value_string).value);
}

// v.name: a component's property, a map's key; null when it has none.
fn value_member(v: &value, name: &extern) -> &value {
    if v.kind == value_kind_map {
        let found = map_get(v, name);
        if !found {
            return VALUE_NULL;
        }
        return found!;
    }
    let c = value_as_component(v);
    if !c {
        return VALUE_NULL;
    }
    let got = owner_field(c!, name);
    if !got {
        return VALUE_NULL;
    }
    got!;
}
