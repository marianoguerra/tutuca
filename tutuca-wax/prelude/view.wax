// Views as data (the spec's view/view.rkt `e`; the AstNodes of tutuca's
// src/view.js): what a component type's views are before any render, so a
// walker (src/walk.wax) can visit every branch of an if and every loop body
// once, with the bindings still unevaluated. src/view.wax has the
// constructors.

const view_kind_const = 0;
const view_kind_field = 1;
const view_kind_seq_item = 2;
const view_kind_provided = 3;
const view_kind_lookup_bind = 4;
const view_kind_if = 5;
const view_kind_el = 6;
const view_kind_frag = 7;
const view_kind_render = 8;
const view_kind_each = 9;
const view_kind_render_each = 10;
const view_kind_render_it = 11;
const view_kind_scope = 12;
const view_kind_push_view = 13;
const view_kind_action = 14;
const view_kind_target_value = 15;
const view_kind_source_key = 16;
const view_kind_drag_key = 17;

rec {
    type view = open { kind: i32 };
    // A literal.
    type view_const: view = { .., value: &value };
    // ctx.it[name].
    type view_field: view = { .., name: &extern };
    // ctx.it[seq_name][ctx.it[key_name]].
    type view_seq_item: view = { .., seq_name: &extern, key_name: &extern };
    // The value an ancestor provides under name.
    type view_provided: view = { .., name: &extern };
    // A loop or scope bind.
    type view_lookup_bind: view = { .., name: &extern };
    // $if: both branches stay in the view.
    type view_if: view = { .., test: &view, then: &view, otherwise: &view };
    // h(tag, attrs, ...childs). attr_values align with attr_names. template is
    // null until the views of a component type are collected
    // (views_collect_templates), which makes it once and numbers its tid.
    type view_el: view = {
        ..,
        tag_name: &extern,
        ns: &?extern,
        attr_names: &str_array,
        attr_values: &view_array,
        key: &?view,
        childs: &view_array,
        handlers: &view_on_array,
        template: mut &?template
    };
    // Several roots.
    type view_frag: view = { .., childs: &view_array };
    // render(source, view_name).
    type view_render: view = { .., source: &view, view_name: &?extern };
    // each(source, body, loop_name): body once, for every item.
    type view_each: view = { .., source: &view, body: &view, loop_name: &?extern };
    // renderEach(source, loop_name).
    type view_render_each: view = { .., source: &view, loop_name: &?extern };
    // renderIt(view_name), inside an each body.
    type view_render_it: view = { .., view_name: &?extern };
    // scope(scope_name, body).
    type view_scope: view = { .., scope_name: &extern, body: &view };
    // pushView(view_name, body).
    type view_push_view: view = { .., view_name: &view, body: &view };
    // send(name, ...args), what on:<event> holds.
    type view_action: view = { .., name: &extern, args: &view_array };
    // The value of the element with the handler, as a send argument.
    type view_target_value: view = { .. };
    // The item key of the child a message arrived from, as a send argument.
    type view_source_key: view = { .. };
    // The item key of the child the dragged element is in, as a send
    // argument; null when nothing, or something from elsewhere, is dragged.
    type view_drag_key: view = { .. };
    // on:<event>.
    type view_on = { event: &extern, action: &view_action };
    type view_array = [mut &?view];
    type view_on_array = [mut &?view_on];
}
