// The studio's own components, in tutuca-wax: the screens as tabs, the
// screen shown, the menu, the picker a new screen's scope is chosen in, and
// the editor a component is written in. What only the page can do is the
// host's (studio.js), asked for: keeping the library (save_screen,
// save_scope, delete_screen, save_component), making a screen or a preview
// in its scope chain (open_screen, preview, which answer with the component
// made, rendered here), building (build), confirming, and moving the library
// in and out. The host tells the studio what happens outside it by sending
// it messages: show_screen at the start, open_editor when a hole asks for a
// new component or a slot's ✎ for one to edit, reopen when a component a
// screen uses changed, say and note for the status line and the events,
// editor_write, editor_state and editor_note for the editor, set_library
// after an import.
package tutuca:studio@0.1.0;

/// The tree a new screen's scope is picked from, a child scope added under
/// any of them, and the screen's name.
component ScopePicker {
    /// The library's scopes; the root's parent is "".
    field scopes: list<record { id: string, name: string, parent: string }>;
    /// The scope picked, by id.
    field selected: string;
    /// The scope a child is being added under, by id; "" while none is.
    field adding: string;
    field name: string where len(name) <= 60;
    /// The name it gets when none is written.
    field placeholder: string = "screen 1";
    /// The scopes in the tree's order, each with what its row shows.
    get tree: list<record { id: string, name: string, on: bool, adding: bool, indent: string, child_indent: string, add_label: string }>;

    /// To the studio: make a screen in scope, named name.
    notify create_screen(scope: string, name: string);
    notify close_picker();
    /// To the studio: a scope was added, so its list has it.
    notify scope_added(id: string, name: string, parent: string);
    ask save_scope(id: string, name: string, parent: string) -> bool;

    /// at is a row of the tree.
    message pick(at: s32) changes selected;
    message start_adding(at: s32) changes adding;
    message cancel_adding() changes adding ensures len(next.adding) == 0;
    /// A child of the scope being added under, picked; saved by the host.
    message add_scope(name: string) when len(adding) > 0 changes scopes, selected, adding
        ensures len(next.scopes) == len(scopes) + 1
        emits ask save_scope, notify scope_added;
    message set_name(name: string where len(name) <= 60) changes name ensures next.name == name;
    message create() changes nothing emits notify create_screen;
    message cancel() changes nothing emits notify close_picker;

    view main = dialog(class: "modal modal-open", open: "open", "aria-label": "New screen",
        div(class: "modal-box flex flex-col gap-3",
            h3(class: "text-lg font-bold", "New screen"),
            p(class: "text-xs uppercase tracking-wide opacity-60", "the scope it's made in"),
            div(class: "st-tree flex flex-col gap-0.5 max-h-80 overflow-auto rounded-box border border-base-300 p-1", role: "tree",
                each(field(tree),
                    div(class: "flex flex-col gap-0.5",
                        div(class: "flex items-center gap-1", style: field(indent),
                            button(class: if(field(on), "st-scope btn btn-sm btn-active flex-1 justify-start font-mono", "st-scope btn btn-sm btn-ghost flex-1 justify-start font-mono"),
                                role: "treeitem", "aria-selected": if(field(on), "true", "false"),
                                on_click: send(pick, source_key()), field(name)),
                            button(class: "btn btn-xs btn-ghost", title: field(add_label), "aria-label": field(add_label),
                                on_click: send(start_adding, source_key()), "+")),
                        if(field(adding),
                            div(class: "flex items-center gap-1", style: field(child_indent),
                                input(class: "input input-sm", placeholder: "scope's name", "aria-label": "New scope's name", autofocus: "autofocus",
                                    "on_keydown+enter+prevent": send(add_scope, target_value()),
                                    "on_keydown+escape+prevent": send(cancel_adding))))))),
            p(class: "text-xs uppercase tracking-wide opacity-60", "its name"),
            input(class: "input input-sm", placeholder: field(placeholder), "aria-label": "New screen's name", value: field(name),
                on_input: send(set_name, target_value()),
                "on_keydown+enter+prevent": send(create)),
            div(class: "modal-action mt-0",
                button(class: "btn btn-sm btn-ghost", on_click: send(cancel), "Cancel"),
                button(class: "btn btn-sm btn-primary", on_click: send(create), "Create"))));
}

/// A component being written or edited: its .tcd and .wax in a code editor
/// (tw-code-editor, code-editor.js), built by the host as they change, what
/// the build says, and a preview of one of the types it registers, made in
/// the screen's scope chain; the assistant beside it when there is one.
component Editor {
    /// A new component, registered in the screen's scope when it's saved,
    /// or one of the library's.
    field creating: bool;
    field id: string;
    field name: string;
    field tcd: string;
    field wax: string;
    /// The sources as they were opened, to tell whether they changed.
    field saved: record { name: string, tcd: string, wax: string };
    /// The file shown: "tcd" or "wax".
    field current: string = "tcd";
    field status: string;
    field building: bool;
    /// What the last build said: tcd's diagnostics, each type it registers
    /// and whether a hole can make it, and the ones that can.
    field diagnostics: list<record { file: string, line: s32, col: s32, end_line: s32, end_col: s32, severity: string, message: string, error: bool, warning: bool }>;
    field registers: list<record { name: string, ok: bool, note: string }>;
    field makeable: list<record { name: string }>;
    field preview_type: string;
    /// The preview, as the host made it (sync none: made again from the build).
    field preview: list<component> @sync(none);
    /// The preview's state, as JSON text, and what its host reported.
    field state_text: string;
    field events: list<record { kind: string, text: string }> where len(events) <= 200;
    /// The inspector shown: "diagnostics", "registers", "state" or "events".
    field inspecting: string = "diagnostics";
    /// Whether there's an assistant, and whether it's open.
    field assistant: bool;
    field chat: bool;
    /// Where the code editor jumps: "file:line:col", and a count that makes
    /// each jump a new value.
    field goto_at: string;
    field jumps: s32;
    get changed: bool;
    get tcd_file: string;
    get wax_file: string;
    get on_tcd: bool;
    get several_types: bool;
    get on_diagnostics: bool;
    get on_registers: bool;
    get on_state: bool;
    get on_events: bool;

    /// The sources built: what tcd says, and what it registers.
    ask build(id: string, name: string, tcd: string, wax: string) -> record {
        ok: bool,
        status: string,
        makeable: list<record { name: string }>,
        registers: list<record { name: string, ok: bool, note: string }>,
        diagnostics: list<record { file: string, line: s32, col: s32, end_line: s32, end_col: s32, severity: string, message: string, error: bool, warning: bool }>
    };
    /// One of its types, made with no fields where the screen's holes make.
    ask preview(id: string, type: string) -> component;
    /// Kept in the library (and registered in the screen's scope when it's
    /// new): what to say, or why it can't be.
    ask save_component(creating: bool, id: string, name: string, tcd: string, wax: string) -> string;
    ask leave_editor(creating: bool) -> bool;
    ask confirm(text: string) -> bool;
    /// To the studio: done, saved or not.
    notify close_editor();

    message set_tcd(text: string) changes tcd ensures next.tcd == text;
    message set_wax(text: string) changes wax ensures next.wax == text;
    message show_file(file: string) changes current;
    message rename(name: string) changes name;
    message build() changes building, status emits ask build;
    message pick_type(type: string) changes preview_type, preview emits ask preview;
    message inspect(tab: string) changes inspecting ensures next.inspecting == tab;
    message goto_diagnostic(at: index<diagnostics>) changes current, goto_at, jumps;
    message toggle_chat() when assistant changes chat ensures next.chat == not chat;
    message save() changes status emits ask save_component;
    message back() changes nothing emits ask confirm, ask leave_editor;
    /// From the host: what the assistant wrote, built.
    message write(tcd: string, wax: string) changes tcd, wax, building, status emits ask build;
    message set_state(text: string) changes state_text ensures next.state_text == text;
    message note(kind: string, text: string) changes events;

    view main = section(class: "flex-1 min-h-0 flex flex-col",
        div(class: "st-editor-bar flex flex-wrap items-center gap-2 border-b border-base-300 bg-base-100 px-2 py-1",
            button(class: "btn btn-sm btn-ghost", title: "Back to the screen, without saving", on_click: send(back), "← Back"),
            input(class: "input input-sm font-mono w-48", "aria-label": "Component name", value: field(name),
                on_change: send(rename, target_value())),
            button(class: "btn btn-sm", title: "Ctrl/Cmd-Enter", on_click: send(build), "Build"),
            if(field(assistant),
                button(class: if(field(chat), "btn btn-sm btn-primary", "btn btn-sm"), title: "Ask a model to change this component",
                    on_click: send(toggle_chat), "Assistant")),
            span(class: "flex-1"),
            span(class: "st-status text-xs opacity-70 truncate max-w-[40%]", title: field(status), field(status)),
            button(class: "btn btn-sm btn-primary", title: "Keep it and register it in the screen's scope", on_click: send(save),
                if(field(creating), "Save & register", "Save"))),
        div(class: if(field(chat),
                "st-work flex-1 min-h-0 grid gap-2 p-2 grid-cols-1 lg:grid-cols-2 xl:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_24rem]",
                "st-work flex-1 min-h-0 grid gap-2 p-2 grid-cols-1 lg:grid-cols-2"),
            section(class: "card card-border bg-base-100 min-h-0 min-w-0 flex flex-col gap-2 p-2",
                div(class: "flex flex-wrap gap-1",
                    button(class: if(field(on_tcd), "btn btn-xs btn-active font-mono", "btn btn-xs btn-ghost font-mono"), on_click: send(show_file, "tcd"), field(tcd_file)),
                    button(class: if(field(on_tcd), "btn btn-xs btn-ghost font-mono", "btn btn-xs btn-active font-mono"), on_click: send(show_file, "wax"), field(wax_file))),
                el("tw-code-editor", class: "st-editor block flex-1 min-h-0 border border-base-300 rounded-box overflow-hidden",
                    name: field(name), tcd: field(tcd), wax: field(wax), current: field(current),
                    diagnostics: field(diagnostics), goto: field(goto_at), jumps: field(jumps),
                    "on_tcd-change": send(set_tcd, event(detail)),
                    "on_wax-change": send(set_wax, event(detail)),
                    on_run: send(build))),
            section(class: "card card-border bg-base-100 min-h-0 min-w-0 flex flex-col gap-2 p-2",
                div(class: "flex flex-wrap items-center gap-2",
                    span(class: "text-xs uppercase tracking-wide opacity-60", "preview"),
                    if(field(several_types),
                        select(class: "select select-sm st-preview-type", "aria-label": "Type to preview", value: field(preview_type),
                            on_change: send(pick_type, target_value()),
                            each(field(makeable), option(value: field(name), field(name)))))),
                div(class: "st-preview min-h-40 max-h-[50%] overflow-auto rounded-box border border-dashed border-base-300 p-3",
                    render_each(field(preview))),
                div(class: "tabs tabs-border tabs-sm", role: "tablist",
                    button(class: if(field(on_diagnostics), "st-inspector-tab tab tab-active", "st-inspector-tab tab"), role: "tab", on_click: send(inspect, "diagnostics"), "Diagnostics"),
                    button(class: if(field(on_registers), "st-inspector-tab tab tab-active", "st-inspector-tab tab"), role: "tab", on_click: send(inspect, "registers"), "Registers"),
                    button(class: if(field(on_state), "st-inspector-tab tab tab-active", "st-inspector-tab tab"), role: "tab", on_click: send(inspect, "state"), "State"),
                    button(class: if(field(on_events), "st-inspector-tab tab tab-active", "st-inspector-tab tab"), role: "tab", on_click: send(inspect, "events"), "Events")),
                div(class: "st-inspector flex-1 min-h-0 overflow-auto",
                    if(field(on_diagnostics),
                        div(class: "st-diagnostics font-mono text-xs flex flex-col",
                            each(field(diagnostics),
                                button(class: "text-left px-2 py-1 border-b border-base-300 hover:bg-base-200 cursor-pointer", on_click: send(goto_diagnostic, source_key()),
                                    span(class: if(field(error), "text-error font-semibold", if(field(warning), "text-warning font-semibold", "text-info font-semibold")), field(severity), " "),
                                    field(file), ":", field(line), ":", field(col), " ", field(message))))),
                    if(field(on_registers),
                        table(class: "table table-sm",
                            tbody(each(field(registers),
                                tr(td(class: "font-mono", field(name)), td(class: if(field(ok), "text-success", "text-error"), field(note))))))),
                    if(field(on_state), pre(class: "st-state font-mono text-xs whitespace-pre-wrap", field(state_text))),
                    if(field(on_events),
                        div(class: "st-events font-mono text-xs flex flex-col",
                            each(field(events), div(class: "py-0.5 border-b border-base-300", field(kind), ": ", field(text))))))),
            if(field(chat), el("tw-slot", class: "flex flex-col min-h-0", name: "assistant"))));
}

/// The studio: a tab per screen and the one shown, the picker while a new
/// screen is being made, the status line, the events, and the menu.
component Studio {
    field scopes: list<record { id: string, name: string, parent: string }>;
    /// The screens, in the order they were made.
    field screens: list<record { id: string, name: string, scope: string, created: f64 }>;
    /// The screen shown, by id; "" when none is.
    field active: string;
    /// The shown screen's component, as the host made it, and its id: none
    /// until it answers (sync none: the host keeps the layout).
    field shown: list<component> @sync(none);
    field shown_id: string @sync(none);
    /// The screen whose tab is being renamed, and the one asked about
    /// deleting, by id; "" when none is.
    field renaming: string @sync(none);
    field deleting: string @sync(none);
    /// The picker, while a new screen is being made.
    field picker: list<ScopePicker> @sync(none);
    /// The editor, while a component is written: the page is it then.
    field editor: list<Editor> @sync(none);
    field status: string @sync(none);
    /// The assistant's badge ("assistant: 2 models"), "" without one.
    field assistant: string;
    /// What the hosts reported, the newest first.
    field events: list<record { kind: string, text: string }> where len(events) <= 200 @sync(none);
    get has_screen: bool;
    get has_editor: bool;
    get events_label: string;

    /// The screen's component, made in its scope chain, with its id.
    ask open_screen(id: string) -> record { id: string, screen: component };
    ask save_screen(id: string, name: string, scope: string, created: f64) -> bool;
    ask delete_screen(id: string) -> bool;
    ask confirm(text: string) -> bool;
    ask export_library() -> bool;
    ask import_library() -> bool;
    ask edit_layout_json(id: string) -> bool;

    /// From the host, at the start and after an import.
    message show_screen(id: string) changes active, shown, shown_id, renaming emits ask open_screen;
    message show_at(at: index<screens>) changes active, shown, shown_id, renaming emits ask open_screen;
    /// From the host: a component the screen uses changed, so it's made again.
    message reopen() changes shown, shown_id emits ask open_screen;
    message start_rename(at: index<screens>) changes renaming;
    message rename(at: index<screens>, name: string) changes screens, renaming
        ensures len(next.screens) == len(screens) emits ask save_screen;
    message cancel_rename() changes renaming ensures len(next.renaming) == 0;
    message delete_at(at: index<screens>) changes deleting emits ask confirm;
    message open_picker() when len(picker) == 0 changes picker ensures len(next.picker) == 1 emits make ScopePicker;
    message close_picker() source_key: index<picker> changes picker ensures len(next.picker) == 0;
    message create_screen(scope: string, name: string) source_key: index<picker>
        changes picker, screens, active, shown, shown_id
        ensures len(next.screens) == len(screens) + 1
        emits ask save_screen, ask open_screen;
    message scope_added(id: string, name: string, parent: string) source_key: index<picker>
        changes scopes ensures len(next.scopes) == len(scopes) + 1;
    message say(text: string) changes status ensures next.status == text;
    message note(kind: string, text: string) changes events;
    message set_library(scopes: list<record { id: string, name: string, parent: string }>,
        screens: list<record { id: string, name: string, scope: string, created: f64 }>)
        changes scopes, screens, active, shown, shown_id;
    /// From the host: a hole asked for a new component, or a slot's ✎ for
    /// one of the library's; the editor opens on it and builds it.
    message open_editor(creating: bool, id: string, name: string, tcd: string, wax: string) when len(editor) == 0
        changes editor ensures len(next.editor) == 1 emits make Editor, send Editor.build;
    message close_editor() source_key: index<editor> changes editor ensures len(next.editor) == 0;
    /// From the host, for the editor: the assistant's files, the preview's
    /// state, what its host reported.
    message editor_write(tcd: string, wax: string) changes nothing emits send Editor.write;
    message editor_state(text: string) changes nothing emits send Editor.set_state;
    message editor_note(kind: string, text: string) changes nothing emits send Editor.note;
    message export_all() changes nothing emits ask export_library;
    message import_all() changes nothing emits ask import_library;
    message layout_json() when len(active) > 0 changes nothing emits ask edit_layout_json;

    /// The tabs: each screen, marked when it's shown or being renamed.
    loop tabs { enrich { is_active: bool, is_renaming: bool, close_label: string } }

    view main = div(class: "st-studio h-screen flex flex-col",
        if(field(has_editor), render_each(field(editor)), frag(
        header(class: "st-bar flex items-center gap-2 border-b border-base-300 bg-base-100 px-2 py-1",
            span(class: "text-sm font-bold opacity-70 px-1", "studio"),
            nav(class: "st-tabs flex items-center gap-1 overflow-x-auto min-w-0", role: "tablist",
                each(loop: tabs, field(screens),
                    div(class: if(bind(is_active), "st-tab group flex items-center rounded-btn bg-base-200 font-semibold", "st-tab group flex items-center rounded-btn hover:bg-base-200"),
                        if(bind(is_renaming),
                            input(class: "input input-xs w-32", "aria-label": "Screen name", value: field(name), autofocus: "autofocus",
                                on_change: send(rename, source_key(), target_value()),
                                "on_keydown+escape+prevent": send(cancel_rename)),
                            button(class: "px-3 py-1 text-sm whitespace-nowrap", role: "tab", "aria-selected": if(bind(is_active), "true", "false"),
                                title: "Double-click to rename",
                                on_click: send(show_at, source_key()), on_dblclick: send(start_rename, source_key()), field(name))),
                        button(class: "btn btn-xs btn-ghost btn-square opacity-0 group-hover:opacity-60 hover:opacity-100",
                            title: bind(close_label), "aria-label": bind(close_label), on_click: send(delete_at, source_key()), "×")))),
            button(class: "st-new-screen btn btn-sm btn-ghost btn-square", title: "New screen", "aria-label": "New screen", on_click: send(open_picker), "+"),
            span(class: "flex-1"),
            span(class: "st-status text-xs opacity-70 truncate max-w-[40%]", title: field(status), field(status)),
            if(field(assistant), span(class: "st-assistant badge badge-ghost badge-sm", title: "Served with an LLM assistant: open it from the editor", field(assistant))),
            div(class: "st-menu dropdown dropdown-end",
                div(class: "btn btn-sm btn-ghost btn-square", role: "button", tabindex: "0", title: "More", "aria-label": "More", "⋯"),
                ul(class: "menu menu-sm dropdown-content z-20 w-48 rounded-box border border-base-300 bg-base-100 p-1 shadow", tabindex: "0",
                    li(button(title: "The screen's layout as it's kept", on_click: send(layout_json), "Layout JSON")),
                    li(button(title: "Download the library as a bundle", on_click: send(export_all), "Export")),
                    li(button(title: "Add a bundle's components, scopes and screens", on_click: send(import_all), "Import")),
                    li(a(href: "../playground/", "Playground")),
                    li(a(href: "../demos/", "Demos"))))),
        if(field(has_screen),
            main(class: "flex-1 min-h-0 flex flex-col",
                div(class: "st-stage flex-1 min-h-0 overflow-auto p-4", render_each(field(shown))),
                details(class: "st-events-box border-t border-base-300 bg-base-100 text-xs",
                    summary(class: "cursor-pointer px-3 py-1 opacity-70", field(events_label)),
                    div(class: "st-events font-mono max-h-40 overflow-auto flex flex-col px-3 pb-2",
                        each(field(events),
                            div(class: "py-0.5 border-b border-base-300", field(kind), ": ", field(text)))))),
            main(class: "flex-1 flex flex-col items-center justify-center gap-3",
                p(class: "text-sm opacity-70 max-w-prose text-center",
                    "A screen is a layout made in a scope: fill its holes with the components that scope can make, or write new ones. Everything stays in this browser; export a bundle to take it elsewhere."),
                button(class: "btn btn-primary", on_click: send(open_picker), "+ New screen"))),
        render_each(field(picker)))));
}

register ScopePicker, Editor, Studio;

/// The page's: open_screen, save_screen, save_scope, delete_screen,
/// confirm, export_library, import_library and edit_layout_json for the
/// studio; build, preview, save_component and leave_editor for the editor.
host_ask open_screen;
host_ask save_screen;
host_ask save_scope;
host_ask delete_screen;
host_ask confirm;
host_ask export_library;
host_ask import_library;
host_ask edit_layout_json;
host_ask build;
host_ask preview;
host_ask save_component;
host_ask leave_editor;

example rename_a_tab for Studio {
    start { screens: [{ id: "a", name: "home", scope: "root", created: 1 }] }
    send start_rename(0);
    expect renaming == "a";
    send rename(0, "start");
    expect renaming == "" and len(screens) == 1;
}

example a_picker_at_a_time for Studio {
    start { }
    send open_picker();
    expect len(picker) == 1;
}

example adding_a_scope_picks_it for ScopePicker {
    start { scopes: [{ id: "root", name: "root", parent: "" }], selected: "root" }
    send start_adding(0);
    expect adding == "root";
    send add_scope("a");
    expect len(scopes) == 2 and adding == "";
}

example typing_and_switching_files for Editor {
    start { name: "tasks", tcd: "a", wax: "b", saved: { name: "tasks", tcd: "a", wax: "b" } }
    send set_tcd("c");
    expect tcd == "c";
    send show_file("wax");
    expect current == "wax";
}
