// studio.tcd has the rest. Scopes and screens are records, map values with
// their fields as entries: made with map_assoc, read with value_member.

import "'" {
    #[import = "margin-left: "]
    const s_margin_left: js_string;
    #[import = "rem"]
    const s_rem: js_string;
    #[import = "Add a scope in "]
    const s_add_a_scope_in: js_string;
    #[import = "Delete "]
    const s_delete: js_string;
    #[import = "Delete the screen "]
    const s_delete_the_screen: js_string;
    #[import = "?"]
    const s_question: js_string;
    #[import = "screen "]
    const s_screen: js_string;
    #[import = "events"]
    const s_events: js_string;
    #[import = "events ("]
    const s_events_open: js_string;
    #[import = ")"]
    const s_close: js_string;
    #[import = "root"]
    const s_root: js_string;
}

// A scope or a screen, as a record.
type studio_record = &value;
// A screen's or a scope's id.
type studio_id = js_string;

fn studio_text_of(record: studio_record, key: js_string) -> js_string {
    value_string_of(value_member(record, key))!;
}

fn studio_id_of(record: studio_record) -> studio_id {
    studio_text_of(record, gs_id);
}

// The index of the record with id in records, or -1.
fn studio_index_of(records: &value, id: studio_id) -> i32 {
    let i = 0;
    while i <s list_count(records) {
        if str_eq(studio_id_of(list_get(records, i)!), id) {
            return i;
        }
        i += 1;
    }
    -1;
}

fn studio_one(c: &value) -> &value {
    list_push(list_empty(), c);
}

// ---- ScopePicker -------------------------------------------------------------------

// A row of the tree: the scope, how deep it is, and what's marked on it.
fn scope_picker_row(state: &scope_picker_state, scope: studio_record, depth: i32) -> &value {
    let id = studio_id_of(scope);
    let name = studio_text_of(scope, gs_name);
    let row = map_assoc(map_empty(), gs_id, value_string(id));
    row = map_assoc(row, gs_name, value_string(name));
    row = map_assoc(row, gs_on, value_bool(str_eq(id, state.selected)));
    row = map_assoc(row, gs_adding, value_bool(str_eq(id, state.adding)));
    row = map_assoc(row, gs_indent, value_string(scope_picker_indent(depth)));
    row = map_assoc(row, gs_child_indent, value_string(scope_picker_indent(depth + 1)));
    map_assoc(row, gs_add_label, value_string(js_string_concat(s_add_a_scope_in, name)));
}

// A rem per level: "margin-left: 2rem".
fn scope_picker_indent(depth: i32) -> js_string {
    js_string_concat(js_string_concat(s_margin_left, int_text(depth)), s_rem);
}

// The children of parent, each followed by its own, depth first.
fn scope_picker_walk(state: &scope_picker_state, rows: &value, parent: studio_id, depth: i32) -> &value {
    let out = rows;
    let i = 0;
    while i <s list_count(state.scopes) {
        let scope = list_get(state.scopes, i)!;
        if str_eq(studio_text_of(scope, gs_parent), parent) {
            out = list_push(out, scope_picker_row(state, scope, depth));
            out = scope_picker_walk(state, out, studio_id_of(scope), depth + 1);
        }
        i += 1;
    }
    out;
}

fn scope_picker_get_tree(state: &scope_picker_state) -> &value {
    scope_picker_walk(state, list_empty(), gs_empty, 0);
}

// The id of the scope at row at of the tree.
fn scope_picker_id_at(state: &scope_picker_state, at: i32) -> studio_id {
    let row = list_get(scope_picker_get_tree(state), at);
    if !row {
        return gs_empty;
    }
    studio_id_of(row!);
}

fn scope_picker_on_pick(state: &scope_picker_state, ctx: &context, at: i32) -> &scope_picker_state {
    let id = scope_picker_id_at(state, at);
    if js_string_length(id) == 0 {
        return state;
    }
    scope_picker_with_selected(state, id);
}

fn scope_picker_on_start_adding(state: &scope_picker_state, ctx: &context, at: i32) -> &scope_picker_state {
    scope_picker_with_adding(state, scope_picker_id_at(state, at));
}

fn scope_picker_on_cancel_adding(state: &scope_picker_state, ctx: &context) -> &scope_picker_state {
    scope_picker_with_adding(state, gs_empty);
}

// A new scope under the one being added under, picked, saved by the host
// and told to the studio.
fn scope_picker_on_add_scope(state: &scope_picker_state, ctx: &context, name: js_string) -> &scope_picker_state {
    let id = ctx_uuid(ctx);
    let named = name;
    if js_string_length(named) == 0 {
        named = gs_scope;
    }
    let scope = map_assoc(map_assoc(map_assoc(map_empty(), gs_id, value_string(id)), gs_name, value_string(named)), gs_parent, value_string(state.adding));
    scope_picker_ask_save_scope(ctx, id, named, state.adding);
    scope_picker_notify_scope_added(ctx, id, named, state.adding);
    {scope_picker_state|
        scopes: list_push(state.scopes, scope),
        selected: id,
        adding: gs_empty,
        name: state.name,
        placeholder: state.placeholder,
    };
}

fn scope_picker_reply_save_scope_ok(state: &scope_picker_state, ctx: &context, reply: i32) -> &scope_picker_state {
    state;
}

fn scope_picker_on_set_name(state: &scope_picker_state, ctx: &context, name: js_string) -> &scope_picker_state {
    scope_picker_with_name(state, name);
}

// The name written, or the placeholder.
fn scope_picker_on_create(state: &scope_picker_state, ctx: &context) -> &scope_picker_state {
    let name = state.name;
    if js_string_length(name) == 0 {
        name = state.placeholder;
    }
    scope_picker_notify_create_screen(ctx, state.selected, name);
    state;
}

fn scope_picker_on_cancel(state: &scope_picker_state, ctx: &context) -> &scope_picker_state {
    scope_picker_notify_close_picker(ctx);
    state;
}

// ---- Studio: screens ---------------------------------------------------------------

// The screen with id shown: asked for, the one shown until then dropped.
fn studio_showing(state: &studio_state, ctx: &context, id: studio_id) -> &studio_state {
    if js_string_length(id) >s 0 {
        studio_ask_open_screen(ctx, id);
    }
    {studio_state|
        scopes: state.scopes,
        screens: state.screens,
        active: id,
        shown: list_empty(),
        shown_id: gs_empty,
        renaming: gs_empty,
        deleting: state.deleting,
        picker: state.picker,
        status: state.status,
        assistant: state.assistant,
        events: state.events,
    };
}

fn studio_on_show_screen(state: &studio_state, ctx: &context, id: js_string) -> &studio_state {
    studio_showing(state, ctx, id);
}

fn studio_on_show_at(state: &studio_state, ctx: &context, at: i32) -> &studio_state {
    studio_showing(state, ctx, studio_id_of(list_get(state.screens, at)!));
}

fn studio_on_reopen(state: &studio_state, ctx: &context) -> &studio_state {
    if js_string_length(state.active) == 0 {
        return state;
    }
    studio_ask_open_screen(ctx, state.active);
    studio_with_shown_id(studio_with_shown(state, list_empty()), gs_empty);
}

// The screen's component, unless another was asked for since.
fn studio_reply_open_screen_ok(state: &studio_state, ctx: &context, reply: &value) -> &studio_state {
    let id = studio_id_of(reply);
    if !str_eq(id, state.active) {
        return state;
    }
    studio_with_shown_id(studio_with_shown(state, studio_one(value_member(reply, gs_screen))), id);
}

fn studio_reply_open_screen_err(state: &studio_state, ctx: &context, error: &value) -> &studio_state {
    studio_with_status(state, value_string_of(error)!);
}

fn studio_on_start_rename(state: &studio_state, ctx: &context, at: i32) -> &studio_state {
    studio_with_renaming(state, studio_id_of(list_get(state.screens, at)!));
}

fn studio_on_cancel_rename(state: &studio_state, ctx: &context) -> &studio_state {
    studio_with_renaming(state, gs_empty);
}

// An empty name keeps the one it had.
fn studio_on_rename(state: &studio_state, ctx: &context, at: i32, name: js_string) -> &studio_state {
    let screen = list_get(state.screens, at)!;
    let named = name;
    if js_string_length(named) == 0 {
        named = studio_text_of(screen, gs_name);
    }
    let next = map_assoc(screen, gs_name, value_string(named));
    studio_ask_save_screen(ctx, studio_id_of(screen), named, studio_text_of(screen, gs_scope), value_to_f64(value_member(screen, gs_created)));
    studio_with_renaming(studio_with_screens(state, list_assoc(state.screens, at, next)), gs_empty);
}

fn studio_reply_save_screen_ok(state: &studio_state, ctx: &context, reply: i32) -> &studio_state {
    state;
}

fn studio_reply_save_screen_err(state: &studio_state, ctx: &context, error: &value) -> &studio_state {
    studio_with_status(state, value_string_of(error)!);
}

// Asked first; studio_reply_confirm_ok deletes it.
fn studio_on_delete_at(state: &studio_state, ctx: &context, at: i32) -> &studio_state {
    let screen = list_get(state.screens, at)!;
    let question = js_string_concat(js_string_concat(s_delete_the_screen, studio_text_of(screen, gs_name)), s_question);
    studio_ask_confirm(ctx, question);
    studio_with_deleting(state, studio_id_of(screen));
}

// Deleted when confirmed; when it was the one shown, the last one left is.
fn studio_reply_confirm_ok(state: &studio_state, ctx: &context, reply: i32) -> &studio_state {
    let id = state.deleting;
    let at = studio_index_of(state.screens, id);
    let cleared = studio_with_deleting(state, gs_empty);
    if !reply | (at <s 0) {
        return cleared;
    }
    studio_ask_delete_screen(ctx, id);
    let screens = list_empty();
    let i = 0;
    while i <s list_count(state.screens) {
        if i != at {
            screens = list_push(screens, list_get(state.screens, i)!);
        }
        i += 1;
    }
    let next = studio_with_screens(cleared, screens);
    if !str_eq(id, state.active) {
        return next;
    }
    let last = gs_empty;
    if list_count(screens) >s 0 {
        last = studio_id_of(list_get(screens, list_count(screens) - 1)!);
    }
    studio_showing(next, ctx, last);
}

fn studio_reply_delete_screen_ok(state: &studio_state, ctx: &context, reply: i32) -> &studio_state {
    state;
}

fn studio_reply_delete_screen_err(state: &studio_state, ctx: &context, error: &value) -> &studio_state {
    studio_with_status(state, value_string_of(error)!);
}

fn studio_get_has_screen(state: &studio_state) -> i32 {
    js_string_length(state.active) >s 0;
}

fn studio_loop_tabs_enrich(state: &studio_state, key: &value, item: &value) -> &studio_loop_tabs_binds {
    let id = studio_id_of(item);
    {studio_loop_tabs_binds|
        is_active: str_eq(id, state.active),
        is_renaming: str_eq(id, state.renaming),
        close_label: js_string_concat(s_delete, studio_text_of(item, gs_name)),
    };
}

// ---- Studio: the picker ------------------------------------------------------------

// Open on the scope of the screen shown, or the root, named after how many
// screens there are.
fn studio_on_open_picker(state: &studio_state, ctx: &context) -> &studio_state {
    let selected = s_root;
    let at = studio_index_of(state.screens, state.active);
    if at >=s 0 {
        selected = studio_text_of(list_get(state.screens, at)!, gs_scope);
    }
    let placeholder = js_string_concat(s_screen, int_text(list_count(state.screens) + 1));
    let picker = studio_make_scope_picker(ctx, state.scopes, selected, gs_empty, gs_empty, placeholder);
    studio_with_picker(state, studio_one(value_component(picker)));
}

fn studio_on_close_picker(state: &studio_state, ctx: &context) -> &studio_state {
    studio_with_picker(state, list_empty());
}

// A new screen in scope, saved by the host and shown.
fn studio_on_create_screen(state: &studio_state, ctx: &context, scope: js_string, name: js_string) -> &studio_state {
    let id = ctx_uuid(ctx);
    let created = ctx_now(ctx);
    let screen = map_assoc(map_empty(), gs_id, value_string(id));
    screen = map_assoc(screen, gs_name, value_string(name));
    screen = map_assoc(screen, gs_scope, value_string(scope));
    screen = map_assoc(screen, gs_created, value_float(created));
    studio_ask_save_screen(ctx, id, name, scope, created);
    let next = studio_with_picker(studio_with_screens(state, list_push(state.screens, screen)), list_empty());
    studio_showing(next, ctx, id);
}

fn studio_on_scope_added(state: &studio_state, ctx: &context, id: js_string, name: js_string, parent: js_string) -> &studio_state {
    let scope = map_assoc(map_assoc(map_assoc(map_empty(), gs_id, value_string(id)), gs_name, value_string(name)), gs_parent, value_string(parent));
    studio_with_scopes(state, list_push(state.scopes, scope));
}

// ---- Studio: what the host tells it ------------------------------------------------

fn studio_on_say(state: &studio_state, ctx: &context, text: js_string) -> &studio_state {
    studio_with_status(state, text);
}

// The newest first, up to 200.
fn studio_on_note(state: &studio_state, ctx: &context, kind: js_string, text: js_string) -> &studio_state {
    let events = list_push(list_empty(), map_assoc(map_assoc(map_empty(), gs_kind, value_string(kind)), gs_text, value_string(text)));
    let i = 0;
    while (i <s list_count(state.events)) & (i <s 199) {
        events = list_push(events, list_get(state.events, i)!);
        i += 1;
    }
    studio_with_events(state, events);
}

// A new library: the screen shown is dropped until the host shows one.
fn studio_on_set_library(state: &studio_state, ctx: &context, scopes: &value, screens: &value) -> &studio_state {
    {studio_state|
        scopes,
        screens,
        active: gs_empty,
        shown: list_empty(),
        shown_id: gs_empty,
        renaming: gs_empty,
        deleting: gs_empty,
        picker: list_empty(),
        status: state.status,
        assistant: state.assistant,
        events: state.events,
    };
}

fn studio_get_events_label(state: &studio_state) -> js_string {
    let n = list_count(state.events);
    if n == 0 {
        return s_events;
    }
    js_string_concat(js_string_concat(s_events_open, int_text(n)), s_close);
}

// ---- Studio: the menu --------------------------------------------------------------

fn studio_on_export_all(state: &studio_state, ctx: &context) -> &studio_state {
    studio_ask_export_library(ctx);
    state;
}

fn studio_reply_export_library_ok(state: &studio_state, ctx: &context, reply: i32) -> &studio_state {
    state;
}

fn studio_on_import_all(state: &studio_state, ctx: &context) -> &studio_state {
    studio_ask_import_library(ctx);
    state;
}

fn studio_reply_import_library_ok(state: &studio_state, ctx: &context, reply: i32) -> &studio_state {
    state;
}

fn studio_reply_import_library_err(state: &studio_state, ctx: &context, error: &value) -> &studio_state {
    studio_with_status(state, value_string_of(error)!);
}

fn studio_on_layout_json(state: &studio_state, ctx: &context) -> &studio_state {
    studio_ask_edit_layout_json(ctx, state.active);
    state;
}

fn studio_reply_edit_layout_json_ok(state: &studio_state, ctx: &context, reply: i32) -> &studio_state {
    state;
}
