// Example: one component with typed fields, defaults and constraints, a
// computed property, messages with guards and contracts, and a view that reads
// fields and sends messages (input events, a key modifier).
package tutuca:note@0.1.0;

/// A short note that can be pinned.
component note {
    field title: string = "Untitled" where len(title) <= 60;
    field body: string where len(body) <= 280;
    field pinned: bool;
    /// How many characters the body has left.
    get left: s32 where left >= 0;

    // An argument that breaks its where is rejected before the handler runs.
    message set_title(title: string where len(title) <= 60) changes title ensures next.title == title;
    message set_body(text: string where len(text) <= 280) changes body ensures next.body == text;
    message toggle_pin() changes pinned ensures next.pinned == not pinned;
    // when: only while there's something to clear.
    message clear() when len(body) > 0 changes body ensures len(next.body) == 0;

    view main = div(class: if(field(pinned), "card card-border bg-warning/10 gap-2 p-3", "card card-border bg-base-100 gap-2 p-3"),
        div(class: "flex items-center gap-2",
            input(class: "input input-sm input-ghost flex-1 font-semibold", "aria-label": "Title", value: field(title),
                on_input: send(set_title, target_value()),
                "on_keydown+escape": send(set_title, "Untitled")),
            button(class: "btn btn-xs btn-ghost", on_click: send(toggle_pin), if(field(pinned), "unpin", "pin"))),
        textarea(class: "textarea textarea-sm w-full", "aria-label": "Body", value: field(body),
            on_input: send(set_body, target_value())),
        div(class: "flex items-center justify-between text-xs",
            span(class: "opacity-70 tabular-nums", field(left), " left"),
            button(class: "btn btn-xs", on_click: send(clear), "clear")));
}

example pin_twice for note {
    start { }
    send toggle_pin();
    send toggle_pin();
    expect not pinned;
}

example clear_empties for note {
    start { body: "hello" }
    send clear();
    expect len(body) == 0;
}
