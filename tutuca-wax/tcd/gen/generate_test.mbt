///|
/// The generated files of a small component, as golden files: a change to
/// them is a change to what every component's boilerplate is.
test "generated contract and glue of a small component" {
  let (f, _) = @syntax.parse(
    "t.tcd",
    (
      #|component Tally {
      #|    field count: s32 where 0 <= count <= 9;
      #|    field mode: enum { up, down };
      #|    notify changed(count: s32);
      #|    message bump(n: s32 where n >= 1) when count < 9 changes count ensures next.count == count + n emits notify changed;
      #|    view main = button(class: "btn", on_click: send(bump, 1), field(count));
      #|}
    ),
  )
  let (pkg, diags) = @check.check(f, Map([]))
  debug_inspect(diags.length(), content="0")
  let out = @gen.generate(pkg, "t.tcd")
  inspect(
    out.contract,
    content=(
      #|// Generated by tcd from t.tcd: the string constants, types and helpers the implementation compiles against.
      #|// Don't edit it: change t.tcd and run tcd again.
      #|
      #|import "'" {
      #|    #[import = "Tally"]
      #|    const gs_tally: &extern;
      #|    #[import = "count"]
      #|    const gs_count: &extern;
      #|    #[import = "mode"]
      #|    const gs_mode: &extern;
      #|    #[import = "bump"]
      #|    const gs_bump: &extern;
      #|    #[import = "changed"]
      #|    const gs_changed: &extern;
      #|    #[import = "class"]
      #|    const gs_class: &extern;
      #|    #[import = "btn"]
      #|    const gs_btn: &extern;
      #|    #[import = "click"]
      #|    const gs_click: &extern;
      #|    #[import = "button"]
      #|    const gs_button: &extern;
      #|    #[import = "up"]
      #|    const gs_up: &extern;
      #|    #[import = "down"]
      #|    const gs_down: &extern;
      #|    #[import = "n"]
      #|    const gs_n: &extern;
      #|    #[import = "main"]
      #|    const gs_main: &extern;
      #|    #[import = "missing"]
      #|    const gs_missing: &extern;
      #|    #[import = "wrong type"]
      #|    const gs_wrong_type: &extern;
      #|    #[import = "invalid"]
      #|    const gs_invalid: &extern;
      #|}
      #|
      #|// ---- Tally ---------------------------------------------------------------------
      #|
      #|type tally_state = { count: i32, mode: i32 };
      #|
      #|const tally_mode_up = 0;
      #|const tally_mode_down = 1;
      #|
      #|// state with count set to v.
      #|fn tally_with_count(state: &tally_state, v: i32) -> &tally_state {
      #|    {tally_state| count: v, mode: state.mode };
      #|}
      #|
      #|// state with mode set to v.
      #|fn tally_with_mode(state: &tally_state, v: i32) -> &tally_state {
      #|    {tally_state| count: state.count, mode: v };
      #|}
      #|
      #|// notify changed: to the parent, bubbling until a handler stops it.
      #|fn tally_notify_changed(ctx: &context, count: i32) {
      #|    let args = [value_array|null; 1];
      #|    args[0] = value_int(count);
      #|    ctx_notify(ctx, gs_changed, args);
      #|}
      #|
      #|
    ),
  )
  inspect(
    out.glue,
    content=(
      #|// Generated by tcd from t.tcd: the boilerplate: specs, schemas, vtables, message routing, registration.
      #|// Don't edit it: change t.tcd and run tcd again.
      #|
      #|// ---- Tally ---------------------------------------------------------------------
      #|
      #|// when count < 9
      #|fn tally_when_bump: pre_fn (instance: &eq, args: &value_array, ctx: &context) -> i32 {
      #|    let state = instance as &tally_state;
      #|    cond_lt(value_int(state.count), value_int(9));
      #|}
      #|
      #|// ensures next.count == count + n
      #|fn tally_ensures_bump: post_fn (prev: &eq, next: &eq, args: &value_array, ctx: &context) -> i32 {
      #|    let prev_s = prev as &tally_state;
      #|    let next_s = next as &tally_state;
      #|    cond_eq(value_int(next_s.count), cond_add(value_int(prev_s.count), args[0]!));
      #|}
      #|
      #|fn tally_view_main() -> &view {
      #|    let t0 = [arg_array|null; 1];
      #|    t0[0] = arg_value(value_int(1));
      #|    let t1 = [str_array|null; 1];
      #|    t1[0] = gs_class;
      #|    let t2 = [view_array|null; 1];
      #|    t2[0] = view_const(value_string(gs_btn));
      #|    let t3 = [view_array|null; 1];
      #|    t3[0] = view_field(gs_count);
      #|    let t4 = [view_on_array|null; 1];
      #|    t4[0] = view_on(gs_click, view_action(gs_bump, t0));
      #|    let t5 = view_el(gs_button, null, t1, t2, null, t3, t4);
      #|    t5;
      #|}
      #|
      #|let tally_schema_made: &?component_schema = null;
      #|
      #|// Tally's schema: what the runtime checks its values and messages against.
      #|fn tally_schema() -> &component_schema {
      #|    if !!tally_schema_made {
      #|        return tally_schema_made!;
      #|    }
      #|    let t0 = [constraint_array|null; 2];
      #|    t0[0] = constraint_min(0.0, 0);
      #|    t0[1] = constraint_max(9.0, 0);
      #|    let t1 = [str_array|null; 2];
      #|    t1[0] = gs_up;
      #|    t1[1] = gs_down;
      #|    let t2 = [constraint_array|null; 0];
      #|    let t3 = [field_schema_array|null; 2];
      #|    t3[0] = field_schema_new(gs_count, vtype_int(), t0, sync_shared);
      #|    t3[1] = field_schema_new(gs_mode, vtype_enum(t1), t2, sync_shared);
      #|    let t4 = [field_schema_array|null; 0];
      #|    let t5 = [constraint_array|null; 1];
      #|    t5[0] = constraint_min(1.0, 0);
      #|    let t6 = [field_schema_array|null; 1];
      #|    t6[0] = field_schema_new(gs_n, vtype_int(), t5, sync_shared);
      #|    let t7 = [str_array|null; 1];
      #|    t7[0] = gs_count;
      #|    let t8 = [emit_array|null; 1];
      #|    t8[0] = emit_spec_new(emit_kind_notify, gs_changed);
      #|    let t9 = [message_schema_array|null; 1];
      #|    t9[0] = message_schema_new(gs_bump, t6, null, tally_when_bump, tally_ensures_bump, t7, t8);
      #|    let t10 = [invariant_array|null; 0];
      #|    let t11 = [str_array|null; 0];
      #|    let schema = component_schema_new(t3, t4, t9, t10, t11);
      #|    tally_schema_made = schema;
      #|    schema;
      #|}
      #|
      #|let tally_spec_made: &?component_spec = null;
      #|
      #|fn tally_spec() -> &component_spec {
      #|    if !!tally_spec_made {
      #|        return tally_spec_made!;
      #|    }
      #|    let t0 = [str_array|null; 1];
      #|    t0[0] = gs_main;
      #|    let t1 = [view_array|null; 1];
      #|    t1[0] = tally_view_main();
      #|    let t2 = [loop_def_array|null; 0];
      #|    let t3 = [scope_def_array|null; 0];
      #|    let t4 = [str_array|null; 0];
      #|    let t5 = [selector_array|null; 0];
      #|    let spec = spec_new(gs_tally, t0, t1, t2, t3, t4, t5);
      #|    spec_set_schema(spec, tally_schema());
      #|    tally_spec_made = spec;
      #|    spec;
      #|}
      #|
      #|// init: each field from fields when it's there and fits its schema, else its
      #|// default, with an issue saying why; a field without a default fails. A
      #|// make(name) default is made in ctx's scope, only when it's taken.
      #|fn tally_vt_init: init_fn (fields: &value, ctx: &init_context) -> &init_result {
      #|    let issues = list_empty();
      #|    let schema = tally_schema();
      #|    let found: &?value = null;
      #|    let problem: &?extern = null;
      #|    let f_count: i32 = 0;
      #|    found = field_value(fields, gs_count);
      #|    if !found {
      #|        issues = init_issue(issues, gs_count, gs_missing);
      #|    } else {
      #|        problem = vtype_problem((schema.fields[0]!).vtype, found!);
      #|        if !!problem {
      #|            issues = init_issue(issues, gs_count, gs_wrong_type);
      #|        } else {
      #|            problem = constraints_problem((schema.fields[0]!).constraints, found!, null);
      #|            if !!problem {
      #|                issues = init_issue(issues, gs_count, gs_invalid);
      #|            } else {
      #|                f_count = (found! as &value_int).value;
      #|            }
      #|        }
      #|    }
      #|    let f_mode: i32 = 0;
      #|    found = field_value(fields, gs_mode);
      #|    if !found {
      #|        issues = init_issue(issues, gs_mode, gs_missing);
      #|    } else {
      #|        problem = vtype_problem((schema.fields[1]!).vtype, found!);
      #|        if !!problem {
      #|            issues = init_issue(issues, gs_mode, gs_wrong_type);
      #|        } else {
      #|            problem = constraints_problem((schema.fields[1]!).constraints, found!, null);
      #|            if !!problem {
      #|                issues = init_issue(issues, gs_mode, gs_invalid);
      #|            } else {
      #|                f_mode = tcd_enum_0_index(value_string_of(found!)!);
      #|            }
      #|        }
      #|    }
      #|    let state = {tally_state| count: f_count, mode: f_mode };
      #|    init_ok(state, issues);
      #|}
      #|
      #|// handle: routes a message to its handler. The runtime checked its arguments
      #|// against the message's schema before this runs, so they decode as declared.
      #|fn tally_vt_handle: handle_fn (instance: &eq, m: &message, ctx: &context) -> &message_result {
      #|    let state = instance as &tally_state;
      #|    if str_eq(m.name, gs_bump) {
      #|        return message_result_of(state, tally_on_bump(state, ctx, (m.args[0]! as &value_int).value));
      #|    }
      #|    message_result_rejected(message_error_unknown_message());
      #|}
      #|
      #|fn tally_vt_get: get_fn (instance: &eq, name: &extern) -> (i32, &?value) {
      #|    let state = instance as &tally_state;
      #|    if str_eq(name, gs_count) {
      #|        return (property_ok, value_int(state.count));
      #|    }
      #|    if str_eq(name, gs_mode) {
      #|        return (property_ok, value_string(tcd_enum_0_name(state.mode)));
      #|    }
      #|    (property_no_such_property, null);
      #|}
      #|
      #|// set: a field, when the value fits its schema; a property is read only.
      #|fn tally_vt_set: set_fn (instance: &eq, name: &extern, v: &value) -> (i32, &?eq) {
      #|    let state = instance as &tally_state;
      #|    let schema = tally_schema();
      #|    if str_eq(name, gs_count) {
      #|        if !!vtype_problem((schema.fields[0]!).vtype, v) {
      #|            return (property_wrong_type, null);
      #|        }
      #|        if !!constraints_problem((schema.fields[0]!).constraints, v, null) {
      #|            return (property_invalid, null);
      #|        }
      #|        return (property_ok, tally_with_count(state, (v as &value_int).value));
      #|    }
      #|    if str_eq(name, gs_mode) {
      #|        if !!vtype_problem((schema.fields[1]!).vtype, v) {
      #|            return (property_wrong_type, null);
      #|        }
      #|        if !!constraints_problem((schema.fields[1]!).constraints, v, null) {
      #|            return (property_invalid, null);
      #|        }
      #|        return (property_ok, tally_with_mode(state, tcd_enum_0_index(value_string_of(v)!)));
      #|    }
      #|    (property_no_such_property, null);
      #|}
      #|
      #|fn tally_vtable() -> &vtable {
      #|    {vtable| init: tally_vt_init, handle: tally_vt_handle, get: tally_vt_get, set: tally_vt_set };
      #|}
      #|
      #|// ---- The package ------------------------------------------------------------
      #|
      #|#[export = "tutuca_abi_version"]
      #|fn tutuca_abi_version() -> i32 {
      #|    tutuca_abi_version_current;
      #|}
      #|
      #|#[export = "tutuca_register"]
      #|fn tutuca_register(s: &scope) {
      #|    scope_register(s, gs_tally, tally_spec(), tally_vtable());
      #|}
      #|
      #|fn tcd_enum_0_name(i: i32) -> &extern {
      #|    if i == 0 {
      #|        return gs_up;
      #|    }
      #|    if i == 1 {
      #|        return gs_down;
      #|    }
      #|    gs_up;
      #|}
      #|
      #|fn tcd_enum_0_index(s: &extern) -> i32 {
      #|    if str_eq(s, gs_up) {
      #|        return 0;
      #|    }
      #|    if str_eq(s, gs_down) {
      #|        return 1;
      #|    }
      #|    -1;
      #|}
      #|
      #|
    ),
  )
  debug_inspect(
    out.required.map(r => r.signature()),
    content=(
      #|["fn tally_on_bump(state: &tally_state, ctx: &context, n: i32) -> &tally_state"]
    ),
  )
}

///|
/// A name an implementation reads as gs_<name> keeps it whatever a view says
/// first that reads the same: a "Notes" label before the field notes.
test "the package's names claim their gs_ constants before view text" {
  let (f, _) = @syntax.parse(
    "t.tcd",
    (
      #|component Shelf {
      #|    field notes: list<string>;
      #|    message add_note() changes notes;
      #|    view main = div(span("Notes"), span("Add note"), field(notes));
      #|}
    ),
  )
  let (pkg, diags) = @check.check(f, Map([]))
  debug_inspect(diags.length(), content="0")
  let contract = @gen.generate(pkg, "t.tcd").contract
  let consts = contract
    .split("\n")
    .filter(l => l.contains("#[import = ") || l.contains("const gs_"))
    .map(l => l.trim().to_owned())
    .collect()
  debug_inspect(
    consts.filter(l => l.contains("ote")),
    content=(
      #|[
      #|  "#[import = \"notes\"]",
      #|  "const gs_notes: &extern;",
      #|  "#[import = \"add_note\"]",
      #|  "const gs_add_note: &extern;",
      #|  "#[import = \"Notes\"]",
      #|  "const gs_notes_2: &extern;",
      #|  "#[import = \"Add note\"]",
      #|  "const gs_add_note_2: &extern;",
      #|]
    ),
  )
}

///|
/// A make(c) default is made through the init context when init falls back
/// to it, and the init hook gets that context too.
test "make defaults and the init hook take the init context" {
  let (f, _) = @syntax.parse(
    "t.tcd",
    (
      #|component Leaf { view main = p("x"); }
      #|component Holder {
      #|    field child: Leaf = make(Leaf);
      #|    init;
      #|    view main = p("x");
      #|}
    ),
  )
  let (pkg, diags) = @check.check(f, Map([]))
  debug_inspect(diags.length(), content="0")
  let glue = @gen.generate(pkg, "t.tcd").glue
  let lines = glue
    .split("\n")
    .filter(l => {
      l.contains("ctx") && !l.contains("//") && !l.contains("&context")
    })
    .map(l => l.trim().to_owned())
    .collect()
  debug_inspect(
    lines,
    content=(
      #|[
      #|  "fn leaf_vt_init: init_fn (fields: &value, ctx: &init_context) -> &init_result {",
      #|  "fn holder_vt_init: init_fn (fields: &value, ctx: &init_context) -> &init_result {",
      #|  "f_child = value_component(init_ctx_make(ctx, gs_leaf, map_empty()));",
      #|  "f_child = value_component(init_ctx_make(ctx, gs_leaf, map_empty()));",
      #|  "f_child = value_component(init_ctx_make(ctx, gs_leaf, map_empty()));",
      #|  "init_ok(holder_init(state, ctx), issues);",
      #|]
    ),
  )
}

///|
test "a swap handler swaps in a component or keeps its own, with changes checked when it keeps" {
  let (f, _) = @syntax.parse(
    "t.tcd",
    (
      #|component Other { view main = p("x"); }
      #|component Slot {
      #|    field note: string;
      #|    message become() -> swap changes note emits make Other;
      #|    view main = p(field(note));
      #|}
    ),
  )
  let (pkg, diags) = @check.check(f, Map([]))
  debug_inspect(diags.length(), content="0")
  let out = @gen.generate(pkg, "t.tcd")
  let pick = (text : String, keep : (String) -> Bool) => {
    text
    .split("\n")
    .filter(l => keep(l.to_owned()))
    .map(l => l.trim().to_owned())
    .collect()
  }
  debug_inspect(
    pick(out.contract, l => l.contains("swap") || l.contains("slot_keep")),
    content=(
      #|[
      #|  "// What a swap handler gives: a component to swap in (slot_swap_to), or the",
      #|  "// next state, keeping this component (slot_keep).",
      #|  "type slot_swap_result = { component: &?component, state: &?slot_state };",
      #|  "// swap this component for c.",
      #|  "fn slot_swap_to(c: &component) -> &slot_swap_result {",
      #|  "{slot_swap_result| component: c, state: null };",
      #|  "fn slot_keep(state: &slot_state) -> &slot_swap_result {",
      #|  "{slot_swap_result| component: null, state };",
      #|]
    ),
  )
  debug_inspect(
    pick(out.glue, l => {
      !l.contains("//") && (l.contains("r.") || l.contains("slot_on_become"))
    }),
    content=(
      #|[
      #|  "let r = slot_on_become(state, ctx);",
      #|  "if !!r.component {",
      #|  "return message_result_swapped(r.component!);",
      #|  "return message_result_of(state, r.state!);",
      #|]
    ),
  )
  let stub = @gen.stub(pkg, "t.tcd")
  debug_inspect(
    pick(stub, l => l.contains("slot_on_become") || l.contains("slot_keep")),
    content=(
      #|[
      #|  "// slot_on_become handles the message become.",
      #|  "fn slot_on_become(state: &slot_state, ctx: &context) -> &slot_swap_result {",
      #|  "slot_keep(state);",
      #|]
    ),
  )
}

///|
/// gs_empty is the empty text whatever comes first: text of only symbols
/// gets names of its own.
test "only the empty text is gs_empty" {
  let (f, _) = @syntax.parse(
    "t.tcd",
    (
      #|component C {
      #|    field note: string;
      #|    view main = div(button("+"), button("×"), field(note));
      #|}
    ),
  )
  let (pkg, diags) = @check.check(f, Map([]))
  debug_inspect(diags.length(), content="0")
  let contract = @gen.generate(pkg, "t.tcd").contract
  let lines = contract.split("\n").map(l => l.trim().to_owned()).collect()
  let consts = []
  for i, l in lines {
    if l.has_prefix("const gs_") && i > 0 && lines[i - 1].contains("#[import") {
      consts.push(lines[i - 1] + " " + l)
    }
  }
  debug_inspect(
    consts.filter(l => l.contains("gs_empty") || l.contains("gs_text")),
    content=(
      #|[
      #|  "#[import = \"+\"] const gs_text: &extern;",
      #|  "#[import = \"×\"] const gs_text_2: &extern;",
      #|  "#[import = \"\"] const gs_empty: &extern;",
      #|]
    ),
  )
}

///|
/// A view's name reaches the runtime as written, wherever it's named: so a
/// push_view of a name a property holds finds it as a literal one does.
test "view names are kept as written" {
  let (f, _) = @syntax.parse(
    "t.tcd",
    (
      #|component Row {
      #|    field mode: string;
      #|    view main = p("x");
      #|    view compact_row = p("y");
      #|}
      #|component Board {
      #|    field mode: string;
      #|    field child: Row;
      #|    view main = div(
      #|        push_view("compact_row", render(field(child))),
      #|        push_view(field(mode), render(field(child), view: compact_row)));
      #|}
    ),
  )
  let (pkg, diags) = @check.check(f, Map([]))
  debug_inspect(diags.length(), content="0")
  let out = @gen.generate(pkg, "t.tcd")
  let pick = (text : String, keep : (String) -> Bool) => {
    text
    .split("\n")
    .filter(l => keep(l.to_owned()))
    .map(l => l.trim().to_owned())
    .collect()
  }
  debug_inspect(
    pick(out.contract, l => l.contains("compact") || l.contains("Compact")),
    content=(
      #|["#[import = \"compact_row\"]", "const gs_compact_row: &extern;"]
    ),
  )
  debug_inspect(
    pick(out.glue, l => l.contains("compact") || l.contains("Compact")),
    content=(
      #|[
      #|  "fn row_view_compact_row() -> &view {",
      #|  "t0[1] = gs_compact_row;",
      #|  "t1[1] = row_view_compact_row();",
      #|  "let t3 = view_push_view(view_const(value_string(gs_compact_row)), t2);",
      #|  "let t4 = view_render(view_field(gs_child), gs_compact_row);",
      #|]
    ),
  )
}
