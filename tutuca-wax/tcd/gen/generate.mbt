// Generating a package: the contract and glue files, and the stub of what
// the implementation writes.

///|
pub(all) struct Output {
  /// <pkg>.contract.wax: string constants, types and helpers.
  contract : String
  /// <pkg>.glue.wax: specs, schemas, vtables, registration.
  glue : String
  required : Array[Required]
}

///|
/// The generated files of pkg; source names the TCD file, for their headers.
pub fn generate(
  pkg : @check.Package,
  source : String,
  have? : Array[String],
) -> Output {
  let g = Gen::new(pkg, have?)
  let glue = g.glue()
  let contract = g.contract()
  let header = (what : String) => {
    "// Generated by tcd from \{source}: \{what}.\n// Don't edit it: change \{source} and run tcd again.\n"
  }
  {
    contract: header(
      "the string constants, types and helpers the implementation compiles against",
    ) +
    "\n" +
    g.strings.imports() +
    "\n" +
    contract,
    glue: header(
      "the boilerplate: specs, schemas, vtables, message routing, registration",
    ) +
    "\n" +
    glue,
    required: required(pkg),
  }
}

///|
/// What a stub's function returns until it's written.
fn stub_body(r : Required, state_type : String) -> String {
  if r.result == state_type || r.result.has_suffix("_state") {
    "    state;"
  } else if r.result.has_suffix("_swap_result") {
    // Keeps the component until it's written.
    let cw = r.result[1:r.result.length() - "_swap_result".length()].to_owned()
    "    \{cw}_keep(state);"
  } else {
    "    unreachable;"
  }
}

///|
/// The implementation's skeleton: every required function, typed, with what
/// the TCD file says about it, returning its state unchanged (or trapping,
/// when it returns something else) until it's written. Only the ones not in
/// `have` when given.
pub fn stub(
  pkg : @check.Package,
  source : String,
  have~ : Array[String] = [],
) -> String {
  let out = Out::new()
  if have.is_empty() {
    out.line(
      "// The implementation of \{source}: only what it can't say, in the functions",
    )
    out.line(
      "// tcd names. Generated as a stub by `tcd stub`; fill the bodies in. The types,",
    )
    out.line(
      "// string constants (gs_...) and helpers are in the contract tcd generates.",
    )
    out.line("")
  }
  for r in required(pkg) {
    if have.contains(r.name) {
      continue
    }
    out.line("// \{r.name} \{r.what}.")
    for n in r.notes {
      for l in n.split("\n") {
        out.line("//   \{l}")
      }
    }
    out.line("\{r.signature()} {")
    out.line(stub_body(r, ""))
    out.line("}")
    out.line("")
  }
  out.to_string()
}
