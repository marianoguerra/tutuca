///|
let tcd_src : String =
  #|component tally {
  #|    field count: s32 where count >= 0;
  #|    get double: s32;
  #|    message add(n: s32) changes count ensures next.count == count + n;
  #|    message reset() changes count;
  #|    view main = p(field(count));
  #|}

///|
fn convention(impl_src : String) -> Array[String] {
  let (f, _) = @syntax.parse("t.tcd", tcd_src)
  let (pkg, _) = @check.check(f, Map([]))
  let out = @gen.generate(pkg, "t.tcd")
  let impl_ast = @wax.parse_string(impl_src, fname="impl.wax").module_.unwrap_or([],
  )
  let glue = @wax.parse_string(out.glue, fname="glue.wax").module_.unwrap_or([])
  let contract = @wax.parse_string(out.contract, fname="contract.wax").module_.unwrap_or([],
  )
  @compose.check_convention(pkg, out.required, [impl_ast], [contract, glue]).map(d => {
      "\{d.code}: \{d.message}"
    },
  )
}

///|
test "an implementation that follows the convention" {
  debug_inspect(
    convention(
      (
        #|fn tally_on_add(state: &tally_state, ctx: &context, n: i32) -> &tally_state { state; }
        #|fn tally_on_reset(state: &tally_state, ctx: &context) -> &tally_state { state; }
        #|fn tally_get_double(state: &tally_state) -> i32 { state.count * 2; }
      ),
    ),
    content="[]",
  )
}

///|
test "missing, wrong, undeclared and generated functions" {
  debug_inspect(
    convention(
      (
        #|fn tally_on_add(state: &tally_state, ctx: &context, n: f64) -> &tally_state { state; }
        #|fn tally_get_double(state: &tally_state) -> &extern { unreachable; }
        #|fn tally_on_rest(state: &tally_state, ctx: &context) -> &tally_state { state; }
        #|fn tally_with_count(state: &tally_state, v: i32) -> &tally_state { state; }
      ),
    ),
    content=(
      #|[
      #|  "tcd.impl.signature: parameter 3 of tally_on_add (n) must be i32: the convention calls it as fn tally_on_add(state: &tally_state, ctx: &context, n: i32) -> &tally_state",
      #|  "tcd.impl.missing: the implementation has no tally_on_reset, which handles the message reset",
      #|  "tcd.impl.signature: tally_get_double must return i32: the convention calls it as fn tally_get_double(state: &tally_state) -> i32",
      #|  "tcd.impl.undeclared: tally_on_rest looks like a handler for rest, which tally doesn't declare; did you mean reset?",
      #|  "tcd.impl.generated: tally_with_count is generated by tcd; the implementation can't define it too",
      #|]
    ),
  )
}
