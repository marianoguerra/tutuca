{
	"blurb": "The list appends an item and sends init to it in the same transaction. The item isn't in the tree the handler read, but send-at is resolved against the committed tree, where it is.",
	"edges": [
		{ "from": 0, "label": "event: push()", "rule": "env", "to": 1 },
		{ "from": 1, "label": "run: send init", "rule": "run", "to": 2 },
		{ "from": 1, "label": "event: go() at items[0]", "rule": "env", "to": 3 },
		{ "from": 2, "label": "event: go() at items[0]", "rule": "env", "to": 4 },
		{ "from": 3, "label": "run: send init", "rule": "run", "to": 5 },
		{ "from": 4, "label": "run: request 2 fetch", "rule": "run", "to": 6 },
		{ "from": 5, "label": "run: request 2 fetch", "rule": "run", "to": 7 },
		{ "from": 6, "label": "response 2 to fetch arrives", "rule": "respond", "to": 8 },
		{ "from": 7, "label": "response 2 to fetch arrives", "rule": "respond", "to": 9 },
		{ "from": 8, "label": "run: response 2 fetch", "rule": "run", "to": 10 },
		{ "from": 9, "label": "run: response 2 fetch", "rule": "run", "to": 11 }
	],
	"gran": "turn",
	"host": "(host ())",
	"kinds": [
		"(kind\n Item\n (state (label 0) (ready 0))\n ()\n ((on (send init) () ((set ready 1)))\n  (on (send go) () ((request fetch (get label))))\n  (on (ok fetch) (x) ((log x)))))",
		"(kind\n Todos\n (state (count 0))\n ((items (list)))\n ((on\n   (send push)\n   ()\n   ((set count (+ (get count) 1))\n    (append items (new Item (label (get count))))\n    (send-at ((index items (- (len items) 1))) init)))\n  (on (request fetch) (l) ((answer ok (+ l 100))))))"
	],
