{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!deps",
			"!site/deps",
			"!demos/deps",
			"!components/markdown/vendor",
			"!dist",
			"!_site",
			"!pure-js",
			"!grow",
			"!spec/pure-tutuca/golden",
			"!spec/pure-tutuca/host",
			"!tutuca-wasm/_build",
			"!tutuca-wasm/dist",
			"!tutuca-wasm/_site",
			"!tutuca-wasm/node_modules",
			"!tutuca-wasm/vendor",
			"!tutuca-wasm/playground/deps",
			"!tutuca-wasm/playground/editor.src.js",
			"!tutuca-wasm/**/*.tutuca.ts",
			"!tutuca-wasm/components",
			"!tdata/.tools",
			"!tdata/mbt/_build",
			"!tdata/mbt/dist",
			"!tutuca-core.*"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"domains": {
			"project": "all"
		},
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noThisInStatic": "off"
			},
			"correctness": {
				"noUndeclaredVariables": "error",
				"noUndeclaredDependencies": "error",
				"noNodejsModules": "error",
				"useImportExtensions": "error"
			},
			"suspicious": {
				"noConstantBinaryExpressions": "error",
				"useAwait": "error",
				"noLoopFunc": "error"
			},
			"nursery": {
				"noFloatingPromises": "error",
				"noImpliedEval": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.tutuca.ts"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnresolvedImports": "off",
						"noEmptyPattern": "off",
						"noUnusedFunctionParameters": "off",
						"noUndeclaredVariables": "off"
					}
				}
			}
		},
		{
			"includes": ["site/examples/**/*.js", "demos/renders/examples/**/*.js", "tdata/mbt/load.mjs"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnresolvedImports": "off"
					}
				}
			}
		},
		{
			"includes": [
				"test/**/*.js",
				"scripts/**/*.js",
				"tutuca-wasm/test/**",
				"tutuca-wasm/**/*.mjs",
				"tdata/*/test/**",
				"tdata/*/scripts/**",
				"tdata/mbt/load.mjs"
			],
			"linter": {
				"rules": {
					"correctness": {
						"noNodejsModules": "off"
					}
				}
			}
		},
		{
			"includes": ["tdata/js/test/query.test.ts", "tdata/mbt/test/**"],
			"linter": {
				"rules": {
					"correctness": {
						"useImportExtensions": "off"
					}
				}
			}
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"markdown": {
		"formatter": {
			"enabled": false
		}
	},
	"yaml": {
		"formatter": {
			"enabled": false
		}
	}
}
