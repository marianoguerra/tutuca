{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!deps",
			"!site/deps",
			"!demos/deps",
			"!dist",
			"!_site",
			"!tutuca-mb",
			"!tutuca-wax",
			"!tdata/mbt/_build",
			"!tdata/mbt/dist",
			"!tutuca-core.*"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"domains": {
			"project": "all"
		},
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noThisInStatic": "off"
			},
			"correctness": {
				"noUndeclaredVariables": "error",
				"noUndeclaredDependencies": "error",
				"noNodejsModules": "error",
				"useImportExtensions": "error"
			},
			"suspicious": {
				"noConstantBinaryExpressions": "error",
				"useAwait": "error"
			},
			"nursery": {
				"noFloatingPromises": "error",
				"noLoopFunc": "error",
				"noImpliedEval": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["site/examples/**/*.js", "tdata/mbt/load.mjs"],
			"linter": {
				"rules": {
					"correctness": { "noUnresolvedImports": "off" }
				}
			}
		},
		{
			"includes": [
				"test/**/*.js",
				"scripts/**/*.js",
				"tdata/*/test/**",
				"tdata/*/scripts/**",
				"tdata/mbt/load.mjs"
			],
			"linter": {
				"rules": {
					"correctness": { "noNodejsModules": "off" }
				}
			}
		},
		{
			"includes": ["tdata/js/test/query.test.ts", "tdata/mbt/test/**"],
			"linter": {
				"rules": {
					"correctness": { "useImportExtensions": "off" }
				}
			}
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
