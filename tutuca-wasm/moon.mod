// tutuca-wasm: tutuca's runtime compiled to WebAssembly, for components
// written as pure-tutuca modules and compiled by pure-js. The state it holds
// is pure-js's values, so a component's code and the runtime work on the same
// records and lists.
name = "tutuca/wasm"

version = "0.1.0"

license = "MIT"

preferred_target = "wasm-gc"

description = "tutuca's runtime for pure-tutuca component modules, in WebAssembly"
