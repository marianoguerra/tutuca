// The math workbench on wasm-gc.
import {
  "marianoguerra/tutuca",
  "marianoguerra/tutuca/wasm" @tw,
  "marianoguerra/tutuca/examples/math",
}

supported_targets = "wasm-gc"

pkgtype(kind: "executable")

options(
  link: {
    "wasm-gc": {
      "exports": [ "start", "on_call" ],
      "use-js-builtin-string": true,
    },
  },
)
