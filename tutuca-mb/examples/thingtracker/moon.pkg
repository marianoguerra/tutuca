// The thing tracker example: tap an emoji to log a thing, see what you did by day, week or
// month, manage things, tags, bundles and backups. Ported from components/thing-tracker.
import {
  "marianoguerra/tutuca",
  "marianoguerra/tutuca/examples/common",
  "moonbitlang/core/json",
  "moonbitlang/core/quickcheck",
  "moonbitlang/core/quickcheck/splitmix",
  "moonbitlang/core/string",
}

import {
  "marianoguerra/tutuca/testing",
  "marianoguerra/tutuca/vdom/memdom",
  "moonbitlang/core/debug",
} for "wbtest"

warnings = "-79"

options(
  targets: {
    "text_js.mbt": [ "js" ],
    "text_js_wbtest.mbt": [ "js" ],
    "text_table.mbt": [ "wasm", "wasm-gc", "native", "llvm" ],
  },
)
