// The thing tracker on wasm-gc: time from the browser clock, files as downloads and picks.
import {
  "marianoguerra/tutuca",
  "marianoguerra/tutuca/wasm" @tw,
  "marianoguerra/tutuca/examples/common/wasm" @common_wasm,
  "marianoguerra/tutuca/examples/thingtracker" @tt,
}

supported_targets = "wasm-gc"

pkgtype(kind: "executable")

options(
  link: {
    "wasm-gc": {
      "exports": [ "start", "on_call" ],
      "use-js-builtin-string": true,
    },
  },
)
