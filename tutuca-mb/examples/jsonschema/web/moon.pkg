// The jsonschema demo in a browser.
import {
  "marianoguerra/tutuca",
  "marianoguerra/tutuca/browser",
  "marianoguerra/tutuca/examples/common/web" @files,
  "marianoguerra/tutuca/examples/jsonschema" @js,
}

supported_targets = "js"

pkgtype(kind: "executable")

options(
  link: { "js": { "exports": [ "start" ], "format": "esm" } },
)
