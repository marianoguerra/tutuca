// Counters in <tutuca-app> elements: each element asks the page for an app, gets a counter of
// its own in its shadow root, and reports its count to the page.
import {
  "marianoguerra/tutuca",
  "marianoguerra/tutuca/browser",
  "marianoguerra/tutuca/examples/counter",
}

supported_targets = "js"

pkgtype(kind: "executable")

options(
  link: { "js": { "exports": [ "start" ], "format": "esm" } },
)
