pub enum ViewAt[X, S, M] {
  Text(String)
  Show((X) -> String)
  Elem(String, Array[Prop[X, M]], Array[ViewAt[X, S, M]])
  If((X) -> Bool, ViewAt[X, S, M], ViewAt[X, S, M])
  Frag(Array[ViewAt[X, S, M]])
  Ext(Ir, (Lowerer) -> Plan[X, S, M])
}
pub fn[X, S, M] ViewAt::compile(Self[X, S, M]) -> Plan[X, S, M] raise ViewError
pub fn[X, S, M] ViewAt::ir(Self[X, S, M]) -> Ir

pub struct With[X, Y] {
  up : X
  value : Y
}

// Type aliases
pub type Bound = Array[(String, (Event) -> Task?)]

pub type View[S, M] = ViewAt[S, S, M]

