pub fn[S, K, T] Provide::at(Self[T], Items[S, K, T], (S) -> K) -> Provision[S]
pub fn[T] Provide::current(Self[T]) -> T?
pub fn[S, T] Provide::from(Self[T], Lens[S, T]) -> Provision[S]
pub fn[T] Provide::new(String) -> Self[T]

pub struct Provision[S] {
  key_id : Int
  key_name : String
  push : (S, Route[S]) -> Bool
  pop : () -> Unit
}

pub struct Rctx[S, M] {
  env : RenderEnv
  route : Route[S]
  node : Node
  state : S
  comp : Component[S, M]
  keys : String
  send : (M, () -> M?, Event) -> Task
}

pub struct RenderEnv {
  host_id : Int
  start_id : Int
  gen : Int
  settled : Bool
  dev : Bool
  meta : Bool
  bindings : Array[(String, Array[(String, (Event) -> Task?)])]
  nodes : Array[(String, Node)]
  deps : Array[() -> Bool]
  view_stack : Array[String]
  issues : Array[Issue]
  events : Array[String]
  prunes : Map[Int, () -> Unit]
}
pub fn RenderEnv::new(Int, Int, start_id? : Int, settled~ : Bool, dev~ : Bool, meta? : Bool) -> Self

pub enum Report {
  Rendered
  TaskHandled(Task)
  TaskFailed(Task, String)
  StateInvalid(Array[Issue])
  MessageInvalid(Task, Array[String])
  RenderFailed(String)
}

pub struct Route[S] {
  path : DispatchPath
  home : DispatchPath
  get : () -> S?
  set : (S) -> Unit raise RouteError
}
pub fn[S, C] Route::focus(Self[S], Lens[S, C], path? : DispatchPath) -> Self[C]
pub fn[S] Route::new(DispatchPath, () -> S?, (S) -> Unit raise RouteError) -> Self[S]
pub fn[S] Route::read(Self[S]) -> S raise RouteError

pub struct Scope {
  id : Int
  parent : Scope?
}
pub fn[A, R] Scope::answer(Self, Ask[A, R], (A) -> R raise?) -> Unit
pub fn Scope::enter(Self) -> Self
pub fn[A, R] Scope::handle(Self, Ask[A, R], (A, (AskResult[R]) -> Unit) -> Unit raise?) -> Unit
pub fn[A, R] Scope::lookup(Self, Ask[A, R]) -> ((A, (AskResult[R]) -> Unit) -> Unit raise)?
pub fn Scope::new() -> Self

pub struct Signal[T] {
  id : Int
  name : String
  // private fields
}
pub fn[S, M, T, K, I] Signal::from(Self[T], Items[S, K, I], (S, T, K, Ctx[S, M]) -> S raise?) -> Listener[S, M]
pub fn[T] Signal::new(String) -> Self[T]
pub fn[S, M, T] Signal::on(Self[T], (S, T, Ctx[S, M]) -> S raise?) -> Listener[S, M]

pub(all) enum SlotKey {
  Index(Int)
  Name(String)
  Pair(SlotKey, SlotKey)
} derive(Eq, @debug.Debug)
pub fn SlotKey::equal(Self, Self) -> Bool
pub fn SlotKey::not_equal(Self, Self) -> Bool
pub fn SlotKey::to_repr(Self) -> @debug.Repr
pub fn SlotKey::to_string(Self) -> String

pub struct Task {
  kind : TaskKind
  label : String
  path : DispatchPath
  trigger : String?
  run : (Tx) -> Unit raise
}

pub(all) enum TaskKind {
  Send
  Event
  Notify
  Ask
  Reply
} derive(Eq, @debug.Debug)
pub fn TaskKind::equal(Self, Self) -> Bool
pub fn TaskKind::not_equal(Self, Self) -> Bool
pub fn TaskKind::to_repr(Self) -> @debug.Repr

pub struct Tx {
  core : HostCore
  task : Task
  staged : Array[() -> Task raise]
}

pub struct Vec[T](@vector.Vector[T])
