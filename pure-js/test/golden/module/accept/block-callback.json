 "printed": "export type State = { rows: number[][] };\nexport const Grid = {\n\tqueries: {\n\t\tcells(): string[] {\n\t\t\treturn this.rows.map((row, i) => {\n\t\t\t\tlet total = 0;\n\t\t\t\tfor (const x of row) {\n\t\t\t\t\tif (x > 10) break;\n\t\t\t\t\ttotal += x;\n\t\t\t\t}\n\t\t\t\tconst big = row.find(x => {\n\t\t\t\t\tif (x > 2) {\n\t\t\t\t\t\treturn true;\n\t\t\t\t\t}\n\t\t\t\t\treturn false;\n\t\t\t\t});\n\t\t\t\treturn `${i}:${total}:${big ?? -1}`;\n\t\t\t});\n\t\t},\n\t},\n};",
