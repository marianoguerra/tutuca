 "printed": "export type Note = { text: string; tag?: string };\nexport type State = { notes: Note[] };\nfunction label(n: Readonly<Note>): string {\n\tif (n.tag === undefined) return n.text;\n\treturn `${n.text}#${n.tag}`;\n}\nexport const Notes = {\n\tqueries: {\n\t\tsummary(): string {\n\t\t\treturn this.notes.map(n => label(n)).join(\" \");\n\t\t},\n\t},\n};",
