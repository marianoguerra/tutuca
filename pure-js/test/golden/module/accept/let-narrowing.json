 "printed": "export type State = { words: string[] };\nfunction longest(words: Readonly<string[]>): string {\n\tlet best: string | null = null;\n\tfor (const w of words) {\n\t\tif (best === null || w.length > best.length) best = w;\n\t}\n\treturn best ?? \"\";\n}\nexport const Words = {\n\tqueries: {\n\t\tlongest(): string {\n\t\t\treturn longest(this.words);\n\t\t},\n\t},\n};",
