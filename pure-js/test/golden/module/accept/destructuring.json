 "printed": "export type Card = { id: number; title: string; tags: string[]; note?: string };\nexport type State = { cards: Card[]; title: string };\nexport const Board = {\n\ton: {\n\t\trename: {\n\t\t\trun(next, [title, at]) {\n\t\t\t\tconst { cards } = next;\n\t\t\t\tconst card = cards[at];\n\t\t\t\tif (card === undefined) return;\n\t\t\t\tconst { tags, note = \"none\", ...rest } = card;\n\t\t\t\tconst [first, ...others] = tags;\n\t\t\t\ttags.push(`${rest.title}:${note}:${first ?? \"\"}:${others.length}`);\n\t\t\t\tcard.title = title;\n\t\t\t\tnext.title = `${rest.id}`;\n\t\t\t},\n\t\t},\n\t},\n};",
