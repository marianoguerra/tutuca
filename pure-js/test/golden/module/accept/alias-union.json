 "printed": "export type Tag = \"feature\" | \"bug\" | \"chore\";\nexport type State = { tag: Tag; card: { tag: Tag } };\nfunction after(tag: Tag): Tag {\n\tif (tag === \"feature\") return \"bug\";\n\tif (tag === \"bug\") return \"chore\";\n\treturn \"feature\";\n}\nexport const Tags = {\n\tqueries: {\n\t\tnext(): Tag[] {\n\t\t\treturn [after(this.tag), after(this.card.tag)];\n\t\t},\n\t},\n};",
