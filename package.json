{
	"name": "tutuca",
	"version": "1.0.0-alpha.0",
	"description": "A small SPA framework that is easy to learn",
	"type": "module",
	"license": "MIT",
	"author": "Mariano Guerra",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/marianoguerra/tutuca.git"
	},
	"homepage": "https://marianoguerra.github.io/tutuca/",
	"engines": {
		"node": ">=20"
	},
	"sideEffects": false,
	"exports": {
		".": "./src/tutuca.js",
		"./vdom": "./src/vdom.js",
		"./dev": "./src/dev/formatters.js",
		"./lint": "./src/lint/index.js",
		"./classes": "./src/dev/classes.js",
		"./pbt": "./src/test/pbt.js",
		"./storybook": "./src/storybook/index.js",
		"./element": "./src/storybook/element.js",
		"./package.json": "./package.json"
	},
	"files": [
		"src/",
		"deps/",
		"dist/",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"test": "node --test test/*/*.test.js",
		"lint": "biome check .",
		"fmt": "biome check --write .",
		"dist": "node scripts/dist.js",
		"smoke": "node scripts/smoke.js",
		"site": "node scripts/site.js",
		"prepublishOnly": "npm run lint && npm test && npm run dist && npm run smoke"
	},
	"peerDependencies": {
		"fast-check": "^4"
	},
	"peerDependenciesMeta": {
		"fast-check": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"esbuild": "^0.28.2",
		"fast-check": "^4.10.2",
		"jsdom": "^30.1.3",
		"margaui": "^0.5704.0"
	}
}
