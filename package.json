{
	"name": "tutuca",
	"version": "1.0.0-beta.3",
	"description": "A small framework for web apps in the browser, with typed state, tests, a storybook and pluggable sync",
	"type": "module",
	"license": "MIT",
	"author": "Mariano Guerra",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/marianoguerra/tutuca.git"
	},
	"homepage": "https://marianoguerra.github.io/tutuca/",
	"engines": {
		"node": ">=20"
	},
	"sideEffects": false,
	"exports": {
		".": "./src/tutuca.js",
		"./vdom": "./src/vdom/index.js",
		"./tui": "./src/tui/index.js",
		"./tui/target": "./src/tui/target.js",
		"./tui/element": "./src/tui/element.js",
		"./jsast": "./src/jsast/index.js",
		"./jsast/target": "./src/jsast/target.js",
		"./llm": "./src/llm/index.js",
		"./llm/target": "./src/llm/target.js",
		"./mdast": "./src/mdast/index.js",
		"./mdast/target": "./src/mdast/target.js",
		"./tree": "./src/tree/index.js",
		"./meta": "./src/meta/index.js",
		"./dev": "./src/tutuca.dev.js",
		"./lint": "./src/lint/index.js",
		"./classes": "./src/css/classes.js",
		"./testing": "./src/testing/driver.js",
		"./pbt": "./src/testing/pbt.js",
		"./storybook": "./src/storybook/index.js",
		"./element": "./src/embed/element.js",
		"./playground": "./src/playground/index.js",
		"./history": "./src/history/index.js",
		"./history/bar": "./src/history/bar.js",
		"./sync": "./src/sync/index.js",
		"./sync/remote": "./src/sync/remote.js",
		"./automerge": "./src/sync/automerge.js",
		"./package.json": "./package.json"
	},
	"files": [
		"src/",
		"deps/",
		"dist/",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"scripts": {
		"test": "node --test test/*/*.test.js",
		"prelint": "node scripts/vendor.js --if-missing codemirror",
		"lint": "biome check .",
		"fmt": "biome check --write .",
		"dist": "node scripts/dist.js",
		"smoke": "node scripts/smoke.js",
		"verify": "npm run lint && npm test && npm run dist && npm run smoke",
		"prepublishOnly": "npm run verify"
	},
	"peerDependencies": {
		"@automerge/automerge": "^3",
		"fast-check": "^4"
	},
	"peerDependenciesMeta": {
		"fast-check": {
			"optional": true
		},
		"@automerge/automerge": {
			"optional": true
		}
	},
	"devDependencies": {
		"@automerge/automerge": "^3.5.0",
		"@automerge/automerge-repo": "^2.6.0-alpha.3",
		"@automerge/automerge-repo-network-broadcastchannel": "^2.6.0-alpha.3",
		"@automerge/automerge-repo-network-websocket": "^2.6.0-alpha.3",
		"@automerge/automerge-repo-storage-indexeddb": "^2.6.0-alpha.3",
		"@biomejs/biome": "^2.5.15",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/theme-one-dark": "^6.1.3",
		"acorn": "^8.19.0",
		"acorn-walk": "^8.3.5",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"astring": "^1.9.0",
		"codemirror": "^6.0.2",
		"echarts": "^6.1.0",
		"esbuild": "^0.28.2",
		"fast-check": "^4.10.2",
		"immer": "11.1.21",
		"jq-wasm": "^3.0.0-jq-1.8.2",
		"jsdom": "^30.1.3",
		"jsonpath-plus": "^11.2.2",
		"margaui": "^0.5750.1",
		"mdast-util-gfm-strikethrough": "^2.0.1",
		"mdast-util-gfm-table": "^2.0.1",
		"mdast-util-gfm-task-list-item": "^2.0.1",
		"mdast-util-to-markdown": "^2.2.3",
		"picomatch": "^4.0.7",
		"vega": "^6.4.0",
		"vega-embed": "^7.3.0",
		"vega-lite": "^6.5.0"
	}
}
