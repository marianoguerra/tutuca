{
	"name": "tutuca",
	"version": "1.0.0-alpha.0",
	"description": "A small framework for web apps in the browser, with typed state, tests, a storybook and pluggable sync",
	"type": "module",
	"license": "MIT",
	"author": "Mariano Guerra",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/marianoguerra/tutuca.git"
	},
	"homepage": "https://marianoguerra.github.io/tutuca/",
	"engines": {
		"node": ">=20"
	},
	"sideEffects": false,
	"exports": {
		".": "./src/tutuca.js",
		"./vdom": "./src/vdom.js",
		"./dev": "./src/dev/formatters.js",
		"./lint": "./src/lint/index.js",
		"./classes": "./src/css/classes.js",
		"./pbt": "./src/test/pbt.js",
		"./storybook": "./src/storybook/index.js",
		"./element": "./src/embed/element.js",
		"./playground": "./src/playground/index.js",
		"./sync": "./src/sync/index.js",
		"./sync/remote": "./src/sync/remote.js",
		"./automerge": "./src/sync/automerge.js",
		"./package.json": "./package.json"
	},
	"files": [
		"src/",
		"deps/",
		"dist/",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"test": "node --test test/*/*.test.js",
		"lint": "biome check .",
		"fmt": "biome check --write .",
		"dist": "node scripts/dist.js",
		"vendor-immer": "node scripts/vendor-immer.js",
		"vendor-codemirror": "node scripts/vendor-codemirror.js",
		"vendor-automerge": "node scripts/vendor-automerge.js",
		"smoke": "node scripts/smoke.js",
		"site": "node scripts/site.js",
		"prepublishOnly": "npm run lint && npm test && npm run dist && npm run smoke"
	},
	"peerDependencies": {
		"@automerge/automerge": "^3",
		"fast-check": "^4"
	},
	"peerDependenciesMeta": {
		"fast-check": {
			"optional": true
		},
		"@automerge/automerge": {
			"optional": true
		}
	},
	"devDependencies": {
		"@automerge/automerge": "^3.5.0",
		"@automerge/automerge-repo": "^2.6.0-alpha.3",
		"@automerge/automerge-repo-network-broadcastchannel": "^2.6.0-alpha.3",
		"@automerge/automerge-repo-storage-indexeddb": "^2.6.0-alpha.3",
		"@biomejs/biome": "^2.5.15",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/theme-one-dark": "^6.1.3",
		"codemirror": "^6.0.2",
		"esbuild": "^0.28.2",
		"fast-check": "^4.10.2",
		"immer": "11.1.21",
		"jsdom": "^30.1.3",
		"margaui": "^0.5750.1"
	}
}
